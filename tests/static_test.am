// Unit tests for Static (v0.13.0).
//
// Verifies:
//   - prefix normalization (leading/trailing slash handling)
//   - Matches() boundary check ("/assets" matches "/assets/foo"
//     but NOT "/assets-other")
//   - Serve() returns null for non-matching paths
//   - 405 Method Not Allowed for POST / PUT / DELETE
//   - 403 Forbidden when path resolves to a directory
//   - 403 Forbidden on path traversal attempts (../)
//   - 404 Not Found for missing files
//   - 200 OK with Content-Type / ETag / .File(path) for a hit
//   - 304 Not Modified when If-None-Match matches
//   - MIME table covers common extensions + falls back to
//     application/octet-stream
//   - FromMap composes prefix / dir / cache_max_age

namespace Tests

import Amalgame.Collections
import Amalgame.String
import Amalgame.IO
import Amalgame.Net.Http
import Amalgame.Web

public class Program {

    public static void Main(string[] args) {
        Console.WriteLine("amalgame-web — Static tests")

        // ── 0. Set up fixture files ──────────────────────────────
        // Use a deterministic temp directory and write a fixture
        // file we can stat predictably.
        let fixDir: string = "/tmp/amalgame_static_test"
        File_Delete(fixDir + "/hello.txt")  // best-effort cleanup
        File_Delete(fixDir + "/empty.bin")
        File_Delete(fixDir + "/nested/inner.txt")
        // mkdir -p via the runtime helper. The intermediate write
        // creates the path's directories — we use File_WriteAll
        // which assumes dir exists, so the OS-level mkdir comes
        // from Path_Combine usage in tooling. Cheat: call mkdir(3)
        // via @c.
        @c {
            mkdir("/tmp/amalgame_static_test", 0755);
            mkdir("/tmp/amalgame_static_test/nested", 0755);
        }
        File_WriteAll(fixDir + "/hello.txt", "Hello static world!")
        File_WriteAll(fixDir + "/empty.bin", "")
        File_WriteAll(fixDir + "/nested/inner.txt", "nested")

        // ── 1. NormalizePrefix shape ─────────────────────────────
        let s1 = Static.New("/assets", fixDir)
        if (s1.Prefix == "/assets") {
            Console.WriteLine("[PASS] prefix kept verbatim")
        } else {
            Console.WriteLine("[FAIL] prefix got: " + s1.Prefix)
        }
        let s2 = Static.New("assets/", fixDir)
        if (s2.Prefix == "/assets") {
            Console.WriteLine("[PASS] prefix adds leading slash + strips trailing")
        } else {
            Console.WriteLine("[FAIL] normalize got: " + s2.Prefix)
        }
        let s3 = Static.New("", fixDir)
        if (s3.Prefix == "/") {
            Console.WriteLine("[PASS] empty prefix → \"/\"")
        } else {
            Console.WriteLine("[FAIL] empty prefix got: " + s3.Prefix)
        }

        // ── 2. Matches() boundary check ──────────────────────────
        let m = Static.New("/assets", fixDir)
        if (m.Matches("/assets") && m.Matches("/assets/foo")
            && m.Matches("/assets/nested/inner.txt")) {
            Console.WriteLine("[PASS] Matches accepts prefix + subpaths")
        } else {
            Console.WriteLine("[FAIL] Matches rejected a valid path")
        }
        if (!m.Matches("/assets-other") && !m.Matches("/other") && !m.Matches("")) {
            Console.WriteLine("[PASS] Matches rejects sibling prefixes")
        } else {
            Console.WriteLine("[FAIL] Matches accepted a sibling prefix")
        }

        // ── 3. Serve(null-match) returns null ────────────────────
        let st = Static.New("/assets", fixDir)
        let reqOther = new HttpRequest()
        reqOther.Method = "GET"
        reqOther.Path = "/api/users"
        let rOther = st.Serve(reqOther)
        if (rOther == null) {
            Console.WriteLine("[PASS] Serve returns null for non-matching path")
        } else {
            Console.WriteLine("[FAIL] non-matching returned non-null")
        }

        // ── 4. Method gate (405 for POST) ────────────────────────
        let reqPost = new HttpRequest()
        reqPost.Method = "POST"
        reqPost.Path = "/assets/hello.txt"
        let rPost = st.Serve(reqPost)
        if (rPost != null && rPost.StatusCode == 405) {
            Console.WriteLine("[PASS] POST → 405 Method Not Allowed")
        } else {
            Console.WriteLine("[FAIL] POST got: " + String_FromInt(rPost.StatusCode))
        }

        // ── 5. Missing file → null (fall through to router) ──────
        // v0.13.1: Static is additive — defers to router when it
        // can't positively serve a file. Pre-v0.13.1 returned 404.
        let reqMissing = new HttpRequest()
        reqMissing.Method = "GET"
        reqMissing.Path = "/assets/does-not-exist.png"
        let rMissing = st.Serve(reqMissing)
        if (rMissing == null) {
            Console.WriteLine("[PASS] missing file → null (fall through)")
        } else {
            Console.WriteLine("[FAIL] missing got: " + String_FromInt(rMissing.StatusCode))
        }

        // ── 6. Exact-prefix → null (defer to router) ─────────────
        // v0.13.1: pre-v0.13.1 returned 403 to block dir listing,
        // but that ate the router's index route on /-mounted Static.
        // Now returns null so the user's `app/index.am`-style
        // handler runs.
        let reqDir = new HttpRequest()
        reqDir.Method = "GET"
        reqDir.Path = "/assets"
        let rDir = st.Serve(reqDir)
        if (rDir == null) {
            Console.WriteLine("[PASS] exact-prefix → null (defer to router)")
        } else {
            Console.WriteLine("[FAIL] exact-prefix got: " + String_FromInt(rDir.StatusCode))
        }

        // ── 7. Subdirectory → null (defer to router) ─────────────
        // v0.13.1: subdirs no longer 403 — they fall through, same
        // rationale as missing files.
        let reqSubdir = new HttpRequest()
        reqSubdir.Method = "GET"
        reqSubdir.Path = "/assets/nested"
        let rSubdir = st.Serve(reqSubdir)
        if (rSubdir == null) {
            Console.WriteLine("[PASS] subdirectory → null (defer to router)")
        } else {
            Console.WriteLine("[FAIL] subdir got: " + String_FromInt(rSubdir.StatusCode))
        }

        // ── 8. Path traversal blocked ────────────────────────────
        let reqEsc = new HttpRequest()
        reqEsc.Method = "GET"
        reqEsc.Path = "/assets/../../etc/passwd"
        let rEsc = st.Serve(reqEsc)
        // After Path_Normalize, /tmp/amalgame_static_test/../../etc/passwd
        // collapses to /etc/passwd which is NOT under the root prefix,
        // so containment check fires → 403.
        if (rEsc != null && rEsc.StatusCode == 403) {
            Console.WriteLine("[PASS] ../ traversal → 403")
        } else {
            Console.WriteLine("[FAIL] traversal got: " + String_FromInt(rEsc.StatusCode))
        }

        // ── 9. 200 OK with Content-Type + ETag + FilePath ────────
        let reqHit = new HttpRequest()
        reqHit.Method = "GET"
        reqHit.Path = "/assets/hello.txt"
        let rHit = st.Serve(reqHit)
        if (rHit != null && rHit.StatusCode == 200
            && rHit.Headers.Get("Content-Type") == "text/plain; charset=utf-8"
            && rHit.Headers.Has("ETag")
            && rHit.FilePath != "") {
            Console.WriteLine("[PASS] 200 with Content-Type + ETag + FilePath set")
        } else {
            Console.WriteLine("[FAIL] hit got: status=" + String_FromInt(rHit.StatusCode)
                + " ct=" + rHit.Headers.Get("Content-Type"))
        }

        // ── 10. If-None-Match → 304 ──────────────────────────────
        let etagFirst: string = rHit.Headers.Get("ETag")
        let reqCond = new HttpRequest()
        reqCond.Method = "GET"
        reqCond.Path = "/assets/hello.txt"
        reqCond.Headers.Set("if-none-match", etagFirst)
        let rCond = st.Serve(reqCond)
        if (rCond != null && rCond.StatusCode == 304
            && rCond.Headers.Get("ETag") == etagFirst
            && rCond.FilePath == "") {
            Console.WriteLine("[PASS] If-None-Match → 304 with same ETag, no body")
        } else {
            Console.WriteLine("[FAIL] 304 got: status=" + String_FromInt(rCond.StatusCode))
        }

        // ── 11. ETag is stable across calls (size+mtime) ─────────
        let rHit2 = st.Serve(reqHit)
        if (rHit2.Headers.Get("ETag") == etagFirst) {
            Console.WriteLine("[PASS] ETag stable across calls")
        } else {
            Console.WriteLine("[FAIL] ETag drifted: " + etagFirst + " vs " + rHit2.Headers.Get("ETag"))
        }

        // ── 11b. Last-Modified + Accept-Ranges on 200 (v0.27.0) ──
        if (rHit.Headers.Has("Last-Modified") && rHit.Headers.Get("Accept-Ranges") == "bytes") {
            Console.WriteLine("[PASS] 200 carries Last-Modified + Accept-Ranges")
        } else {
            Console.WriteLine("[FAIL] missing Last-Modified/Accept-Ranges")
        }

        // ── 11c. If-Modified-Since (future) → 304 ────────────────
        let reqIms = new HttpRequest()
        reqIms.Method = "GET"
        reqIms.Path = "/assets/hello.txt"
        reqIms.Headers.Set("if-modified-since", "Thu, 01 Jan 2099 00:00:00 GMT")
        let rIms = st.Serve(reqIms)
        if (rIms != null && rIms.StatusCode == 304) {
            Console.WriteLine("[PASS] If-Modified-Since future → 304")
        } else {
            Console.WriteLine("[FAIL] If-Modified-Since 304 got: " + String_FromInt(rIms.StatusCode))
        }

        // ── 11d. Range bytes=0-4 → 206 (hello.txt is 19 bytes) ───
        let reqR1 = new HttpRequest()
        reqR1.Method = "GET"
        reqR1.Path = "/assets/hello.txt"
        reqR1.Headers.Set("range", "bytes=0-4")
        let rR1 = st.Serve(reqR1)
        if (rR1 != null && rR1.StatusCode == 206
            && rR1.HasRange && rR1.RangeOff == 0 && rR1.RangeLen == 5
            && rR1.Headers.Get("Content-Range") == "bytes 0-4/19") {
            Console.WriteLine("[PASS] Range 0-4 → 206 bytes 0-4/19")
        } else {
            Console.WriteLine("[FAIL] Range 0-4 got: status=" + String_FromInt(rR1.StatusCode)
                + " cr=" + rR1.Headers.Get("Content-Range"))
        }

        // ── 11e. Suffix range bytes=-6 → last 6 bytes ────────────
        let reqR2 = new HttpRequest()
        reqR2.Method = "GET"
        reqR2.Path = "/assets/hello.txt"
        reqR2.Headers.Set("range", "bytes=-6")
        let rR2 = st.Serve(reqR2)
        if (rR2 != null && rR2.StatusCode == 206
            && rR2.RangeOff == 13 && rR2.RangeLen == 6
            && rR2.Headers.Get("Content-Range") == "bytes 13-18/19") {
            Console.WriteLine("[PASS] Range -6 → 206 bytes 13-18/19")
        } else {
            Console.WriteLine("[FAIL] Range -6 got: status=" + String_FromInt(rR2.StatusCode)
                + " cr=" + rR2.Headers.Get("Content-Range"))
        }

        // ── 11f. Unsatisfiable range → 416 ───────────────────────
        let reqR3 = new HttpRequest()
        reqR3.Method = "GET"
        reqR3.Path = "/assets/hello.txt"
        reqR3.Headers.Set("range", "bytes=100-200")
        let rR3 = st.Serve(reqR3)
        if (rR3 != null && rR3.StatusCode == 416
            && rR3.Headers.Get("Content-Range") == "bytes */19") {
            Console.WriteLine("[PASS] unsatisfiable range → 416")
        } else {
            Console.WriteLine("[FAIL] 416 got: status=" + String_FromInt(rR3.StatusCode))
        }

        // ── 11g. Pre-compressed .gz selection ────────────────────
        File_WriteAll(fixDir + "/style.css", "body{color:red}")
        File_WriteAll(fixDir + "/style.css.gz", "FAKEGZIPBYTES")
        let reqGz = new HttpRequest()
        reqGz.Method = "GET"
        reqGz.Path = "/assets/style.css"
        reqGz.Headers.Set("accept-encoding", "gzip, deflate")
        let rGz = st.Serve(reqGz)
        if (rGz != null && rGz.StatusCode == 200
            && rGz.Headers.Get("Content-Encoding") == "gzip"
            && rGz.Headers.Get("Content-Type") == "text/css; charset=utf-8"
            && String_EndsWith(rGz.FilePath, "style.css.gz")) {
            Console.WriteLine("[PASS] .gz variant served with Content-Encoding gzip")
        } else {
            Console.WriteLine("[FAIL] .gz got: status=" + String_FromInt(rGz.StatusCode)
                + " ce=" + rGz.Headers.Get("Content-Encoding") + " path=" + rGz.FilePath)
        }
        // Without Accept-Encoding gzip → identity file served.
        let reqNoGz = new HttpRequest()
        reqNoGz.Method = "GET"
        reqNoGz.Path = "/assets/style.css"
        let rNoGz = st.Serve(reqNoGz)
        if (rNoGz != null && rNoGz.StatusCode == 200
            && !rNoGz.Headers.Has("Content-Encoding")
            && String_EndsWith(rNoGz.FilePath, "style.css")) {
            Console.WriteLine("[PASS] no Accept-Encoding → identity file")
        } else {
            Console.WriteLine("[FAIL] identity got ce=" + rNoGz.Headers.Get("Content-Encoding"))
        }

        // ── 12. Nested file resolves correctly ───────────────────
        let reqNested = new HttpRequest()
        reqNested.Method = "GET"
        reqNested.Path = "/assets/nested/inner.txt"
        let rNested = st.Serve(reqNested)
        if (rNested != null && rNested.StatusCode == 200
            && rNested.Headers.Get("Content-Type") == "text/plain; charset=utf-8") {
            Console.WriteLine("[PASS] nested path resolves")
        } else {
            Console.WriteLine("[FAIL] nested got: " + String_FromInt(rNested.StatusCode))
        }

        // ── 13. MIME table — sample of common types ──────────────
        if (Static.MimeByExtension(".html") == "text/html; charset=utf-8"
            && Static.MimeByExtension(".PNG") == "image/png"
            && Static.MimeByExtension(".css") == "text/css; charset=utf-8"
            && Static.MimeByExtension(".js")  == "application/javascript; charset=utf-8"
            && Static.MimeByExtension(".woff2") == "font/woff2") {
            Console.WriteLine("[PASS] MIME table covers HTML/PNG/CSS/JS/WOFF2 (case-insensitive)")
        } else {
            Console.WriteLine("[FAIL] MIME lookup mismatch")
        }
        if (Static.MimeByExtension(".whatever") == "application/octet-stream"
            && Static.MimeByExtension("") == "application/octet-stream") {
            Console.WriteLine("[PASS] MIME fallback for unknown/empty")
        } else {
            Console.WriteLine("[FAIL] MIME fallback mismatch")
        }

        // ── 14. Cache-Control opt-in ─────────────────────────────
        let withCache = Static.New("/assets", fixDir).WithCacheMaxAge(3600)
        let rCached = withCache.Serve(reqHit)
        if (rCached.Headers.Get("Cache-Control") == "public, max-age=3600") {
            Console.WriteLine("[PASS] Cache-Control emitted when configured")
        } else {
            Console.WriteLine("[FAIL] cache header got: " + rCached.Headers.Get("Cache-Control"))
        }

        // ── 15. FromMap composes ─────────────────────────────────
        let cfg = new Map<string, string>()
        cfg.Set("prefix", "/files")
        cfg.Set("dir", fixDir)
        cfg.Set("cache_max_age", "60")
        let fm = Static.FromMap(cfg)
        if (fm.Prefix == "/files" && fm.Root == fixDir && fm.CacheMaxAge == 60) {
            Console.WriteLine("[PASS] FromMap composes")
        } else {
            Console.WriteLine("[FAIL] FromMap got: prefix=" + fm.Prefix
                + " root=" + fm.Root
                + " maxage=" + String_FromInt(fm.CacheMaxAge))
        }

        // ── 16. Security hardening (v0.29.0) ─────────────────────
        // Fixtures: dotfiles, a .well-known file, source/lock files, and
        // a symlink escaping the served root.
        @c {
            mkdir("/tmp/amalgame_static_test/.git", 0755);
            mkdir("/tmp/amalgame_static_test/.well-known", 0755);
        }
        File_WriteAll(fixDir + "/.env", "SECRET=hunter2")
        File_WriteAll(fixDir + "/.git/config", "[core]")
        File_WriteAll(fixDir + "/.well-known/security.txt", "Contact: mailto:x@y.z")
        File_WriteAll(fixDir + "/app.am", "namespace X")
        File_WriteAll(fixDir + "/amalgame.lock", "[[package]]")
        File_WriteAll("/tmp/amalgame_static_OUTSIDE.txt", "top secret")
        @c {
            unlink("/tmp/amalgame_static_test/leak");
            symlink("/tmp/amalgame_static_OUTSIDE.txt", "/tmp/amalgame_static_test/leak");
        }

        // 16a. Dotfile (.env) → 403
        let reqEnv = new HttpRequest()
        reqEnv.Method = "GET"; reqEnv.Path = "/assets/.env"
        let rEnv = st.Serve(reqEnv)
        if (rEnv != null && rEnv.StatusCode == 403) {
            Console.WriteLine("[PASS] dotfile .env → 403")
        } else {
            Console.WriteLine("[FAIL] .env got: " + String_FromInt(rEnv.StatusCode))
        }

        // 16b. Dotdir (.git/config) → 403
        let reqGit = new HttpRequest()
        reqGit.Method = "GET"; reqGit.Path = "/assets/.git/config"
        let rGit = st.Serve(reqGit)
        if (rGit != null && rGit.StatusCode == 403) {
            Console.WriteLine("[PASS] .git/config → 403")
        } else {
            Console.WriteLine("[FAIL] .git/config got: " + String_FromInt(rGit.StatusCode))
        }

        // 16c. .well-known IS allowed (ACME / security.txt) → 200
        let reqWk = new HttpRequest()
        reqWk.Method = "GET"; reqWk.Path = "/assets/.well-known/security.txt"
        let rWk = st.Serve(reqWk)
        if (rWk != null && rWk.StatusCode == 200) {
            Console.WriteLine("[PASS] .well-known/security.txt → 200 (not blocked)")
        } else {
            Console.WriteLine("[FAIL] .well-known got: " + String_FromInt(rWk.StatusCode))
        }

        // 16d. Source file (.am) → 403
        let reqAm = new HttpRequest()
        reqAm.Method = "GET"; reqAm.Path = "/assets/app.am"
        let rAm = st.Serve(reqAm)
        if (rAm != null && rAm.StatusCode == 403) {
            Console.WriteLine("[PASS] source .am → 403")
        } else {
            Console.WriteLine("[FAIL] .am got: " + String_FromInt(rAm.StatusCode))
        }

        // 16e. Lockfile (.lock) → 403
        let reqLock = new HttpRequest()
        reqLock.Method = "GET"; reqLock.Path = "/assets/amalgame.lock"
        let rLock = st.Serve(reqLock)
        if (rLock != null && rLock.StatusCode == 403) {
            Console.WriteLine("[PASS] .lock → 403")
        } else {
            Console.WriteLine("[FAIL] .lock got: " + String_FromInt(rLock.StatusCode))
        }

        // 16f. Symlink escaping the root → 403 (realpath containment)
        let reqLeak = new HttpRequest()
        reqLeak.Method = "GET"; reqLeak.Path = "/assets/leak"
        let rLeak = st.Serve(reqLeak)
        if (rLeak != null && rLeak.StatusCode == 403) {
            Console.WriteLine("[PASS] symlink escape → 403")
        } else {
            var leakStatus: string = "null"
            if (rLeak != null) { leakStatus = String_FromInt(rLeak.StatusCode) }
            Console.WriteLine("[FAIL] symlink escape got: " + leakStatus)
        }

        // Cleanup
        File_Delete(fixDir + "/hello.txt")
        File_Delete(fixDir + "/empty.bin")
        File_Delete(fixDir + "/nested/inner.txt")
        File_Delete(fixDir + "/.env")
        File_Delete(fixDir + "/.git/config")
        File_Delete(fixDir + "/.well-known/security.txt")
        File_Delete(fixDir + "/app.am")
        File_Delete(fixDir + "/amalgame.lock")
        File_Delete("/tmp/amalgame_static_OUTSIDE.txt")
        @c { unlink("/tmp/amalgame_static_test/leak"); }

        Console.WriteLine("amalgame-web — Static tests done")
    }
}

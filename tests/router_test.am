// Unit tests for the Mosaic Router. Verifies path matching:
// static routes, :param capture, *splat capture, method filter,
// 404 cases, registration order semantics.

namespace Tests

import Amalgame.Collections
import Amalgame.String
import Amalgame.Web

public class Program {
    public static void Main(string[] args) {
        Console.WriteLine("amalgame-web — Router tests")

        let r = new Router()
        r.Get("/",                "home")
            .Get("/about",        "about")
            .Get("/users",        "users_index")
            .Get("/users/:id",    "user_show")
            .Post("/users",       "user_create")
            .Delete("/users/:id", "user_delete")
            .Get("/users/:id/posts/:postId", "post_show")
            .Get("/files/*path",  "file_serve")

        // ── Static matches ────────────────────────────────────────
        let m1 = r.Match("GET", "/")
        if (m1 != null && m1.HandlerName == "home") {
            Console.WriteLine("[PASS] static /")
        } else {
            Console.WriteLine("[FAIL] static /")
        }

        let m2 = r.Match("GET", "/about")
        if (m2 != null && m2.HandlerName == "about") {
            Console.WriteLine("[PASS] static /about")
        } else {
            Console.WriteLine("[FAIL] static /about")
        }

        let m3 = r.Match("GET", "/users")
        if (m3 != null && m3.HandlerName == "users_index") {
            Console.WriteLine("[PASS] static /users")
        } else {
            Console.WriteLine("[FAIL] static /users")
        }

        // ── Method filter ─────────────────────────────────────────
        let m4 = r.Match("POST", "/users")
        if (m4 != null && m4.HandlerName == "user_create") {
            Console.WriteLine("[PASS] POST /users")
        } else {
            Console.WriteLine("[FAIL] POST /users")
        }

        // ── :param capture ────────────────────────────────────────
        let m5 = r.Match("GET", "/users/42")
        if (m5 != null && m5.HandlerName == "user_show" && m5.Params.Get("id") == "42") {
            Console.WriteLine("[PASS] :param /users/42")
        } else {
            Console.WriteLine("[FAIL] :param /users/42")
        }

        let m6 = r.Match("DELETE", "/users/alice")
        if (m6 != null && m6.HandlerName == "user_delete" && m6.Params.Get("id") == "alice") {
            Console.WriteLine("[PASS] :param DELETE /users/alice")
        } else {
            Console.WriteLine("[FAIL] :param DELETE /users/alice")
        }

        // ── Two :params ───────────────────────────────────────────
        let m7 = r.Match("GET", "/users/42/posts/777")
        if (m7 != null && m7.HandlerName == "post_show"
            && m7.Params.Get("id") == "42"
            && m7.Params.Get("postId") == "777") {
            Console.WriteLine("[PASS] two :params")
        } else {
            Console.WriteLine("[FAIL] two :params")
        }

        // ── *splat ────────────────────────────────────────────────
        let m8 = r.Match("GET", "/files/css/main.css")
        if (m8 != null && m8.HandlerName == "file_serve"
            && m8.Params.Get("path") == "css/main.css") {
            Console.WriteLine("[PASS] *splat capture")
        } else {
            Console.WriteLine("[FAIL] *splat got '" + m8.Params.Get("path") + "'")
        }

        let m9 = r.Match("GET", "/files/x")
        if (m9 != null && m9.Params.Get("path") == "x") {
            Console.WriteLine("[PASS] *splat single segment")
        } else {
            Console.WriteLine("[FAIL] *splat single segment")
        }

        // ── 404 cases ─────────────────────────────────────────────
        let m10 = r.Match("GET", "/missing")
        if (m10 == null) {
            Console.WriteLine("[PASS] no match → null")
        } else {
            Console.WriteLine("[FAIL] should have been null")
        }

        let m11 = r.Match("PUT", "/users")          // wrong method
        if (m11 == null) {
            Console.WriteLine("[PASS] wrong method → null")
        } else {
            Console.WriteLine("[FAIL] wrong method should have been null")
        }

        let m12 = r.Match("GET", "/users/42/extra") // too many segments
        if (m12 == null) {
            Console.WriteLine("[PASS] over-long path → null")
        } else {
            Console.WriteLine("[FAIL] over-long path should have been null")
        }

        // ── Route.SplitPath ───────────────────────────────────────
        let segs = Route.SplitPath("/users/42/posts")
        if (segs.Count() == 3 && segs.Get(0) == "users" && segs.Get(1) == "42" && segs.Get(2) == "posts") {
            Console.WriteLine("[PASS] SplitPath /users/42/posts")
        } else {
            Console.WriteLine("[FAIL] SplitPath")
        }

        let empty = Route.SplitPath("/")
        if (empty.Count() == 0) {
            Console.WriteLine("[PASS] SplitPath / → empty")
        } else {
            Console.WriteLine("[FAIL] SplitPath / count=" + String_FromInt(empty.Count()))
        }

        // ── Session basics ────────────────────────────────────────
        let store = new MemorySessionStore()
        let s1 = store.Create("session_abc")
        s1.Set("user_id", "42")
        s1.Set("theme", "dark")

        let s2 = store.Find("session_abc")
        if (s2 != null && s2.Get("user_id") == "42" && s2.Get("theme") == "dark") {
            Console.WriteLine("[PASS] session round-trip")
        } else {
            Console.WriteLine("[FAIL] session round-trip")
        }

        store.Destroy("session_abc")
        let s3 = store.Find("session_abc")
        if (s3 == null) {
            Console.WriteLine("[PASS] session destroy")
        } else {
            Console.WriteLine("[FAIL] session destroy")
        }

        // ── WebContext ────────────────────────────────────────────
        let ctx = new WebContext()
        ctx.Params.Set("id", "42")
        ctx.State.Set("db_url", "postgres://localhost/app")
        if (ctx.Param("id") == "42" && ctx.StateOf("db_url") == "postgres://localhost/app") {
            Console.WriteLine("[PASS] WebContext")
        } else {
            Console.WriteLine("[FAIL] WebContext")
        }
        if (ctx.Param("missing") == "" && ctx.StateOf("missing") == "") {
            Console.WriteLine("[PASS] WebContext missing key returns empty")
        } else {
            Console.WriteLine("[FAIL] WebContext missing key")
        }

        Console.WriteLine("done")
    }
}

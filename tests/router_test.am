// Unit tests for the Mosaic Router with first-class function handlers.
// Verifies path matching + closure dispatch:
//   - static routes
//   - :param capture
//   - *splat capture
//   - method filter
//   - 404 cases
//   - actual handler invocation via match.Route.Handler(ctx)
//
// Requires amc v0.8.35+ for the typed-Closure annotation on
// Router.Handler (Closure<WebContext, HttpResponse>).

namespace Tests

import Amalgame.Collections
import Amalgame.String
import Amalgame.Net.Http
import Amalgame.Web

public class Program {
    public static void Main(string[] args) {
        Console.WriteLine("amalgame-web — Router tests (FCF)")

        // Handlers return HttpResponse (typed Closure since v0.3.0
        // — the Handler field is `Closure<WebContext, HttpResponse>`).
        // We assert against the response's StatusCode to keep checks
        // int-comparable.
        let r = new Router()
        r.Get("/",                ctx => HttpResponse.New().Status(1))
            .Get("/about",        ctx => HttpResponse.New().Status(2))
            .Get("/users",        ctx => HttpResponse.New().Status(3))
            .Get("/users/:id",    ctx => HttpResponse.New().Status(100))
            .Post("/users",       ctx => HttpResponse.New().Status(200))
            .Delete("/users/:id", ctx => HttpResponse.New().Status(300))
            .Get("/users/:id/posts/:postId", ctx => HttpResponse.New().Status(400))
            .Get("/files/*path",  ctx => HttpResponse.New().Status(500))

        // ── Static matches ────────────────────────────────────────
        let m1 = r.Match("GET", "/")
        if (m1 != null && m1.Route.Path == "/") {
            Console.WriteLine("[PASS] static /")
        } else {
            Console.WriteLine("[FAIL] static /")
        }

        // ── Method filter ─────────────────────────────────────────
        let m4 = r.Match("POST", "/users")
        if (m4 != null && m4.Route.Method == "POST") {
            Console.WriteLine("[PASS] POST /users")
        } else {
            Console.WriteLine("[FAIL] POST /users")
        }

        // ── :param capture ────────────────────────────────────────
        let m5 = r.Match("GET", "/users/42")
        if (m5 != null && m5.Params.Get("id") == "42") {
            Console.WriteLine("[PASS] :param /users/42")
        } else {
            Console.WriteLine("[FAIL] :param /users/42")
        }

        // ── Two :params ───────────────────────────────────────────
        let m7 = r.Match("GET", "/users/42/posts/777")
        if (m7 != null
            && m7.Params.Get("id") == "42"
            && m7.Params.Get("postId") == "777") {
            Console.WriteLine("[PASS] two :params")
        } else {
            Console.WriteLine("[FAIL] two :params")
        }

        // ── *splat ────────────────────────────────────────────────
        let m8 = r.Match("GET", "/files/css/main.css")
        if (m8 != null && m8.Params.Get("path") == "css/main.css") {
            Console.WriteLine("[PASS] *splat capture")
        } else {
            Console.WriteLine("[FAIL] *splat")
        }

        // ── 404 / wrong method ────────────────────────────────────
        if (r.Match("GET", "/missing") == null) {
            Console.WriteLine("[PASS] no match → null")
        } else {
            Console.WriteLine("[FAIL] should be null")
        }

        if (r.Match("PUT", "/users") == null) {
            Console.WriteLine("[PASS] wrong method → null")
        } else {
            Console.WriteLine("[FAIL] wrong method should be null")
        }

        // ── Handler invocation (the new FCF capability!) ──────────
        // Nested member access `m.Route.Handler(ctx)` works directly
        // since amc v0.8.33 (ResolveReceiverClass walks MEMBER chains).
        let ctx = new WebContext()
        let resp1: HttpResponse = m1.Route.Handler(ctx)
        let res1: int = resp1.StatusCode
        if (res1 == 1) {
            Console.WriteLine("[PASS] handler invoked: / → 1")
        } else {
            Console.WriteLine("[FAIL] handler invoked / got " + String_FromInt(res1))
        }

        ctx.Params = m5.Params
        let resp5: HttpResponse = m5.Route.Handler(ctx)
        let res5: int = resp5.StatusCode
        if (res5 == 100) {
            Console.WriteLine("[PASS] handler invoked: /users/:id → 100")
        } else {
            Console.WriteLine("[FAIL] handler invoked /users/:id got " + String_FromInt(res5))
        }

        let resp7: HttpResponse = m7.Route.Handler(ctx)
        let res7: int = resp7.StatusCode
        if (res7 == 400) {
            Console.WriteLine("[PASS] handler invoked: two :params → 400")
        } else {
            Console.WriteLine("[FAIL] handler two :params got " + String_FromInt(res7))
        }

        // ── Session basics ────────────────────────────────────────
        let store = new MemorySessionStore()
        let s1 = store.Create("session_abc")
        s1.Set("user_id", "42")
        let s2 = store.Find("session_abc")
        if (s2 != null && s2.Get("user_id") == "42") {
            Console.WriteLine("[PASS] session round-trip")
        } else {
            Console.WriteLine("[FAIL] session round-trip")
        }

        // ── Session cookie attrs (v0.8.1) ────────────────────────
        let store2 = new MemorySessionStore()
            .WithCookieName("custom_sess")
            .WithCookieSecure(false)
            .WithCookieSameSite("Strict")
            .WithCookiePath("/app")
            .WithCookieMaxAge(3600)
        let cookie: Cookie = store2.MakeCookie("token_xyz")
        if (cookie.Name == "custom_sess"
            && cookie.Value == "token_xyz"
            && cookie.SameSite == "Strict"
            && cookie.Path == "/app"
            && cookie.MaxAgeSec == 3600
            && !cookie.Secure
            && cookie.HttpOnly) {
            Console.WriteLine("[PASS] MakeCookie carries store attrs")
        } else {
            Console.WriteLine("[FAIL] MakeCookie shape: name=" + cookie.Name)
        }

        // ── FromMap composes the same attrs from a TOML map ──────
        let cfg: Map<string, string> = new Map<string, string>()
        cfg.Set("cookie_name", "frommap_sess")
        cfg.Set("cookie_secure", "false")
        cfg.Set("cookie_max_age", "7200")
        let store3 = MemorySessionStore.FromMap(cfg)
        if (store3.CookieName == "frommap_sess"
            && !store3.CookieSecure
            && store3.CookieMaxAge == 7200) {
            Console.WriteLine("[PASS] MemorySessionStore.FromMap composes attrs")
        } else {
            Console.WriteLine("[FAIL] FromMap shape: " + store3.CookieName)
        }

        Console.WriteLine("done")
    }
}

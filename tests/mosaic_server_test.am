// Unit tests for MosaicServer — the network-free surface: Host
// dispatch (port stripping + www→apex folding), site registration,
// and the SNI/ACME domain list. Serve / ServeHttps need sockets and
// are exercised manually / by the Sites deployment.

namespace Tests

import Amalgame.Collections
import Amalgame.String
import Amalgame.Net.Http
import Amalgame.Web

public class Program {
    public static void Main(string[] args) {
        Console.WriteLine("amalgame-web — MosaicServer tests")

        let app = WebApp.New()
        let m = MosaicServer.New()
            .AddSite(["example.com", "api.example.com"], app)

        // ── 1. Host dispatch ─────────────────────────────────────
        if (m.Pick("example.com") != null && m.Pick("api.example.com") != null) {
            Console.WriteLine("[PASS] dispatch: registered hosts resolve to their app")
        } else {
            Console.WriteLine("[FAIL] dispatch")
        }

        // ── 2. Port stripped from the Host header ────────────────
        if (m.Pick("example.com:443") != null) {
            Console.WriteLine("[PASS] Host port stripped before lookup")
        } else {
            Console.WriteLine("[FAIL] port strip")
        }

        // ── 3. Unknown host → null (server answers 404) ──────────
        if (m.Pick("nope.com") == null) {
            Console.WriteLine("[PASS] unknown host → null")
        } else {
            Console.WriteLine("[FAIL] unknown host")
        }

        // ── 4. www folds to the apex (WwwCanonical default on) ───
        if (m.Pick("www.example.com") != null) {
            Console.WriteLine("[PASS] www.<host> folds to the apex site")
        } else {
            Console.WriteLine("[FAIL] www folding")
        }

        // ── 5. Domain list skips www aliases (SNI + ACME) ────────
        if (m.Domains.Count() == 2) {
            Console.WriteLine("[PASS] domain list = 2 (apex + api, no www entry)")
        } else {
            Console.WriteLine("[FAIL] domains count: " + String_FromInt(m.Domains.Count()))
        }

        // ── 6. WwwCanonical off → www does NOT fold ──────────────
        let m2 = MosaicServer.New()
            .WithWwwCanonical(false)
            .AddSite(["x.com"], WebApp.New())
        if (m2.Pick("x.com") != null && m2.Pick("www.x.com") == null) {
            Console.WriteLine("[PASS] WwwCanonical(false): www no longer folds")
        } else {
            Console.WriteLine("[FAIL] www-canonical toggle")
        }

        // ── 7. AddStaticSite registers a site ────────────────────
        let m3 = MosaicServer.New().AddStaticSite(["static.example"], "/srv/static")
        if (m3.Pick("static.example") != null) {
            Console.WriteLine("[PASS] AddStaticSite registers a static-serving app")
        } else {
            Console.WriteLine("[FAIL] AddStaticSite")
        }

        // ── 8. AddHandler: raw handler dispatches + 404 fallback ──
        // The closure stands in for a reverse proxy (req → response).
        let m4 = MosaicServer.New()
            .AddHandler(["proxy.example", "www.proxy.example"],
                        (req: HttpRequest) => HttpResponse.New().Status(200).Text("proxied " + req.Path))
        let r1: HttpResponse = m4.Dispatch("proxy.example", Program.req("/api"))
        let r2: HttpResponse = m4.Dispatch("proxy.example:443", Program.req("/api"))
        let r3: HttpResponse = m4.Dispatch("www.proxy.example", Program.req("/api"))
        let r4: HttpResponse = m4.Dispatch("ghost.example", Program.req("/"))
        if (r1.StatusCode == 200 && r2.StatusCode == 200 && r3.StatusCode == 200 && r4.StatusCode == 404) {
            Console.WriteLine("[PASS] AddHandler: host (+port +www) → handler, unknown → 404")
        } else {
            Console.WriteLine("[FAIL] AddHandler dispatch: "
                + String_FromInt(r1.StatusCode) + "/" + String_FromInt(r2.StatusCode)
                + "/" + String_FromInt(r3.StatusCode) + "/" + String_FromInt(r4.StatusCode))
        }

        // ── 9. AddHandler host enters the SNI/ACME domain list ────
        if (m4.Domains.Count() == 1 && m4.Knows("proxy.example")) {
            Console.WriteLine("[PASS] AddHandler: apex domain registered (www skipped), Knows() true")
        } else {
            Console.WriteLine("[FAIL] AddHandler domains: " + String_FromInt(m4.Domains.Count()))
        }

        // ── 10. Handler wins over a WebApp site on the same host ──
        let m5 = MosaicServer.New()
            .AddSite(["dual.example"], WebApp.New())
            .AddHandler(["dual.example"], (req: HttpRequest) => HttpResponse.New().Status(202).Text("handler"))
        let rd: HttpResponse = m5.Dispatch("dual.example", Program.req("/"))
        if (rd.StatusCode == 202) {
            Console.WriteLine("[PASS] handler takes precedence over a WebApp site")
        } else {
            Console.WriteLine("[FAIL] handler precedence: " + String_FromInt(rd.StatusCode))
        }

        Console.WriteLine("done")
    }

    // A minimal GET request for the given path (network-free dispatch tests).
    private static HttpRequest req(string path) {
        let r: HttpRequest = new HttpRequest()
        r.Method = "GET"
        r.Path   = path
        return r
    }
}

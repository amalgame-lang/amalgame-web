// Unit tests for SignedCookieSessionStore (v0.8.3).
//
// Verifies the encode/decode roundtrip + tamper resistance + the
// cookie-attribute plumbing.

namespace Tests

import Amalgame.Collections
import Amalgame.String
import Amalgame.Net.Http
import Amalgame.Web

public class Program {
    public static void Main(string[] args) {
        Console.WriteLine("amalgame-web — SignedCookieSessionStore tests")

        // ── 1. Roundtrip ─────────────────────────────────────────
        let store = new SignedCookieSessionStore("test-secret-key")
        let s1 = new Session("ignored-since-cookie-is-self")
        s1.Set("user_id", "42")
        s1.Set("role", "admin")
        s1.Set("locale", "fr-FR")
        let cookie_value: string = store.Encode(s1)
        let s2: Session = store.Decode(cookie_value)
        if (s2 != null
            && s2.Get("user_id") == "42"
            && s2.Get("role") == "admin"
            && s2.Get("locale") == "fr-FR") {
            Console.WriteLine("[PASS] encode/decode roundtrip")
        } else {
            Console.WriteLine("[FAIL] roundtrip lost data")
        }

        // ── 2. Tampering detected ────────────────────────────────
        // Flip a char in the payload — signature should mismatch.
        let tampered: string = "user_id=99&role=admin&locale=fr-FR." +
                               String_Substring(cookie_value, String_Length(cookie_value) - 64, 64)
        let bad: Session = store.Decode(tampered)
        if (bad == null) {
            Console.WriteLine("[PASS] tampered payload rejected")
        } else {
            Console.WriteLine("[FAIL] tampered payload accepted: user_id=" + bad.Get("user_id"))
        }

        // ── 3. Wrong secret rejected ─────────────────────────────
        let other_store = new SignedCookieSessionStore("DIFFERENT-secret")
        let bad2: Session = other_store.Decode(cookie_value)
        if (bad2 == null) {
            Console.WriteLine("[PASS] wrong-secret reject")
        } else {
            Console.WriteLine("[FAIL] wrong-secret accepted")
        }

        // ── 4. Malformed cookie values ───────────────────────────
        let bad3: Session = store.Decode("")
        let bad4: Session = store.Decode("no_dot_no_sig_here")
        let bad5: Session = store.Decode(".")
        let bad6: Session = store.Decode("k=v.shortsig")
        if (bad3 == null && bad4 == null && bad5 == null && bad6 == null) {
            Console.WriteLine("[PASS] malformed cookies all rejected")
        } else {
            Console.WriteLine("[FAIL] malformed cookie shape")
        }

        // ── 5. Determinism ───────────────────────────────────────
        // Same data + same store → same encoded cookie. (Sessions
        // with the same content yield the same signature — that's a
        // design property the server can use as a session-version
        // fingerprint for invalidation if it wants.)
        let s3 = new Session("ignored")
        s3.Set("user_id", "42")
        let enc_a: string = store.Encode(s3)
        let enc_b: string = store.Encode(s3)
        if (enc_a == enc_b) {
            Console.WriteLine("[PASS] encode determinism")
        } else {
            Console.WriteLine("[FAIL] encode non-deterministic")
        }

        // ── 6. Empty session encodes/decodes ─────────────────────
        let empty_s = new Session("ignored")
        let enc_empty: string = store.Encode(empty_s)
        let dec_empty: Session = store.Decode(enc_empty)
        if (dec_empty != null && dec_empty.Data.Size() == 0) {
            Console.WriteLine("[PASS] empty session roundtrip")
        } else {
            Console.WriteLine("[FAIL] empty session lost")
        }

        // ── 7. MakeCookie carries store attrs ────────────────────
        let store2 = new SignedCookieSessionStore("k")
            .WithCookieName("scs")
            .WithCookieSecure(false)
            .WithCookieSameSite("Strict")
            .WithCookiePath("/app")
            .WithCookieMaxAge(7200)
        let s7 = new Session("ignored")
        s7.Set("x", "1")
        let c: Cookie = store2.MakeCookie(s7)
        if (c.Name == "scs"
            && c.SameSite == "Strict"
            && c.Path == "/app"
            && c.MaxAgeSec == 7200
            && !c.Secure
            && c.HttpOnly) {
            Console.WriteLine("[PASS] MakeCookie carries attrs")
        } else {
            Console.WriteLine("[FAIL] MakeCookie attrs: name=" + c.Name)
        }

        // ── 8. FromMap composes ──────────────────────────────────
        let cfg: Map<string, string> = new Map<string, string>()
        cfg.Set("secret", "from-map-key")
        cfg.Set("cookie_name", "fm_sess")
        cfg.Set("cookie_secure", "false")
        cfg.Set("cookie_samesite", "None")
        cfg.Set("cookie_max_age", "1800")
        let store3 = SignedCookieSessionStore.FromMap(cfg)
        if (store3.Secret == "from-map-key"
            && store3.CookieName == "fm_sess"
            && !store3.CookieSecure
            && store3.CookieSameSite == "None"
            && store3.CookieMaxAge == 1800) {
            Console.WriteLine("[PASS] FromMap composes attrs")
        } else {
            Console.WriteLine("[FAIL] FromMap shape: " + store3.CookieName)
        }

        // ─────────────────────────────────────────────────
        // v0.8.5 — Encrypted (AEAD AES-256-GCM) mode
        // ─────────────────────────────────────────────────

        // ── 9. Encrypted roundtrip ───────────────────────────────
        let enc = new SignedCookieSessionStore("aead-secret-key").WithEncrypted(true)
        let se = new Session("ignored")
        se.Set("user_id", "42")
        se.Set("role", "admin")
        se.Set("email", "alice@example.com")
        let cipherCookie: string = enc.Encode(se)
        let de: Session = enc.Decode(cipherCookie)
        if (de != null
            && de.Get("user_id") == "42"
            && de.Get("role") == "admin"
            && de.Get("email") == "alice@example.com") {
            Console.WriteLine("[PASS] encrypted roundtrip recovers data")
        } else {
            Console.WriteLine("[FAIL] encrypted roundtrip lost data")
        }

        // ── 10. Encrypted cookie hides plaintext ──────────────────
        // The cookie value should NOT contain "user_id" / "admin"
        // anywhere — that's the whole point of encryption.
        if (String_Contains(cipherCookie, "user_id")
            || String_Contains(cipherCookie, "admin")
            || String_Contains(cipherCookie, "alice")) {
            Console.WriteLine("[FAIL] encrypted cookie leaks plaintext")
        } else {
            Console.WriteLine("[PASS] encrypted cookie hides plaintext")
        }

        // ── 11. Encryption is non-deterministic (fresh nonce) ───
        let c1: string = enc.Encode(se)
        let c2: string = enc.Encode(se)
        if (c1 != c2) {
            Console.WriteLine("[PASS] encrypted output uses fresh nonce")
        } else {
            Console.WriteLine("[FAIL] encrypted output identical — nonce reuse!")
        }

        // ── 12. Wrong-secret reject ───────────────────────────────
        let enc2 = new SignedCookieSessionStore("different-key").WithEncrypted(true)
        let badDec: Session = enc2.Decode(cipherCookie)
        if (badDec == null) {
            Console.WriteLine("[PASS] encrypted wrong-secret reject")
        } else {
            Console.WriteLine("[FAIL] encrypted wrong-secret accepted")
        }

        // ── 13. Tamper detection in encrypted mode ───────────────
        // Flip a hex char in the ciphertext portion (after the
        // dot at position 24). The GCM tag MUST fail.
        let n5: int = String_Length(cipherCookie)
        // Pick a char roughly in the middle, in the ct section.
        let pivot: int = 30
        var flipped: string = String_Substring(cipherCookie, 0, pivot)
        let orig: string = String_CharAt1(cipherCookie, pivot)
        var newCh: string = "0"
        if (orig == "0") { newCh = "1" }
        flipped = flipped + newCh + String_Substring(cipherCookie, pivot + 1, n5 - pivot - 1)
        let tdec: Session = enc.Decode(flipped)
        if (tdec == null) {
            Console.WriteLine("[PASS] encrypted tamper rejected")
        } else {
            Console.WriteLine("[FAIL] encrypted tamper accepted")
        }

        // ── 14. Malformed encrypted cookies rejected ──────────────
        if (enc.Decode("") == null
            && enc.Decode("garbage") == null
            && enc.Decode("zzzzzzzzzzzzzzzzzzzzzzzz.deadbeef") == null) {
            Console.WriteLine("[PASS] malformed encrypted cookies rejected")
        } else {
            Console.WriteLine("[FAIL] malformed encrypted accepted")
        }

        // ── 15. Empty encrypted session roundtrip ─────────────────
        let emptySe = new Session("ignored")
        let ec: string = enc.Encode(emptySe)
        let ed: Session = enc.Decode(ec)
        if (ed != null && ed.Data.Size() == 0) {
            Console.WriteLine("[PASS] empty encrypted session roundtrip")
        } else {
            Console.WriteLine("[FAIL] empty encrypted lost or polluted")
        }

        // ── 16. FromMap honors encrypted=true ─────────────────────
        let cfg2: Map<string, string> = new Map<string, string>()
        cfg2.Set("secret", "ek")
        cfg2.Set("encrypted", "true")
        let store4 = SignedCookieSessionStore.FromMap(cfg2)
        if (store4.Encrypted && store4.Secret == "ek") {
            Console.WriteLine("[PASS] FromMap encrypted=true")
        } else {
            Console.WriteLine("[FAIL] FromMap encrypted flag wrong")
        }

        Console.WriteLine("done")
    }
}

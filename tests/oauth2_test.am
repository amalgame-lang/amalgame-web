// Unit tests for OAuth2Client (v0.17.0+).
//
// Network-free surface only: the preset/builder wiring, StartLogin's
// redirect + state-cookie binding, and HandleCallback's CSRF early
// returns (which fire before any token-exchange HTTP call). The
// token-exchange + userinfo paths need a live provider and are
// exercised manually / in integration, not here.

namespace Tests

import Amalgame.Collections
import Amalgame.String
import Amalgame.Net.Http
import Amalgame.Web
import Amalgame.Crypto

public class Program {
    public static void Main(string[] args) {
        Console.WriteLine("amalgame-web — OAuth2 tests")

        // ── 1. Github preset wires the documented endpoints ──────
        let gh = OAuth2Client.Github("cid", "csecret", "https://app.example.com/cb")
        if (gh.AuthorizeUrl == "https://github.com/login/oauth/authorize"
            && gh.TokenUrl == "https://github.com/login/oauth/access_token"
            && gh.UserInfoUrl == "https://api.github.com/user"
            && gh.Provider == "github") {
            Console.WriteLine("[PASS] Github preset wires authorize/token/userinfo + provider")
        } else {
            Console.WriteLine("[FAIL] Github preset endpoints")
        }

        // ── 2. Google preset carries the minimal scopes ──────────
        let goog = OAuth2Client.Google("gid", "gsecret", "https://app.example.com/cb")
        if (goog.Provider == "google" && goog.Scopes.Count() == 3) {
            Console.WriteLine("[PASS] Google preset sets provider + 3 scopes")
        } else {
            Console.WriteLine("[FAIL] Google preset scopes: " + String_FromInt(goog.Scopes.Count()))
        }

        // ── 3. Custom builder chain sets fields ──────────────────
        let c = new OAuth2Client()
            .WithClientId("myid")
            .WithClientSecret("mysecret")
            .WithAuthorizeUrl("https://idp.example.com/authorize")
            .WithRedirectUri("https://app.example.com/cb")
        if (c.ClientId == "myid" && c.ClientSecret == "mysecret"
            && c.AuthorizeUrl == "https://idp.example.com/authorize") {
            Console.WriteLine("[PASS] custom builder chain composes")
        } else {
            Console.WriteLine("[FAIL] builder chain")
        }

        // ── 4. StartLogin → 302 with the right params + state cookie ─
        let req = new HttpRequest()
        let resp: HttpResponse = gh.StartLogin(req)
        let loc: string    = resp.Headers.Get("Location")
        let cookie: string = resp.Headers.Get("Set-Cookie")
        let is302:   bool = resp.StatusCode == 302
        let hasCode: bool = String_IndexOf(loc, "response_type=code") >= 0
        let hasCid:  bool = String_IndexOf(loc, "client_id=cid") >= 0
        let hasState:bool = String_IndexOf(loc, "state=") >= 0
        let hasCk:   bool = String_IndexOf(cookie, "__oauth_state=") >= 0
        if (is302 && hasCode && hasCid && hasState && hasCk) {
            Console.WriteLine("[PASS] StartLogin → 302 + authorize params + state cookie")
        } else {
            Console.WriteLine("[FAIL] StartLogin shape: status=" + String_FromInt(resp.StatusCode))
        }

        // ── 5. CSRF binding: URL state == cookie state ───────────
        // Pull the state out of the Set-Cookie (between "__oauth_state="
        // and ";") and assert the Location carries the same value.
        let ckKey: string = "__oauth_state="
        let ckIdx: int = String_IndexOf(cookie, ckKey)
        var bound: bool = false
        if (ckIdx >= 0) {
            let afterStart: int = ckIdx + String_Length(ckKey)
            let after: string = String_Substring(cookie, afterStart, String_Length(cookie) - afterStart)
            let semi: int = String_IndexOf(after, ";")
            if (semi > 0) {
                let cookieState: string = String_Substring(after, 0, semi)
                if (String_IndexOf(loc, "state=" + cookieState) >= 0) {
                    bound = true
                }
            }
        }
        if (bound) {
            Console.WriteLine("[PASS] StartLogin binds URL state to the state cookie (CSRF)")
        } else {
            Console.WriteLine("[FAIL] state/cookie binding")
        }

        // ── 6. HandleCallback rejects a state mismatch (no network) ─
        let req2 = new HttpRequest()
        req2.RawTarget = "/cb?state=aaa&code=xyz"
        req2.Headers.Set("cookie", "__oauth_state=bbb")
        let r2: OAuth2Result = gh.HandleCallback(req2)
        if (!r2.Ok && String_IndexOf(r2.Error, "mismatch") >= 0) {
            Console.WriteLine("[PASS] HandleCallback rejects state mismatch")
        } else {
            Console.WriteLine("[FAIL] state mismatch not caught: err=" + r2.Error)
        }

        // ── 7. HandleCallback rejects missing state (no network) ──
        let req3 = new HttpRequest()
        req3.RawTarget = "/cb?code=xyz"
        let r3: OAuth2Result = gh.HandleCallback(req3)
        if (!r3.Ok && String_IndexOf(r3.Error, "state") >= 0) {
            Console.WriteLine("[PASS] HandleCallback rejects missing state")
        } else {
            Console.WriteLine("[FAIL] missing state not caught: err=" + r3.Error)
        }

        // ── 8. PKCE S256 challenge — RFC 7636 Appendix B vector ──
        let chal: string = OAuth2Client.PkceChallenge("dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk")
        if (chal == "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM") {
            Console.WriteLine("[PASS] PKCE S256 challenge matches RFC 7636 vector")
        } else {
            Console.WriteLine("[FAIL] PKCE challenge: " + chal)
        }

        // ── 9. StartLogin WithPkce → code_challenge + verifier cookie ──
        let ghp: OAuth2Client = OAuth2Client.Github("cid", "sec", "https://app/cb").WithPkce()
        let presp: HttpResponse = ghp.StartLogin(new HttpRequest())
        let ploc: string = presp.Headers.Get("Location")
        let pck: string = presp.Headers.Get("Set-Cookie")
        if (String_IndexOf(ploc, "code_challenge=") >= 0
            && String_IndexOf(ploc, "code_challenge_method=S256") >= 0
            && String_IndexOf(pck, "~") >= 0) {
            Console.WriteLine("[PASS] StartLogin+PKCE: code_challenge S256 in URL, verifier in cookie")
        } else {
            Console.WriteLine("[FAIL] PKCE StartLogin shape")
        }

        // ── 10+. OIDC id_token verification (network-free) ──────
        // Self-sign an id_token with a fresh RS256 key, publish that
        // key as a one-entry JWKS, and drive VerifyIdTokenJwks — the
        // same crypto path HandleCallback walks against a live JWKS.
        let kid: string = "k1"
        let kR: JwsKey = JwsKey.GenerateRs256()
        let jwkPub: string = kR.JwkPublic()
        let nVal: string = Program.jf(jwkPub, "n")
        let eVal: string = Program.jf(jwkPub, "e")
        let jwks: string = "{\"keys\":[{\"kty\":\"RSA\",\"kid\":\"" + kid
            + "\",\"n\":\"" + nVal + "\",\"e\":\"" + eVal + "\"}]}"

        let header: string = "{\"alg\":\"RS256\",\"kid\":\"" + kid + "\"}"
        let hB64: string = Bytes.ToBase64Url(Bytes.FromString(header))
        // exp far in the future (year 2100) so the test never ages out.
        let payload: string = "{\"iss\":\"https://idp.test\",\"aud\":\"client-123\""
            + ",\"exp\":4102444800,\"nonce\":\"n0nce\",\"sub\":\"user-1\""
            + ",\"email\":\"a@b.co\",\"name\":\"Alice\"}"
        let pB64: string = Bytes.ToBase64Url(Bytes.FromString(payload))
        let signingInput: string = hB64 + "." + pB64
        let sig: List<int> = kR.Sign(Bytes.FromString(signingInput))
        let sB64: string = Bytes.ToBase64Url(sig)
        let idToken: string = hB64 + "." + pB64 + "." + sB64

        let cli: OAuth2Client = new OAuth2Client()
            .WithClientId("client-123")
            .WithOidc("https://idp.test")

        // 10. Happy path — valid signature + all claims.
        let v1: OAuth2Result = cli.VerifyIdTokenJwks(idToken, jwks, "n0nce")
        if (v1.Ok && v1.UserId == "user-1" && v1.Email == "a@b.co") {
            Console.WriteLine("[PASS] OIDC id_token verifies (sig + iss/aud/exp/nonce)")
        } else {
            Console.WriteLine("[FAIL] OIDC happy path: ok=" + (v1.Ok ? "T" : "F") + " err=" + v1.Error)
        }

        // 11. Nonce mismatch → rejected (replay defence).
        let v2: OAuth2Result = cli.VerifyIdTokenJwks(idToken, jwks, "WRONG")
        if (!v2.Ok && String_IndexOf(v2.Error, "nonce") >= 0) {
            Console.WriteLine("[PASS] OIDC rejects nonce mismatch")
        } else {
            Console.WriteLine("[FAIL] OIDC nonce: ok=" + (v2.Ok ? "T" : "F") + " err=" + v2.Error)
        }

        // 12. Wrong audience → rejected.
        let cliOther: OAuth2Client = new OAuth2Client()
            .WithClientId("someone-else").WithOidc("https://idp.test")
        let v3: OAuth2Result = cliOther.VerifyIdTokenJwks(idToken, jwks, "n0nce")
        if (!v3.Ok && String_IndexOf(v3.Error, "audience") >= 0) {
            Console.WriteLine("[PASS] OIDC rejects audience mismatch")
        } else {
            Console.WriteLine("[FAIL] OIDC aud: ok=" + (v3.Ok ? "T" : "F") + " err=" + v3.Error)
        }

        // 13. Wrong issuer → rejected.
        let cliIss: OAuth2Client = new OAuth2Client()
            .WithClientId("client-123").WithOidc("https://evil.test")
        let v4: OAuth2Result = cliIss.VerifyIdTokenJwks(idToken, jwks, "n0nce")
        if (!v4.Ok && String_IndexOf(v4.Error, "issuer") >= 0) {
            Console.WriteLine("[PASS] OIDC rejects issuer mismatch")
        } else {
            Console.WriteLine("[FAIL] OIDC iss: ok=" + (v4.Ok ? "T" : "F") + " err=" + v4.Error)
        }

        // 14. Tampered payload (re-base64'd claims, original signature)
        //     → signature invalid.
        let evilPayload: string = "{\"iss\":\"https://idp.test\",\"aud\":\"client-123\""
            + ",\"exp\":4102444800,\"nonce\":\"n0nce\",\"sub\":\"admin\"}"
        let evilP: string = Bytes.ToBase64Url(Bytes.FromString(evilPayload))
        let forged: string = hB64 + "." + evilP + "." + sB64
        let v5: OAuth2Result = cli.VerifyIdTokenJwks(forged, jwks, "n0nce")
        if (!v5.Ok && String_IndexOf(v5.Error, "signature") >= 0) {
            Console.WriteLine("[PASS] OIDC rejects tampered payload (sig invalid)")
        } else {
            Console.WriteLine("[FAIL] OIDC tamper: ok=" + (v5.Ok ? "T" : "F") + " err=" + v5.Error)
        }

        // 15. Algorithm-confusion: header claims HS256 → hard reject
        //     BEFORE any signature work.
        let hsHeader: string = "{\"alg\":\"HS256\",\"kid\":\"" + kid + "\"}"
        let hsH: string = Bytes.ToBase64Url(Bytes.FromString(hsHeader))
        let hsToken: string = hsH + "." + pB64 + "." + sB64
        let v6: OAuth2Result = cli.VerifyIdTokenJwks(hsToken, jwks, "n0nce")
        if (!v6.Ok && String_IndexOf(v6.Error, "alg") >= 0) {
            Console.WriteLine("[PASS] OIDC rejects non-RS256 alg (algorithm confusion)")
        } else {
            Console.WriteLine("[FAIL] OIDC alg pin: ok=" + (v6.Ok ? "T" : "F") + " err=" + v6.Error)
        }

        Console.WriteLine("done")
    }

    // Minimal `"key":"value"` extractor for the canonical (escape-free)
    // JWK the crypto facade exports — avoids a Json-stdlib dependency in
    // the test link set.
    static string jf(json: string, key: string) {
        let needle: string = "\"" + key + "\":\""
        let i: int = String_IndexOf(json, needle)
        if (i < 0) { return "" }
        let start: int = i + String_Length(needle)
        let rest: string = String_Substring(json, start, String_Length(json) - start)
        let end: int = String_IndexOf(rest, "\"")
        if (end < 0) { return rest }
        return String_Substring(rest, 0, end)
    }
}

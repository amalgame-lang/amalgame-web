// Unit tests for Template (v0.24.0) — Mustache-like, auto-escaping.
//
// Verifies: HtmlEscape; escaped vs raw interpolation; truthy /
// inverted / nested sections; comments; partials; missing keys.
//
// NOTE: amc treats `{…}` inside string literals as interpolation, so
// template sources here are assembled from LB ("{{") / RB ("}}") built
// from codepoints — never written as brace literals. Real apps load
// templates from files (File_ReadAll), which is runtime data and never
// hits amc's literal interpolation, so this dance is test-only.

namespace Tests

import Amalgame.Collections
import Amalgame.String
import Amalgame.Net.Http
import Amalgame.Web

public class Program {
    // Returns 1 on failure, 0 on pass (caller accumulates — amc has no
    // static mutable class fields).
    static int check(string label, string got, string want) {
        if (got == want) {
            Console.WriteLine("[PASS] " + label)
            return 0
        }
        Console.WriteLine("[FAIL] " + label + " — got <" + got + "> want <" + want + ">")
        return 1
    }

    public static void Main(string[] args) {
        Console.WriteLine("amalgame-web — Template tests")
        var failed: int = 0

        // Brace tokens (avoid amc string interpolation on '{').
        let LB:  string = String_FromCodepoint(123) + String_FromCodepoint(123)   // "{{"
        let RB:  string = String_FromCodepoint(125) + String_FromCodepoint(125)   // "}}"
        let LB3: string = String_FromCodepoint(123) + LB                          // "{{{"
        let RB3: string = String_FromCodepoint(125) + RB                          // "}}}"

        // ── 1. HtmlEscape ────────────────────────────────────────
        failed = failed + Program.check("HtmlEscape",
            Template.HtmlEscape("<a href=\"x\">&'/"),
            "&lt;a href=&quot;x&quot;&gt;&amp;&#39;&#47;")

        // ── 2. Escaped interpolation (the default) ───────────────
        var d1: Map<string, string> = new Map<string, string>()
        d1.Set("name", "<b>")
        failed = failed + Program.check("escaped interpolation",
            Template.RenderString("Hello " + LB + "name" + RB, d1),
            "Hello &lt;b&gt;")

        // ── 3. Raw via triple + & ────────────────────────────────
        var d2: Map<string, string> = new Map<string, string>()
        d2.Set("html", "<b>hi</b>")
        failed = failed + Program.check("raw triple",
            Template.RenderString(LB3 + "html" + RB3, d2), "<b>hi</b>")
        failed = failed + Program.check("raw ampersand",
            Template.RenderString(LB + "&html" + RB, d2), "<b>hi</b>")

        // ── 4. Sections: truthy / falsy ──────────────────────────
        var on: Map<string, string> = new Map<string, string>()
        on.Set("show", "true")
        var off: Map<string, string> = new Map<string, string>()
        off.Set("show", "")
        let secShow:  string = LB + "#show" + RB + "yes" + LB + "/show" + RB
        let invShow:  string = LB + "^show" + RB + "no" + LB + "/show" + RB
        failed = failed + Program.check("section truthy",
            Template.RenderString(secShow, on), "yes")
        failed = failed + Program.check("section falsy",
            Template.RenderString(secShow, off), "")
        failed = failed + Program.check("inverted falsy→shows",
            Template.RenderString(invShow, off), "no")
        failed = failed + Program.check("inverted truthy→hides",
            Template.RenderString(invShow, on), "")

        // ── 5. Nested same-name-safe sections ────────────────────
        let nested: string = LB + "#a" + RB + "A" + LB + "#b" + RB + "B"
            + LB + "/b" + RB + LB + "/a" + RB
        var ab: Map<string, string> = new Map<string, string>()
        ab.Set("a", "1")
        ab.Set("b", "1")
        failed = failed + Program.check("nested both on",
            Template.RenderString(nested, ab), "AB")
        var aOnly: Map<string, string> = new Map<string, string>()
        aOnly.Set("a", "1")
        aOnly.Set("b", "")
        failed = failed + Program.check("nested inner off",
            Template.RenderString(nested, aOnly), "A")

        // ── 6. Comments + missing keys ───────────────────────────
        var empty: Map<string, string> = new Map<string, string>()
        failed = failed + Program.check("comment dropped",
            Template.RenderString("x" + LB + "! hi there " + RB + "y", empty), "xy")
        failed = failed + Program.check("missing key → empty",
            Template.RenderString("[" + LB + "nope" + RB + "]", empty), "[]")

        // ── 7. Partials (escape applies inside) ──────────────────
        var pv: Map<string, string> = new Map<string, string>()
        pv.Set("v", "<x>")
        let partialSrc: string = "<li>" + LB + "v" + RB + "</li>"
        var t: Template = Template.Parse(LB + ">row" + RB).WithPartial("row", partialSrc)
        failed = failed + Program.check("partial + escape",
            t.Render(pv), "<li>&lt;x&gt;</li>")

        // ── 8. Context-aware escapers (v0.29.0) ──────────────────
        // Direct escaper functions.
        let bs: string = String_FromCodepoint(92)   // backslash
        failed = failed + Program.check("JsEscape quote",
            Template.JsEscape("a\"b"), "a" + bs + "x22b")
        failed = failed + Program.check("JsEscape </script>",
            Template.JsEscape("</script>"), bs + "x3C" + bs + "x2Fscript" + bs + "x3E")
        failed = failed + Program.check("AttrEscape space",
            Template.AttrEscape("a b"), "a&#x20;b")
        failed = failed + Program.check("UrlEscape space+amp",
            Template.UrlEscape("a b&c"), "a%20b%26c")
        failed = failed + Program.check("UrlEscape unreserved kept",
            Template.UrlEscape("Aa9-_.~"), "Aa9-_.~")

        // Filter syntax via the template pipe.
        var fx: Map<string, string> = new Map<string, string>()
        fx.Set("x", "<b>")
        fx.Set("q", "a b")
        failed = failed + Program.check("default tag = HTML escape",
            Template.RenderString(LB + "x" + RB, fx), "&lt;b&gt;")
        failed = failed + Program.check("pipe js filter",
            Template.RenderString(LB + "x|js" + RB, fx), bs + "x3Cb" + bs + "x3E")
        failed = failed + Program.check("pipe url filter",
            Template.RenderString(LB + "q|url" + RB, fx), "a%20b")
        failed = failed + Program.check("pipe attr filter",
            Template.RenderString(LB + "q|attr" + RB, fx), "a&#x20;b")
        failed = failed + Program.check("pipe raw filter no escape",
            Template.RenderString(LB + "x|raw" + RB, fx), "<b>")
        failed = failed + Program.check("unknown filter falls back to HTML escape",
            Template.RenderString(LB + "x|bogus" + RB, fx), "&lt;b&gt;")

        // ── 9. List iteration (v0.40.0) ──────────────────────────
        let rowTpl: string = LB + "#articles" + RB
            + "<li>" + LB + "title" + RB + "</li>"
            + LB + "/articles" + RB
        var page: Map<string, string> = new Map<string, string>()
        page.Set("siteName", "Le Rugisseur")
        var rows: List<Map<string, string>> = new List<Map<string, string>>()
        var r1: Map<string, string> = new Map<string, string>()
        r1.Set("title", "<b>Un</b>")
        rows.Add(r1)
        var r2: Map<string, string> = new Map<string, string>()
        r2.Set("title", "Deux")
        rows.Add(r2)
        var ctxList: TemplateContext = TemplateContext.FromData(page).WithList("articles", rows)
        failed = failed + Program.check("list iteration, escaped per row",
            Template.RenderStringContext(rowTpl, ctxList),
            "<li>&lt;b&gt;Un&lt;&#47;b&gt;</li><li>Deux</li>")

        // Empty list: {{#key}} renders nothing, {{^key}} renders once.
        var emptyRows: List<Map<string, string>> = new List<Map<string, string>>()
        var ctxEmpty: TemplateContext = TemplateContext.FromData(page).WithList("articles", emptyRows)
        failed = failed + Program.check("empty list, # section → nothing",
            Template.RenderStringContext(rowTpl, ctxEmpty), "")
        let emptyTpl: string = LB + "^articles" + RB + "no articles" + LB + "/articles" + RB
        failed = failed + Program.check("empty list, ^ section → empty-state",
            Template.RenderStringContext(emptyTpl, ctxEmpty), "no articles")

        // Row fields shadow the outer scope; outer scope stays reachable.
        let scopeTpl: string = LB + "siteName" + RB + ":"
            + LB + "#articles" + RB + LB + "siteName" + RB + LB + "/articles" + RB
        var r3: Map<string, string> = new Map<string, string>()
        r3.Set("siteName", "Article A")
        var rows2: List<Map<string, string>> = new List<Map<string, string>>()
        rows2.Add(r3)
        var ctxShadow: TemplateContext = TemplateContext.FromData(page).WithList("articles", rows2)
        failed = failed + Program.check("row shadows outer scope",
            Template.RenderStringContext(scopeTpl, ctxShadow), "Le Rugisseur:Article A")

        // Render(Map) unaffected — plain boolean sections still work.
        failed = failed + Program.check("Render(Map) unaffected by TemplateContext addition",
            Template.RenderString(secShow, on), "yes")

        // ── Summary ──────────────────────────────────────────────
        Console.WriteLine("")
        Console.WriteLine("failed=" + String_FromInt(failed))
        if (failed > 0) { Console.WriteLine("[FAIL] template suite") }
        else { Console.WriteLine("[PASS] template suite") }
    }
}

// amalgame-web — Session storage primitives.
//
// Lives in its own file since v0.7.x split (was in facade.am v0.7.0
// and earlier). No behavior change vs the previous combined file —
// just locality.

namespace Amalgame.Web

import Amalgame.Collections
import Amalgame.String
import Amalgame.Threading
import Amalgame.Net.Http
import Amalgame.Random

// ─────────────────────────────────────────────────────────────────
// SessionStore — v0.20.0 unifying interface for the WebApp pipeline.
//
// The three concrete stores (MemorySessionStore, RedisSessionStore,
// SignedCookieSessionStore) have very different lookup models —
// server-side by id vs stateless cookie payload. This interface
// abstracts both behind the two operations the pipeline actually
// needs, so `WebApp.WithSession(store)` accepts any of them:
//
//   LoadSession(req)  — read the session cookie off the request and
//                       return the live Session (an existing one for
//                       a returning visitor, a fresh empty one
//                       otherwise). NEVER null: handlers can always
//                       touch ctx.Session.
//   SaveSession(s, r) — persist the session (backend write for the
//                       stateful stores; no-op storage for the
//                       stateless cookie store) AND stamp the
//                       Set-Cookie on the response.
//
// Method names are deliberately distinct from the stores' existing
// Find/Create/Save surface so adding `implements SessionStore` to a
// store introduces no overload ambiguity.
// ─────────────────────────────────────────────────────────────────
public interface SessionStore {
    LoadSession(HttpRequest req) -> Session
    SaveSession(Session s, HttpResponse resp) -> void
}

// v0.9.2: per-instance mutex protecting MemorySessionStore.Sessions
// when Mosaic runs under Http1.ServeMt (multi-thread accept loop).
// Replaces the v0.9.0 process-wide static mutex — two store
// instances no longer serialise against each other.
//
// The `Mu: AmalgameMutex` field is lifted by amc v0.8.37's opaque-
// package-type-as-class-field support. Always-on; uncontended
// pthread_mutex_lock is sub-100ns on modern Linux.

// ─────────────────────────────────────────────────────────────────
// Session — in-memory key/value store carried by a session cookie.
//
// Values are typed as string for v0.1 (JSON-encodable). v0.1.x will
// add typed accessors once we generalize JsonValue storage.
// ─────────────────────────────────────────────────────────────────

public class Session {
    public Id:        string
    public Data:      Map<string, string>
    public CreatedAt: int                       // Unix epoch seconds
    public TouchedAt: int                       // updated on Get/Set
    public MaxAgeSec: int

    // v0.9.4: per-Session mutex. Two requests carrying the same
    // session cookie (common case: a user with 2 browser tabs) end
    // up on different worker threads under Http1.ServeMt, both
    // dereferencing the same Session instance returned by Find().
    // Without the lock, concurrent Get/Set/Delete on Data is a
    // race. The Mu is process-local — for distributed deployments
    // (RedisSessionStore), Redis itself serialises with INCR/EXPIRE
    // atomicity per-key; the Mu here covers the in-memory mutation
    // that happens between Find() and Save().
    public Mu:        AmalgameMutex

    public Session(string id) {
        this.Id        = id
        this.Data      = new Map<string, string>()
        this.CreatedAt = 0
        this.TouchedAt = 0
        this.MaxAgeSec = 86400
        this.Mu        = Threading.MutexNew()
    }

    public string Get(string key) {
        Threading.MutexLock(this.Mu)
        var result: string = ""
        if (this.Data.Has(key)) { result = this.Data.Get(key) }
        Threading.MutexUnlock(this.Mu)
        return result
    }
    public void Set(string key, string value) {
        Threading.MutexLock(this.Mu)
        this.Data.Set(key, value)
        Threading.MutexUnlock(this.Mu)
    }
    public void Delete(string key) {
        Threading.MutexLock(this.Mu)
        this.Data.Remove(key)
        Threading.MutexUnlock(this.Mu)
    }
    public void Clear() {
        Threading.MutexLock(this.Mu)
        this.Data = new Map<string, string>()
        Threading.MutexUnlock(this.Mu)
    }
    public bool Has(string key) {
        Threading.MutexLock(this.Mu)
        let r: bool = this.Data.Has(key)
        Threading.MutexUnlock(this.Mu)
        return r
    }

    // v0.20.0: fresh 256-bit session id, hex-encoded (64 chars), from
    // the OS CSPRNG. Used by the stateful stores' LoadSession() when a
    // request carries no (valid) session cookie. Crypto-grade entropy
    // matters here — a guessable id is a session-hijack vector.
    public static string NewId() {
        let rng: Random = Random.FromSystem()
        let bytes: List<int> = rng.Bytes(32)
        return Session.HexEncode(bytes)
    }

    private static string HexEncode(List<int> bytes) {
        let hex: string = "0123456789abcdef"
        var s: string = ""
        let n: int = bytes.Count()
        var i: int = 0
        while (i < n) {
            let b: int = bytes.Get(i)
            s = s + String_CharAt1(hex, b / 16) + String_CharAt1(hex, b % 16)
            i = i + 1
        }
        return s
    }
}

// ─────────────────────────────────────────────────────────────────
// MemorySessionStore — thread-unsafe in-process session storage.
// Suitable for development and tests. Production deployments should
// use JsonFileSessionStore (v0.1.x) or RedisSessionStore (v0.7).
//
// v0.8.1 wires the `[sessions]` cookie attribute knobs from
// mosaic-configuration.md: CookieName / CookieSecure /
// CookieSameSite / CookiePath / CookieMaxAge. Use `MakeCookie(id)`
// to get a Cookie configured with the store's attributes — drop
// it on a response via `resp.SetCookie(c)`.
// ─────────────────────────────────────────────────────────────────

public class MemorySessionStore implements SessionStore {
    public Sessions:       Map<string, Session>
    public CookieName:     string
    public CookieSecure:   bool
    public CookieSameSite: string         // "Strict" | "Lax" | "None"
    public CookiePath:     string
    public CookieMaxAge:   int             // seconds; 0 = session cookie
    // v0.9.2: per-instance mutex (replaces v0.9.0 process-wide static).
    public Mu:             AmalgameMutex

    public MemorySessionStore() {
        this.Sessions       = new Map<string, Session>()
        this.CookieName     = "mosaic_session"
        this.CookieSecure   = true
        this.CookieSameSite = "Lax"
        this.CookiePath     = "/"
        this.CookieMaxAge   = 0
        this.Mu             = Threading.MutexNew()
    }

    // ── Cookie attribute builders ─────────────────────
    public MemorySessionStore WithCookieName(string n)       { this.CookieName     = n; return this }
    public MemorySessionStore WithCookieSecure(bool s)       { this.CookieSecure   = s; return this }
    public MemorySessionStore WithCookieSameSite(string ss)  { this.CookieSameSite = ss; return this }
    public MemorySessionStore WithCookiePath(string p)       { this.CookiePath     = p; return this }
    public MemorySessionStore WithCookieMaxAge(int a)        { this.CookieMaxAge   = a; return this }

    // Build a Cookie configured with this store's attributes,
    // ready to drop on a response via `resp.SetCookie(c)`. The
    // session value is the id (typically the random token the
    // caller used with Create(id)).
    public Cookie MakeCookie(string sessionId) {
        let c = new Cookie()
        c.Name      = this.CookieName
        c.Value     = sessionId
        c.Path      = this.CookiePath
        c.Secure    = this.CookieSecure
        c.SameSite  = this.CookieSameSite
        c.MaxAgeSec = this.CookieMaxAge
        c.HttpOnly  = true        // session cookies should NOT be JS-readable
        return c
    }

    // FromMap for the [sessions] TOML table. Recognised keys:
    //   cookie_name        string
    //   cookie_secure      "true" | "false"
    //   cookie_samesite    "Strict" | "Lax" | "None"
    //   cookie_path        string
    //   cookie_max_age     int (seconds)
    //   max_age_sec        int — written to each Session's MaxAgeSec on Create
    //                       (when set, overrides the default 86400)
    public static MemorySessionStore FromMap(Map<string, string> cfg) {
        let s = new MemorySessionStore()
        if (cfg.Has("cookie_name"))     { s.CookieName     = cfg.Get("cookie_name") }
        if (cfg.Has("cookie_secure"))   { s.CookieSecure   = (cfg.Get("cookie_secure") == "true") }
        if (cfg.Has("cookie_samesite")) { s.CookieSameSite = cfg.Get("cookie_samesite") }
        if (cfg.Has("cookie_path"))     { s.CookiePath     = cfg.Get("cookie_path") }
        if (cfg.Has("cookie_max_age"))  { s.CookieMaxAge   = String_ToInt(cfg.Get("cookie_max_age")) }
        return s
    }

    // ── Session lifecycle ─────────────────────────────
    // Find a session by id, or null. Thread-safe under
    // Http1.ServeMt — wrapped in this store's per-instance mutex.
    public Session Find(string id) {
        Threading.MutexLock(this.Mu)
        var result: Session = null
        if (this.Sessions.Has(id)) { result = this.Sessions.Get(id) }
        Threading.MutexUnlock(this.Mu)
        return result
    }

    // Create + register a new session with a caller-provided id.
    // Use Router-generated tokens (256-bit random) for prod; tests
    // can pass predictable ids.
    public Session Create(string id) {
        let s = new Session(id)
        Threading.MutexLock(this.Mu)
        this.Sessions.Set(id, s)
        Threading.MutexUnlock(this.Mu)
        return s
    }

    // Remove a session.
    public void Destroy(string id) {
        Threading.MutexLock(this.Mu)
        this.Sessions.Remove(id)
        Threading.MutexUnlock(this.Mu)
    }

    public int Size() {
        Threading.MutexLock(this.Mu)
        let n: int = this.Sessions.Size()
        Threading.MutexUnlock(this.Mu)
        return n
    }

    // ── SessionStore (v0.20.0 pipeline integration) ───
    // Look the cookie's id up in the in-memory map; return the live
    // Session if present, else mint a fresh one (registered now so
    // SaveSession's cookie points at a real entry).
    public Session LoadSession(HttpRequest req) {
        let id: string = req.Cookie(this.CookieName)
        if (String_Length(id) > 0) {
            let existing: Session = this.Find(id)
            if (existing != null) { return existing }
        }
        return this.Create(Session.NewId())
    }

    // The Session is the same object the map holds, so handler
    // mutations are already persisted; we just (idempotently) keep
    // it registered and stamp the id cookie on the response.
    public void SaveSession(Session s, HttpResponse resp) {
        Threading.MutexLock(this.Mu)
        this.Sessions.Set(s.Id, s)
        Threading.MutexUnlock(this.Mu)
        resp.SetCookie(this.MakeCookie(s.Id))
    }
}

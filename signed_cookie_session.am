// amalgame-web — SignedCookieSessionStore (v0.8.5).
//
// Stateless session store: the cookie value IS the encoded session.
// No server-side storage — scales horizontally without a database,
// session data survives server restarts (it lives client-side),
// zero ops for new apps.
//
// Two modes (set via the `Encrypted` flag):
//
//   Signed-only (default; pre-v0.8.5 behavior):
//     HMAC-SHA-256 over a plain-text payload. Tamper-proof, but
//     the session data is VISIBLE to anyone who has the cookie.
//     Cookie format: "<payload>.<sig_hex_64>"
//
//   Encrypted (AEAD, v0.8.5+):
//     AES-256-GCM seal of the payload, authenticated. The session
//     data is confidential (not visible to the client) AND
//     tamper-proof (the GCM tag authenticates ct + AAD).
//     Cookie format: "<nonce_hex_24>.<ct_and_tag_hex>"
//     Key derivation: AES key = SHA-256(secret), so any secret
//     length is acceptable.
//
// The user picks the mode at construction time. Production apps
// storing sensitive data (tokens, emails, names) should set
// `Encrypted = true`. Apps storing only opaque ids / roles can
// stay with signed-only for shorter cookies + zero crypto cost.
//
// Pattern: Flask/itsdangerous + Rails CookieStore. Compatible
// wire shape with Go's `crypto/cipher.Seal` (ct || tag) so a
// non-Mosaic service could decode the same cookie if it shared
// the secret.
//
// LIMITATIONS v0.1 / v0.2:
//   - Keys + values still must not contain '&', '=', or '.' (no
//     escaping yet — JSON payload comes in a future v0.3).
//   - Constant-time string compare still implemented in AM (signed
//     mode only — encrypted mode delegates to OpenSSL's
//     constant-time tag check via EVP_DecryptFinal_ex).

namespace Amalgame.Web

import Amalgame.Collections
import Amalgame.String
import Amalgame.Crypto
import Amalgame.Random
import Amalgame.Net.Http

public class SignedCookieSessionStore implements SessionStore {
    public Secret:         string       // HMAC key OR AES key seed
    public Encrypted:      bool         // v0.8.5: AES-256-GCM mode
    public CookieName:     string
    public CookieSecure:   bool
    public CookieSameSite: string
    public CookiePath:     string
    public CookieMaxAge:   int

    public SignedCookieSessionStore(string secret) {
        this.Secret         = secret
        this.Encrypted      = false
        this.CookieName     = "mosaic_session"
        this.CookieSecure   = true
        this.CookieSameSite = "Lax"
        this.CookiePath     = "/"
        this.CookieMaxAge   = 0
    }

    // ── Builders ─────────────────────────────────────
    public SignedCookieSessionStore WithSecret(string s)         { this.Secret         = s; return this }
    public SignedCookieSessionStore WithEncrypted(bool e)        { this.Encrypted      = e; return this }
    public SignedCookieSessionStore WithCookieName(string n)     { this.CookieName     = n; return this }
    public SignedCookieSessionStore WithCookieSecure(bool s)     { this.CookieSecure   = s; return this }
    public SignedCookieSessionStore WithCookieSameSite(string ss){ this.CookieSameSite = ss; return this }
    public SignedCookieSessionStore WithCookiePath(string p)     { this.CookiePath     = p; return this }
    public SignedCookieSessionStore WithCookieMaxAge(int a)      { this.CookieMaxAge   = a; return this }

    // ── Encode a Session into a cookie value ─────────
    // Dispatches on Encrypted flag.
    public string Encode(Session s) {
        let payload: string = SignedCookieSessionStore.SerializeData(s.Data)
        if (this.Encrypted) {
            return this.EncodeEncrypted(payload)
        }
        let sig: string = Hmac.Sha256OfStrings(this.Secret, payload)
        return payload + "." + sig
    }

    // ── Decode a cookie value back to a Session ──────
    // Returns null if the signature/tag doesn't verify or the
    // format is malformed. Caller treats null as "no valid
    // session" and proceeds anonymously.
    public Session Decode(string cookie_value) {
        if (this.Encrypted) {
            return this.DecodeEncrypted(cookie_value)
        }
        return this.DecodeSigned(cookie_value)
    }

    // ── Signed-only path (unchanged from v0.8.3) ─────
    private Session DecodeSigned(string cookie_value) {
        let n: int = String_Length(cookie_value)
        if (n < 65) { return null }
        let sigStart: int = n - 64
        let dotIdx: int = sigStart - 1
        if (String_CharAt1(cookie_value, dotIdx) != ".") { return null }
        let payload: string = String_Substring(cookie_value, 0, dotIdx)
        let given_sig: string = String_Substring(cookie_value, sigStart, 64)
        let want_sig: string = Hmac.Sha256OfStrings(this.Secret, payload)
        if (!SignedCookieSessionStore.ConstantTimeEqualStr(want_sig, given_sig)) { return null }
        let session = new Session("cookie")
        session.Data = SignedCookieSessionStore.DeserializeData(payload)
        return session
    }

    // ── AEAD encrypted path (v0.8.5) ─────────────────
    // Wire format: <nonce_hex_24>.<ct_and_tag_hex>
    //   nonce_hex   — 12-byte fresh random nonce, hex-encoded → 24 chars
    //   ct_and_tag  — AES-256-GCM(key, nonce, aad="", plaintext=payload)
    //                 → (len(payload) + 16) bytes hex-encoded
    private string EncodeEncrypted(string payload) {
        let key: List<int>   = SignedCookieSessionStore.DeriveAesKey(this.Secret)
        let nonce: List<int> = Random.SystemBytes(12)
        let aad: List<int>   = new List<int>()
        let pt: List<int>    = Bytes.FromString(payload)
        let ct: List<int>    = Aead.SealAes256Gcm(key, nonce, aad, pt)
        let nonceHex: string = Bytes.ToHex(nonce)
        let ctHex: string    = Bytes.ToHex(ct)
        return nonceHex + "." + ctHex
    }

    private Session DecodeEncrypted(string cookie_value) {
        let n: int = String_Length(cookie_value)
        // Minimum length: 24 (nonce hex) + 1 ('.') + 32 (16-byte tag in hex)
        // = 57. Empty plaintext is legal.
        if (n < 57) { return null }
        if (String_CharAt1(cookie_value, 24) != ".") { return null }
        let nonceHex: string = String_Substring(cookie_value, 0, 24)
        let ctHex: string    = String_Substring(cookie_value, 25, n - 25)
        let nonce: List<int> = Bytes.FromHex(nonceHex)
        let ct: List<int>    = Bytes.FromHex(ctHex)
        // Hex parse failed (odd length / non-hex char) → reject.
        if (nonce.Count() != 12) { return null }
        if (ct.Count() < 16)     { return null }
        let key: List<int> = SignedCookieSessionStore.DeriveAesKey(this.Secret)
        let aad: List<int> = new List<int>()
        let res: AeadResult = Aead.OpenAes256Gcm(key, nonce, aad, ct)
        if (!res.Ok) { return null }
        let payload: string = Bytes.ToString(res.Plaintext)
        let session = new Session("cookie")
        session.Data = SignedCookieSessionStore.DeserializeData(payload)
        return session
    }

    // ── SessionStore (v0.20.0 pipeline integration) ───
    // Stateless: decode the cookie payload into a Session, or hand
    // back a fresh empty one when the cookie is absent / tampered /
    // expired. The "cookie" id is a sentinel — this store keys
    // nothing server-side.
    public Session LoadSession(HttpRequest req) {
        let raw: string = req.Cookie(this.CookieName)
        if (String_Length(raw) > 0) {
            let decoded: Session = this.Decode(raw)
            if (decoded != null) { return decoded }
        }
        return new Session("cookie")
    }

    // Re-encode the (possibly mutated) session into the cookie. No
    // backend write — the cookie IS the storage.
    public void SaveSession(Session s, HttpResponse resp) {
        resp.SetCookie(this.MakeCookie(s))
    }

    // ── MakeCookie — wraps Encode in a Cookie object ─
    public Cookie MakeCookie(Session s) {
        let c = new Cookie()
        c.Name      = this.CookieName
        c.Value     = this.Encode(s)
        c.Path      = this.CookiePath
        c.Secure    = this.CookieSecure
        c.SameSite  = this.CookieSameSite
        c.MaxAgeSec = this.CookieMaxAge
        // HttpOnly = true: session cookie should NOT be JS-readable
        // (CSRF double-submit cookies are the exception elsewhere).
        c.HttpOnly  = true
        return c
    }

    // ── FromMap — for the [sessions] TOML table when ─
    // strategy = "encrypted_cookie". Recognised keys:
    //   secret           string — HMAC/AES key seed, required
    //   encrypted        "true" | "false"  (v0.8.5; default false)
    //   cookie_name      string
    //   cookie_secure    "true" | "false"
    //   cookie_samesite  "Strict" | "Lax" | "None"
    //   cookie_path      string
    //   cookie_max_age   int
    public static SignedCookieSessionStore FromMap(Map<string, string> cfg) {
        var secret: string = ""
        if (cfg.Has("secret")) { secret = cfg.Get("secret") }
        let s = new SignedCookieSessionStore(secret)
        if (cfg.Has("encrypted"))       { s.Encrypted      = (cfg.Get("encrypted") == "true") }
        if (cfg.Has("cookie_name"))     { s.CookieName     = cfg.Get("cookie_name") }
        if (cfg.Has("cookie_secure"))   { s.CookieSecure   = (cfg.Get("cookie_secure") == "true") }
        if (cfg.Has("cookie_samesite")) { s.CookieSameSite = cfg.Get("cookie_samesite") }
        if (cfg.Has("cookie_path"))     { s.CookiePath     = cfg.Get("cookie_path") }
        if (cfg.Has("cookie_max_age"))  { s.CookieMaxAge   = String_ToInt(cfg.Get("cookie_max_age")) }
        return s
    }

    // ── Internal: payload serialization ──────────────
    // Format: "k1=v1&k2=v2&...". Keys + values must not contain
    // '&', '=', or '.' (no escaping in v0.1). Deserialize is the
    // inverse; pairs without '=' are silently dropped.
    private static string SerializeData(Map<string, string> d) {
        var s: string = ""
        let keys: List<string> = d.Keys()
        let n: int = keys.Count()
        for i in 0..n {
            let k: string = keys.Get(i)
            let v: string = d.Get(k)
            if (i > 0) { s = s + "&" }
            s = s + k + "=" + v
        }
        return s
    }

    private static Map<string, string> DeserializeData(string raw) {
        let m: Map<string, string> = new Map<string, string>()
        let n: int = String_Length(raw)
        if (n == 0) { return m }
        var start: int = 0
        var i: int = 0
        while (i <= n) {
            let isEnd: bool = (i == n)
            var sep: bool = false
            if (!isEnd) {
                let c: string = String_CharAt1(raw, i)
                if (c == "&") { sep = true }
            }
            if (isEnd || sep) {
                let pair: string = String_Substring(raw, start, i - start)
                let pn: int = String_Length(pair)
                var eq: int = -1
                var j: int = 0
                while (j < pn) {
                    if (String_CharAt1(pair, j) == "=") { eq = j; j = pn }
                    else { j = j + 1 }
                }
                if (eq > 0 && eq < pn) {
                    let k: string = String_Substring(pair, 0, eq)
                    let v: string = String_Substring(pair, eq + 1, pn - eq - 1)
                    m.Set(k, v)
                }
                start = i + 1
            }
            i = i + 1
        }
        return m
    }

    // ── Internal: constant-time string compare ───────
    private static bool ConstantTimeEqualStr(string a, string b) {
        if (String_Length(a) != String_Length(b)) { return false }
        let n: int = String_Length(a)
        var acc: int = 0
        var i: int = 0
        while (i < n) {
            let ca: string = String_CharAt1(a, i)
            let cb: string = String_CharAt1(b, i)
            if (ca != cb) { acc = acc + 1 }
            i = i + 1
        }
        return acc == 0
    }

    // ── Internal: AES key derivation ─────────────────
    // AES-256-GCM requires exactly 32 bytes. Hash the user's
    // arbitrary-length secret with SHA-256 to land at 32 bytes.
    // No HKDF / salt / iteration count — the secret IS the key
    // material, we're just normalising the length. Don't reuse
    // this key for any other purpose (HMAC + AEAD on the same
    // key is fine for this asymmetric construction, but if the
    // user wires the same secret into a totally separate sub-
    // system that's their problem to namespace).
    private static List<int> DeriveAesKey(string secret) {
        let secret_bytes: List<int> = Bytes.FromString(secret)
        return Sha256.Bytes(secret_bytes)
    }
}

// amalgame-web — Template engine (Mustache-like, auto-escaping).
//
// Pure Amalgame. Closes the XSS gap left by HttpResponse.Html(), which
// stores the body verbatim: `{{x}}` HTML-escapes its value by default,
// so user-controlled data is safe unless the author explicitly opts out
// with `{{{x}}}` / `{{&x}}`.
//
// Scope v0.24.0:
//   {{key}}        → HtmlEscape(value)          (escaped — the default)
//   {{{key}}}      → raw value (no escape)       (explicit opt-out)
//   {{&key}}       → raw value (no escape)       (alias of triple)
//   {{#key}}…{{/key}}   section: rendered once iff `key` is truthy
//   {{^key}}…{{/key}}   inverted: rendered iff `key` is falsy
//   {{! comment }}  dropped
//   {{>name}}      partial: a registered template inlined here
//
// Truthiness over a Map<string,string>: key present AND value not in
// { "", "false", "0" }.
//
// v0.40.0 — list iteration. `{{#key}}…{{/key}}` repeats its block once
// per row when `key` is bound to a list of rows instead of a scalar:
//   var ctx = TemplateContext.FromData(pageData)
//       .WithList("articles", rows)   // List<Map<string,string>>
//   Template.Parse(src).RenderContext(ctx)
// Each row's fields shadow the outer scope inside the block (a `title`
// key on the row wins over an outer `title`) — everything else in the
// outer scope (site name, nav, …) stays reachable. `{{#key}}` with zero
// rows renders nothing; `{{^key}}` with zero rows renders once (empty
// state); a `key` absent from Lists falls back to the v0.24.0 boolean
// behavior on Data, unchanged. `Render(Map<string,string>)` keeps
// working exactly as before — TemplateContext is opt-in.
//
// Load order: amalgame.toml `sources` must list template.am before
// web_context.am (WebContext.Render returns a Template-rendered body).

namespace Amalgame.Web

import Amalgame.Collections
import Amalgame.IO

// A render context: flat scalar data (v0.24.0 behavior) plus, since
// v0.40.0, named lists of rows for `{{#key}}` iteration. Both maps are
// looked up by the same `key` namespace — binding "articles" in Lists
// makes `{{#articles}}` iterate instead of testing truthiness.
public class TemplateContext {
    public Data:  Map<string, string>
    public Lists: Map<string, List<Map<string, string>>>

    public TemplateContext(Map<string, string> data, Map<string, List<Map<string, string>>> lists) {
        this.Data  = data
        this.Lists = lists
    }

    public static TemplateContext FromData(Map<string, string> data) {
        return new TemplateContext(data, new Map<string, List<Map<string, string>>>())
    }

    public TemplateContext WithList(string key, List<Map<string, string>> rows) {
        this.Lists.Set(key, rows)
        return this
    }
}

// Bounds partial recursion so a self-referential partial can't loop
// forever. Generous for real templates, cheap insurance otherwise.
public class Template {
    public Source:   string
    public Partials: Map<string, string>   // name → partial source

    public Template() {
        this.Source   = ""
        this.Partials = new Map<string, string>()
    }

    // ── Construction ────────────────────────────────────────────────
    public static Template Parse(string src) {
        var t: Template = new Template()
        t.Source = src
        return t
    }

    public static Template FromFile(string path) {
        var t: Template = new Template()
        t.Source = File_ReadAll(path)
        return t
    }

    public Template WithPartial(string name, string src) {
        this.Partials.Set(name, src)
        return this
    }

    // ── Rendering ───────────────────────────────────────────────────
    public string Render(Map<string, string> data) {
        return this.RenderContext(TemplateContext.FromData(data))
    }

    // v0.40.0 — render with list-bound sections. See the file header
    // for `{{#key}}` iteration semantics.
    public string RenderContext(TemplateContext ctx) {
        return this.renderSpan(this.Source, ctx, 0)
    }

    public static string RenderString(string src, Map<string, string> data) {
        var t: Template = Template.Parse(src)
        return t.Render(data)
    }

    public static string RenderStringContext(string src, TemplateContext ctx) {
        var t: Template = Template.Parse(src)
        return t.RenderContext(ctx)
    }

    // HTML-escape & < > " ' / — the last two cover single-quoted
    // attribute contexts and close </script> style breakouts.
    public static string HtmlEscape(string s) {
        var out: string = ""
        let n: int = String_Length(s)
        var i: int = 0
        while (i < n) {
            let ch: string = String_CharAt1(s, i)
            if (ch == "&")       { out = out + "&amp;" }
            else if (ch == "<")  { out = out + "&lt;" }
            else if (ch == ">")  { out = out + "&gt;" }
            else if (ch == "\"") { out = out + "&quot;" }
            else if (ch == "'")  { out = out + "&#39;" }
            else if (ch == "/")  { out = out + "&#47;" }
            else                 { out = out + ch }
            i = i + 1
        }
        return out
    }

    // Context-aware escapers. `{{x}}` escapes for HTML *text/quoted-attr*
    // by default (HtmlEscape), but a value placed in a JavaScript string,
    // an unquoted HTML attribute, or a URL parameter needs a different
    // escaping or it's still XSS-able. Select with a pipe filter:
    //   {{x|js}}    inside <script> … "{{x|js}}" …
    //   {{x|attr}}  inside <div data-x={{x|attr}}>  (quoted or not)
    //   {{x|url}}   inside <a href="/s?q={{x|url}}">
    //   {{x|raw}}   no escaping (same as {{{x}}})
    // All three iterate BYTES (correct for URL/attr percent/hex encoding)
    // and pass bytes ≥128 through so UTF-8 survives.

    // JS string-literal context. OWASP style: alphanumerics pass, every
    // other ASCII byte → \xHH. Blocks quote breakout AND </script>.
    public static string JsEscape(string s) {
        var out: string = ""
        let n: int = String_Length(s)
        var i: int = 0
        while (i < n) {
            let b: int = Template.byteAt(s, i)
            if (Template.isAlnum(b) || b >= 128) { out = out + String_CharAt1(s, i) }
            else { out = out + "\\x" + Template.hex2(b) }
            i = i + 1
        }
        return out
    }

    // HTML attribute context (quoted or unquoted). Alphanumerics pass,
    // every other ASCII byte → &#xHH;.
    public static string AttrEscape(string s) {
        var out: string = ""
        let n: int = String_Length(s)
        var i: int = 0
        while (i < n) {
            let b: int = Template.byteAt(s, i)
            if (Template.isAlnum(b) || b >= 128) { out = out + String_CharAt1(s, i) }
            else { out = out + "&#x" + Template.hex2(b) + ";" }
            i = i + 1
        }
        return out
    }

    // URL-component context (RFC 3986). Unreserved (A-Za-z0-9 - _ . ~)
    // pass; every other byte is percent-encoded.
    public static string UrlEscape(string s) {
        var out: string = ""
        let n: int = String_Length(s)
        var i: int = 0
        while (i < n) {
            let b: int = Template.byteAt(s, i)
            let unreserved: bool = Template.isAlnum(b) || b == 45 || b == 95 || b == 46 || b == 126
            if (unreserved) { out = out + String_CharAt1(s, i) }
            else { out = out + "%" + Template.hex2(b) }
            i = i + 1
        }
        return out
    }

    // Map a pipe-filter name to an escaper. Unknown filter → HtmlEscape
    // (fail safe: escape rather than leak).
    static string applyFilter(string val, string filt) {
        if (filt == "" || filt == "html") { return Template.HtmlEscape(val) }
        if (filt == "js")   { return Template.JsEscape(val) }
        if (filt == "attr") { return Template.AttrEscape(val) }
        if (filt == "url")  { return Template.UrlEscape(val) }
        if (filt == "raw")  { return val }
        return Template.HtmlEscape(val)
    }

    // ── Internals ───────────────────────────────────────────────────

    // Byte value (0..255) at index i. URL/attr/JS escaping is byte-level.
    static int byteAt(string s, int i) {
        var b: int = 0
        @c { b = (i64)(unsigned char) s[i]; }
        return b
    }

    static bool isAlnum(int b) {
        if (b >= 48 && b <= 57)  { return true }   // 0-9
        if (b >= 65 && b <= 90)  { return true }   // A-Z
        if (b >= 97 && b <= 122) { return true }   // a-z
        return false
    }

    // Two uppercase hex digits for a byte.
    static string hex2(int b) {
        let d: string = "0123456789ABCDEF"
        return String_CharAt1(d, b / 16) + String_CharAt1(d, b % 16)
    }

    // Render one span of template text. `depth` bounds partial recursion.
    string renderSpan(string src, TemplateContext ctx, int depth) {
        var out: string = ""
        let n: int = String_Length(src)
        var i: int = 0
        while (i < n) {
            let open: int = Template.idxFrom(src, "{{", i)
            if (open < 0) {
                out = out + String_Substring(src, i, n - i)
                i = n
            } else {
                // literal text before the tag
                if (open > i) { out = out + String_Substring(src, i, open - i) }

                // triple {{{ … }}} → raw
                let isTriple: bool = (open + 2 < n) && (String_CharAt1(src, open + 2) == "{")
                if (isTriple) {
                    let tclose: int = Template.idxFrom(src, "}}}", open + 3)
                    if (tclose < 0) {
                        out = out + String_Substring(src, open, n - open)
                        i = n
                    } else {
                        let key: string = String_Trim(String_Substring(src, open + 3, tclose - (open + 3)))
                        out = out + Template.valueOf(ctx.Data, key)
                        i = tclose + 3
                    }
                } else {
                    let close: int = Template.idxFrom(src, "}}", open + 2)
                    if (close < 0) {
                        out = out + String_Substring(src, open, n - open)
                        i = n
                    } else {
                        let inner: string = String_Trim(String_Substring(src, open + 2, close - (open + 2)))
                        let tagEnd: int = close + 2
                        let sigil: string = ""
                        if (String_Length(inner) > 0) { sigil = String_CharAt1(inner, 0) }

                        if (sigil == "!") {
                            // comment — drop
                            i = tagEnd
                        } else if (sigil == "&") {
                            let key: string = String_Trim(String_Substring(inner, 1, String_Length(inner) - 1))
                            out = out + Template.valueOf(ctx.Data, key)
                            i = tagEnd
                        } else if (sigil == ">") {
                            let name: string = String_Trim(String_Substring(inner, 1, String_Length(inner) - 1))
                            if (depth < 32 && this.Partials.Has(name)) {
                                out = out + this.renderSpan(this.Partials.Get(name), ctx, depth + 1)
                            }
                            i = tagEnd
                        } else if (sigil == "#" || sigil == "^") {
                            let key: string = String_Trim(String_Substring(inner, 1, String_Length(inner) - 1))
                            let closeOpen: int = this.findMatchingClose(src, key, tagEnd)
                            if (closeOpen < 0) {
                                // malformed — treat the open tag as consumed, emit nothing
                                i = tagEnd
                            } else {
                                let block: string = String_Substring(src, tagEnd, closeOpen - tagEnd)
                                let closeEnd: int = Template.idxFrom(src, "}}", closeOpen + 2)
                                var after: int = n
                                if (closeEnd >= 0) { after = closeEnd + 2 }

                                if (ctx.Lists.Has(key)) {
                                    // List-bound section (v0.40.0): iterate rows.
                                    let rows: List<Map<string, string>> = ctx.Lists.Get(key)
                                    let count: int = rows.Count()
                                    if (sigil == "#") {
                                        var r: int = 0
                                        while (r < count) {
                                            let merged: Map<string, string> = Template.mergeRow(ctx.Data, rows.Get(r))
                                            let rowCtx: TemplateContext = new TemplateContext(merged, ctx.Lists)
                                            out = out + this.renderSpan(block, rowCtx, depth)
                                            r = r + 1
                                        }
                                    } else if (count == 0) {
                                        // ^key on a bound (empty) list — empty-state block.
                                        out = out + this.renderSpan(block, ctx, depth)
                                    }
                                } else {
                                    let truthy: bool = Template.isTruthy(ctx.Data, key)
                                    var render: bool = false
                                    if (sigil == "#" && truthy)  { render = true }
                                    if (sigil == "^" && !truthy) { render = true }
                                    if (render) { out = out + this.renderSpan(block, ctx, depth) }
                                }
                                i = after
                            }
                        } else if (sigil == "/") {
                            // stray close — skip
                            i = tagEnd
                        } else {
                            // normal {{key}} or {{key|filter}} — escaped.
                            // Default is HTML-context escaping; an explicit
                            // pipe filter selects a different context
                            // (js / attr / url / raw). Unknown filter falls
                            // back to HTML-escape (fail safe).
                            let pipe: int = String_IndexOf(inner, "|")
                            if (pipe < 0) {
                                out = out + Template.HtmlEscape(Template.valueOf(ctx.Data, inner))
                            } else {
                                let k: string = String_Trim(String_Substring(inner, 0, pipe))
                                let f: string = String_Trim(String_Substring(inner, pipe + 1, String_Length(inner) - pipe - 1))
                                out = out + Template.applyFilter(Template.valueOf(ctx.Data, k), f)
                            }
                            i = tagEnd
                        }
                    }
                }
            }
        }
        return out
    }

    // Find the matching "{{/key}}" for an already-consumed "{{#key}}" /
    // "{{^key}}", honoring nesting of same-named sections. Returns the
    // index of the closing tag's "{{", or -1 if unbalanced.
    int findMatchingClose(string src, string key, int from) {
        var depth: int = 1
        let n: int = String_Length(src)
        var i: int = from
        while (i < n) {
            let open: int = Template.idxFrom(src, "{{", i)
            if (open < 0) { return -1 }
            let isTriple: bool = (open + 2 < n) && (String_CharAt1(src, open + 2) == "{")
            if (isTriple) {
                let tclose: int = Template.idxFrom(src, "}}}", open + 3)
                if (tclose < 0) { return -1 }
                i = tclose + 3
            } else {
                let close: int = Template.idxFrom(src, "}}", open + 2)
                if (close < 0) { return -1 }
                let inner: string = String_Trim(String_Substring(src, open + 2, close - (open + 2)))
                let tagEnd: int = close + 2
                var sigil: string = ""
                if (String_Length(inner) > 0) { sigil = String_CharAt1(inner, 0) }
                if (sigil == "#" || sigil == "^") {
                    let k: string = String_Trim(String_Substring(inner, 1, String_Length(inner) - 1))
                    if (k == key) { depth = depth + 1 }
                } else if (sigil == "/") {
                    let k: string = String_Trim(String_Substring(inner, 1, String_Length(inner) - 1))
                    if (k == key) {
                        depth = depth - 1
                        if (depth == 0) { return open }
                    }
                }
                i = tagEnd
            }
        }
        return -1
    }

    // value(data, key): "" when absent.
    static string valueOf(Map<string, string> data, string key) {
        if (data.Has(key)) { return data.Get(key) }
        return ""
    }

    // truthy: present AND not "", "false", "0".
    static bool isTruthy(Map<string, string> data, string key) {
        if (!data.Has(key)) { return false }
        let v: string = data.Get(key)
        if (v == "")      { return false }
        if (v == "false") { return false }
        if (v == "0")     { return false }
        return true
    }

    // Row scope for list iteration: outer keys visible, row keys win on
    // collision. A fresh map per row — outer/row inputs are untouched.
    static Map<string, string> mergeRow(Map<string, string> outer, Map<string, string> row) {
        var merged: Map<string, string> = new Map<string, string>()
        let outerKeys: List<string> = outer.Keys()
        var i: int = 0
        while (i < outerKeys.Count()) {
            let k: string = outerKeys.Get(i)
            merged.Set(k, outer.Get(k))
            i = i + 1
        }
        let rowKeys: List<string> = row.Keys()
        i = 0
        while (i < rowKeys.Count()) {
            let k: string = rowKeys.Get(i)
            merged.Set(k, row.Get(k))
            i = i + 1
        }
        return merged
    }

    // indexOf `sub` in `s` starting at `start` (String_IndexOf is from 0).
    static int idxFrom(string s, string sub, int start) {
        let n: int = String_Length(s)
        if (start <= 0) { return String_IndexOf(s, sub) }
        if (start >= n) { return -1 }
        let tail: string = String_Substring(s, start, n - start)
        let r: int = String_IndexOf(tail, sub)
        if (r < 0) { return -1 }
        return start + r
    }
}

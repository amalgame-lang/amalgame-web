// amalgame-web — OAuth2Client (v0.17.0).
//
// OAuth 2.0 Authorization Code flow client. The two-call pattern:
//
//   // In /login handler:
//   return oauth.StartLogin(req)        // 302 → provider + sets state cookie
//
//   // In /auth/callback handler:
//   let r = oauth.HandleCallback(req)
//   if (r.Ok) {
//       // r.AccessToken — bearer token for further API calls
//       // r.UserInfo   — raw JSON from userinfo endpoint
//       // r.UserId / r.Email / r.Username — pre-extracted
//   }
//
// Surface:
//   - OAuth2Client.Github(id, secret, redirectUri) — preset, no scopes
//   - OAuth2Client.Google(id, secret, redirectUri) — preset, openid+email
//   - Custom: new OAuth2Client()
//             .WithClientId(...) .WithClientSecret(...)
//             .WithAuthorizeUrl(...) .WithTokenUrl(...)
//             .WithUserInfoUrl(...) .WithRedirectUri(...)
//             .WithScopes([...])
//
// What's NOT here (yet):
//   - PKCE (Authorization Code with code_challenge / code_verifier).
//     Recommended by RFC 9700 / OAuth 2.1 for all clients. The
//     Github + Google presets use confidential-client flow with
//     client_secret over TLS, which is still RFC-compliant but
//     not the modern default. PKCE lands in v0.18.
//   - id_token / OIDC. We hit the OAuth2 userinfo endpoint as a
//     proxy for OIDC's UserInfo, which works for Github + Google
//     but doesn't verify the id_token JWT signature. Full OIDC
//     (RS256 + JWKS rotation) lands in v0.18.
//   - State storage server-side. We store state in an HTTP-only
//     cookie and compare to the query param on callback. Sufficient
//     against generic CSRF; an attacker who can both inject a
//     cookie and forge the callback could replay, but that's a
//     much stronger attacker than the OAuth2 threat model.
//
// Production note: MUST run over TLS. The OAuth2 spec mandates
// HTTPS for the redirect_uri; some providers (Github) refuse
// http://* in non-localhost setups. WebApp.ServeHttps (v0.14+)
// is the production-recommended pair.

namespace Amalgame.Web

import Amalgame.Collections
import Amalgame.String
import Amalgame.Net.Http
import Amalgame.Crypto

public class OAuth2Result {
    public Ok:           bool
    public Error:        string
    public AccessToken:  string
    public TokenType:    string         // usually "bearer"
    public UserInfo:     string         // raw JSON body from userinfo endpoint
    public UserId:       string         // provider-specific
    public Email:        string
    public Username:     string

    public OAuth2Result() {
        this.Ok          = false
        this.Error       = ""
        this.AccessToken = ""
        this.TokenType   = ""
        this.UserInfo    = ""
        this.UserId      = ""
        this.Email       = ""
        this.Username    = ""
    }
}

public class OAuth2Client {
    public ClientId:     string
    public ClientSecret: string
    public AuthorizeUrl: string
    public TokenUrl:     string
    public UserInfoUrl:  string
    public RedirectUri:  string
    public Scopes:       List<string>
    // Cookie name that carries the CSRF state between /login and
    // /callback. Default "__oauth_state" — apps running multiple
    // OAuth providers in parallel should override to disambiguate.
    public StateCookie:  string
    // Provider tag — drives which UserInfo fields we extract.
    // "github" / "google" / "" (generic — no extraction beyond
    // the raw body).
    public Provider:     string
    // v0.34.0: PKCE (RFC 7636, S256). When on, StartLogin sends a
    // code_challenge and carries the code_verifier in the state cookie;
    // HandleCallback replays the verifier in the token exchange. Defends
    // the auth-code flow against interception. Opt-in (WithPkce) to keep
    // the existing flow byte-compatible; recommended for public clients.
    public UsePkce:      bool
    // v0.35.0: OpenID Connect. When on, HandleCallback verifies the
    // id_token returned by the token endpoint — RS256 signature against
    // the IdP's JWKS, plus iss / aud / exp / nonce claim checks — and
    // trusts the id_token's claims (sub/email/name) as authoritative
    // instead of (or before) the userinfo call. StartLogin also sends a
    // one-time `nonce`, carried in the state cookie, that the id_token
    // must echo back (replay defence). Opt-in via WithOidc(issuer).
    public UseOidc:      bool
    public Issuer:       string      // expected `iss`; also the discovery base
    public JwksUri:      string      // explicit JWKS endpoint (else discovered)

    public OAuth2Client() {
        this.ClientId     = ""
        this.ClientSecret = ""
        this.AuthorizeUrl = ""
        this.TokenUrl     = ""
        this.UserInfoUrl  = ""
        this.RedirectUri  = ""
        this.Scopes       = new List<string>()
        this.StateCookie  = "__oauth_state"
        this.Provider     = ""
        this.UsePkce      = false
        this.UseOidc      = false
        this.Issuer       = ""
        this.JwksUri      = ""
    }

    // ── Presets ──────────────────────────────────────

    // Github OAuth App. Create one at https://github.com/settings/
    // applications/new — set Authorization callback URL to the
    // exact `redirectUri` you pass here.
    public static OAuth2Client Github(clientId: string, clientSecret: string, redirectUri: string) {
        let c = new OAuth2Client()
        c.ClientId     = clientId
        c.ClientSecret = clientSecret
        c.AuthorizeUrl = "https://github.com/login/oauth/authorize"
        c.TokenUrl     = "https://github.com/login/oauth/access_token"
        c.UserInfoUrl  = "https://api.github.com/user"
        c.RedirectUri  = redirectUri
        c.Provider     = "github"
        return c
    }

    // Google Sign-In via OAuth2. Create credentials at
    // https://console.cloud.google.com/apis/credentials. The issuer +
    // JWKS endpoint are pre-wired, so `.WithOidc()` (no argument) is
    // enough to switch on id_token verification.
    public static OAuth2Client Google(clientId: string, clientSecret: string, redirectUri: string) {
        let c = new OAuth2Client()
        c.ClientId     = clientId
        c.ClientSecret = clientSecret
        c.AuthorizeUrl = "https://accounts.google.com/o/oauth2/v2/auth"
        c.TokenUrl     = "https://oauth2.googleapis.com/token"
        c.UserInfoUrl  = "https://openidconnect.googleapis.com/v1/userinfo"
        c.RedirectUri  = redirectUri
        // Google requires explicit scopes — minimal set for id + email.
        c.Scopes.Add("openid")
        c.Scopes.Add("email")
        c.Scopes.Add("profile")
        c.Provider     = "google"
        // Pre-wire OIDC discovery (opt-in still via WithOidc()).
        c.Issuer       = "https://accounts.google.com"
        c.JwksUri      = "https://www.googleapis.com/oauth2/v3/certs"
        return c
    }

    // ── Builders ─────────────────────────────────────
    public OAuth2Client WithClientId(s: string)     { this.ClientId     = s; return this }
    public OAuth2Client WithClientSecret(s: string) { this.ClientSecret = s; return this }
    public OAuth2Client WithAuthorizeUrl(s: string) { this.AuthorizeUrl = s; return this }
    public OAuth2Client WithTokenUrl(s: string)     { this.TokenUrl     = s; return this }
    public OAuth2Client WithUserInfoUrl(s: string)  { this.UserInfoUrl  = s; return this }
    public OAuth2Client WithRedirectUri(s: string)  { this.RedirectUri  = s; return this }
    // Enable PKCE (RFC 7636, S256). Recommended for SPAs / mobile /
    // any public client; harmless for confidential clients too.
    public OAuth2Client WithPkce()                  { this.UsePkce = true; return this }
    public OAuth2Client WithScopes(xs: List<string>) { this.Scopes = xs; return this }
    public OAuth2Client WithStateCookie(s: string)  { this.StateCookie  = s; return this }

    // Enable OpenID Connect id_token verification. Pass the issuer (the
    // `iss` the IdP stamps, e.g. "https://accounts.google.com") — or ""
    // to reuse a preset's pre-wired Issuer. Forces the `openid` scope on
    // (no openid scope → no id_token). With OIDC on, HandleCallback
    // cryptographically verifies the id_token before returning Ok.
    public OAuth2Client WithOidc(issuer: string) {
        this.UseOidc = true
        if (String_Length(issuer) > 0) { this.Issuer = issuer }
        var hasOpenid: bool = false
        for s in this.Scopes { if (s == "openid") { hasOpenid = true } }
        if (!hasOpenid) { this.Scopes.Add("openid") }
        return this
    }
    // Pin the JWKS endpoint explicitly (skips OIDC discovery).
    public OAuth2Client WithJwksUri(s: string)      { this.JwksUri = s; return this }

    // ── StartLogin ───────────────────────────────────

    // Build the provider's authorize-URL redirect response. Sets a
    // signed-via-randomness cookie carrying the state value so we
    // can match it on callback. Sets SameSite=Lax + HttpOnly so
    // the cookie survives the cross-origin redirect coming back
    // from the provider.
    public HttpResponse StartLogin(req: HttpRequest) {
        let state: string = OAuth2Client.RandomState(32)
        let scopeStr: string = OAuth2Client.JoinSpace(this.Scopes)
        var url: string = this.AuthorizeUrl + "?response_type=code"
        url = url + "&client_id="    + OAuth2Client.UrlEncode(this.ClientId)
        url = url + "&redirect_uri=" + OAuth2Client.UrlEncode(this.RedirectUri)
        url = url + "&state="        + OAuth2Client.UrlEncode(state)
        if (String_Length(scopeStr) > 0) {
            url = url + "&scope=" + OAuth2Client.UrlEncode(scopeStr)
        }
        // The state cookie carries up to three tilde-separated fields:
        //   state ~ pkce_verifier ~ oidc_nonce
        // '~' is never produced by base64url, so the split is
        // unambiguous; unused fields are left empty. When neither PKCE
        // nor OIDC is on, the cookie stays the bare `state` (v0.17
        // byte-compatible).
        var cookieVal: string = state
        if (this.UsePkce || this.UseOidc) {
            var verifier: string = ""
            if (this.UsePkce) {
                verifier = OAuth2Client.RandomState(32)
                let challenge: string = OAuth2Client.PkceChallenge(verifier)
                url = url + "&code_challenge=" + OAuth2Client.UrlEncode(challenge)
                url = url + "&code_challenge_method=S256"
            }
            var nonce: string = ""
            if (this.UseOidc) {
                // One-time nonce binds the id_token to THIS login — the
                // token must echo it back or we reject (replay defence,
                // OIDC core §3.1.2.1).
                nonce = OAuth2Client.RandomState(32)
                url = url + "&nonce=" + OAuth2Client.UrlEncode(nonce)
            }
            cookieVal = state + "~" + verifier + "~" + nonce
        }
        // Cookie is short-lived (5 min) — enough for the user to
        // complete the provider auth dance. Strict TTL caps replay.
        let cookie: string = this.StateCookie + "=" + cookieVal +
            "; Path=/; Max-Age=300; HttpOnly; SameSite=Lax; Secure"
        return HttpResponse.New()
            .Status(302)
            .Header("Location", url)
            .Header("Set-Cookie", cookie)
            .Header("Cache-Control", "no-store")
            .Text("")
    }

    // ── HandleCallback ───────────────────────────────

    // Verify state, exchange code for an access_token, fetch
    // userinfo. Returns OAuth2Result with extracted fields on
    // success.
    public OAuth2Result HandleCallback(req: HttpRequest) {
        let r = new OAuth2Result()
        if (req == null) { r.Error = "no request"; return r }

        // 1. State verification — provider posts the same state
        //    value we put in StartLogin's URL. Match it against
        //    the cookie. Both must be present + equal.
        let urlState: string = OAuth2Client.QueryValue(req.RawTarget, "state")
        let cookieRaw: string = OAuth2Client.CookieValue(
            req.Header("cookie"), this.StateCookie)
        // Split the cookie into [state, pkce_verifier, oidc_nonce].
        // A bare cookie (no '~') keeps state in field 0 and the rest
        // empty — v0.17 byte-compatible.
        let fields: List<string> = OAuth2Client.SplitTilde(cookieRaw)
        var cookieState: string = ""
        var verifier: string = ""
        var nonce: string = ""
        if (fields.Count() > 0) { cookieState = fields.Get(0) }
        if (fields.Count() > 1) { verifier = fields.Get(1) }
        if (fields.Count() > 2) { nonce = fields.Get(2) }
        if (String_Length(urlState) == 0 || String_Length(cookieState) == 0) {
            r.Error = "missing state (CSRF check failed)"
            return r
        }
        if (urlState != cookieState) {
            r.Error = "state mismatch (CSRF check failed)"
            return r
        }
        if (this.UsePkce && String_Length(verifier) == 0) {
            r.Error = "missing PKCE verifier"
            return r
        }
        if (this.UseOidc && String_Length(nonce) == 0) {
            r.Error = "missing OIDC nonce"
            return r
        }

        // 2. Code from the URL.
        let code: string = OAuth2Client.QueryValue(req.RawTarget, "code")
        if (String_Length(code) == 0) {
            // Some providers redirect with `?error=access_denied`
            // instead of `?code=...` when the user declines.
            let urlErr: string = OAuth2Client.QueryValue(req.RawTarget, "error")
            if (String_Length(urlErr) > 0) {
                r.Error = "provider returned error: " + urlErr
            } else {
                r.Error = "no code in callback URL"
            }
            return r
        }

        // 3. Exchange the code for an access_token. POST to
        //    /token with form-encoded body. Set Accept: json so
        //    Github returns JSON (default is form-encoded).
        let form: Map<string, string> = new Map<string, string>()
        form.Set("grant_type",   "authorization_code")
        form.Set("code",         code)
        form.Set("redirect_uri", this.RedirectUri)
        form.Set("client_id",    this.ClientId)
        form.Set("client_secret", this.ClientSecret)
        if (this.UsePkce) {
            form.Set("code_verifier", verifier)
        }

        let tokenResp: HttpResponse = HttpClient.Request("POST", this.TokenUrl)
            .Header("Accept",     "application/json")
            .Header("User-Agent", "amalgame-web/0.17.0")
            .BodyForm(form)
            .Send()
        if (tokenResp.StatusCode < 200 || tokenResp.StatusCode >= 300) {
            r.Error = "token exchange failed: HTTP " + String_FromInt(tokenResp.StatusCode)
            return r
        }
        let tokenJson: string = tokenResp.BodyText
        let accessToken: string = OAuth2Client.JsonStringField(tokenJson, "access_token")
        if (String_Length(accessToken) == 0) {
            r.Error = "no access_token in token response"
            return r
        }
        r.AccessToken = accessToken
        r.TokenType   = OAuth2Client.JsonStringField(tokenJson, "token_type")
        if (String_Length(r.TokenType) == 0) { r.TokenType = "bearer" }

        // 3b. OIDC: verify the id_token BEFORE trusting anything. The
        //     id_token is the only signed assertion of identity — an
        //     access_token is opaque to us. Fail CLOSED: if OIDC is on
        //     and the id_token is missing or fails any check, the whole
        //     callback fails (we never fall through to an unverified
        //     userinfo identity).
        if (this.UseOidc) {
            let idToken: string = OAuth2Client.JsonStringField(tokenJson, "id_token")
            if (String_Length(idToken) == 0) {
                r.Error = "OIDC: no id_token in token response"
                return r
            }
            if (!this.VerifyIdToken(idToken, nonce, r)) {
                // VerifyIdToken set r.Error with the specific reason.
                return r
            }
            // id_token verified — its claims are authoritative. We can
            // skip the userinfo round-trip entirely.
            r.Ok = true
            return r
        }

        // 4. Fetch user info with the token. Both Github + Google
        //    expect Authorization: Bearer.
        if (String_Length(this.UserInfoUrl) > 0) {
            let infoResp: HttpResponse = HttpClient.Request("GET", this.UserInfoUrl)
                .Header("Authorization", "Bearer " + accessToken)
                .Header("Accept",        "application/json")
                .Header("User-Agent",    "amalgame-web/0.17.0")
                .Send()
            if (infoResp.StatusCode >= 200 && infoResp.StatusCode < 300) {
                r.UserInfo = infoResp.BodyText
                this.ExtractKnownFields(r)
            }
        }

        r.Ok = true
        return r
    }

    // ── Field extraction (provider-aware) ────────────

    private void ExtractKnownFields(r: OAuth2Result) {
        if (this.Provider == "github") {
            // Github /user response shape: { "id": 42, "login": "...", "email": "...", ... }
            r.UserId   = String_FromInt(OAuth2Client.JsonNumberField(r.UserInfo, "id"))
            r.Username = OAuth2Client.JsonStringField(r.UserInfo, "login")
            r.Email    = OAuth2Client.JsonStringField(r.UserInfo, "email")
            return
        }
        if (this.Provider == "google") {
            // Google userinfo response: { "sub": "...", "email": "...", "name": "...", ... }
            r.UserId   = OAuth2Client.JsonStringField(r.UserInfo, "sub")
            r.Email    = OAuth2Client.JsonStringField(r.UserInfo, "email")
            r.Username = OAuth2Client.JsonStringField(r.UserInfo, "name")
            return
        }
        // Custom provider — caller parses r.UserInfo themselves.
    }

    // ── OIDC id_token verification ───────────────────

    // Verify an OIDC id_token (a compact JWS). Returns true + fills the
    // identity fields of `r` only when EVERY check passes; otherwise
    // returns false with `r.Error` describing the first failure. The
    // checks, in order:
    //   1. Three base64url segments (header.payload.signature) — reject
    //      a 2-segment JWS-with-detached-payload or a 5-segment JWE.
    //   2. Header `alg` == "RS256" — HARD pin. Rejecting "none" and any
    //      HS* defeats the classic algorithm-confusion attack where an
    //      attacker re-signs with the public key as an HMAC secret.
    //   3. Signature verifies under the IdP's JWKS key for the header
    //      `kid` (built verify-only via JwsKey.FromJwkRsa).
    //   4. iss == this.Issuer (exact).
    //   5. aud contains this.ClientId (string or array form).
    //   6. exp is in the future.
    //   7. nonce == the one we minted in StartLogin (replay defence).
    private bool VerifyIdToken(idToken: string, wantNonce: string, r: OAuth2Result) {
        let jwksJson: string = this.FetchJwks()
        if (String_Length(jwksJson) == 0) {
            r.Error = "id_token: cannot fetch JWKS"
            return false
        }
        return this.VerifyAgainstJwks(idToken, jwksJson, wantNonce, r)
    }

    // Network-free OIDC verification against an already-fetched JWKS
    // document (the `{"keys":[...]}` JSON the IdP serves). Useful when
    // you cache the JWKS yourself, and the unit-testable core of the
    // flow. Returns an OAuth2Result (Ok + identity fields, or Error).
    public OAuth2Result VerifyIdTokenJwks(idToken: string, jwksJson: string, wantNonce: string) {
        let r = new OAuth2Result()
        if (this.VerifyAgainstJwks(idToken, jwksJson, wantNonce, r)) { r.Ok = true }
        return r
    }

    // The pure verifier: id_token + an in-hand JWKS JSON string → bool.
    // No network; every failure sets r.Error. See VerifyIdToken's
    // doc comment for the ordered list of checks. JSON is read with the
    // package's own flat-field scanner (no Json-stdlib dependency in the
    // facade — JWK + JWT-claim objects are flat, so it suffices).
    private bool VerifyAgainstJwks(idToken: string, jwksJson: string, wantNonce: string, r: OAuth2Result) {
        // 1. Split into 3 dot-separated segments.
        let segs: List<string> = OAuth2Client.SplitDot(idToken)
        if (segs.Count() != 3) {
            r.Error = "id_token: malformed (expected 3 segments)"
            return false
        }
        let hB64: string = segs.Get(0)
        let pB64: string = segs.Get(1)
        let sB64: string = segs.Get(2)
        if (String_Length(hB64) == 0 || String_Length(pB64) == 0 || String_Length(sB64) == 0) {
            r.Error = "id_token: empty segment"
            return false
        }

        // 2. Header → pin alg = RS256.
        let headerJson: string = Bytes.ToString(Bytes.FromBase64Url(hB64))
        let alg: string = OAuth2Client.JsonStringField(headerJson, "alg")
        if (alg != "RS256") {
            r.Error = "id_token: unsupported alg '" + alg + "' (only RS256 accepted)"
            return false
        }
        let kid: string = OAuth2Client.JsonStringField(headerJson, "kid")

        // 3. Find the JWKS key object for this kid and verify the sig.
        let jwk: string = OAuth2Client.FindJwkObject(jwksJson, kid)
        if (String_Length(jwk) == 0) {
            r.Error = "id_token: no JWKS key for kid '" + kid + "'"
            return false
        }
        if (OAuth2Client.JsonStringField(jwk, "kty") != "RSA") {
            r.Error = "id_token: JWKS key is not RSA"
            return false
        }
        let nB64: string = OAuth2Client.JsonStringField(jwk, "n")
        let eB64: string = OAuth2Client.JsonStringField(jwk, "e")
        let pub: JwsKey = JwsKey.FromJwkRsa(Bytes.FromBase64Url(nB64), Bytes.FromBase64Url(eB64))
        if (!pub.IsValid()) {
            r.Error = "id_token: malformed JWKS key"
            return false
        }
        // The JWS signing input is the ASCII "header.payload".
        let signingInput: List<int> = Bytes.FromString(hB64 + "." + pB64)
        let sig: List<int> = Bytes.FromBase64Url(sB64)
        if (!pub.Verify(signingInput, sig)) {
            r.Error = "id_token: signature invalid"
            return false
        }

        // 4–7. Claim checks on the (now trusted) payload.
        let claims: string = Bytes.ToString(Bytes.FromBase64Url(pB64))

        if (OAuth2Client.JsonStringField(claims, "iss") != this.Issuer) {
            r.Error = "id_token: issuer mismatch"
            return false
        }
        if (!OAuth2Client.AudienceContains(claims, this.ClientId)) {
            r.Error = "id_token: audience mismatch"
            return false
        }
        let exp: int = OAuth2Client.JsonNumberField(claims, "exp")
        let now: int = OAuth2Client.NowUnix()
        // 60s leeway for clock skew between us and the IdP.
        if (exp <= 0 || now >= exp + 60) {
            r.Error = "id_token: expired"
            return false
        }
        if (String_Length(wantNonce) > 0) {
            if (OAuth2Client.JsonStringField(claims, "nonce") != wantNonce) {
                r.Error = "id_token: nonce mismatch"
                return false
            }
        }

        // All checks passed — the id_token's claims are authoritative.
        r.UserInfo = claims
        r.UserId   = OAuth2Client.JsonStringField(claims, "sub")
        let cEmail: string = OAuth2Client.JsonStringField(claims, "email")
        if (String_Length(cEmail) > 0) { r.Email = cEmail }
        let cName: string = OAuth2Client.JsonStringField(claims, "name")
        if (String_Length(cName) > 0) { r.Username = cName }
        return true
    }

    // Resolve + fetch the IdP's JWKS document, returning the raw JSON
    // string (`{"keys":[...]}`). On any failure returns "". Uses the
    // explicit JwksUri when set, else OIDC discovery
    // (`{issuer}/.well-known/openid-configuration` → `jwks_uri`).
    private string FetchJwks() {
        var jwksUrl: string = this.JwksUri
        if (String_Length(jwksUrl) == 0) {
            if (String_Length(this.Issuer) == 0) { return "" }
            let discoUrl: string = this.Issuer + "/.well-known/openid-configuration"
            let dResp: HttpResponse = HttpClient.Request("GET", discoUrl)
                .Header("Accept",     "application/json")
                .Header("User-Agent", "amalgame-web/0.35.0")
                .Send()
            if (dResp.StatusCode < 200 || dResp.StatusCode >= 300) { return "" }
            jwksUrl = OAuth2Client.JsonStringField(dResp.BodyText, "jwks_uri")
        }
        if (String_Length(jwksUrl) == 0) { return "" }
        let jResp: HttpResponse = HttpClient.Request("GET", jwksUrl)
            .Header("Accept",     "application/json")
            .Header("User-Agent", "amalgame-web/0.35.0")
            .Send()
        if (jResp.StatusCode < 200 || jResp.StatusCode >= 300) { return "" }
        return jResp.BodyText
    }

    // Return the `{...}` substring of the first JWK in the set whose
    // "kid" matches. JWK objects are flat (no nested braces), so the
    // nearest enclosing braces bound exactly one key. When `kid` is
    // empty (header carried none) the whole document is returned only
    // if it holds a single key — otherwise "" (ambiguous, reject).
    private static string FindJwkObject(jwksJson: string, kid: string) {
        if (String_Length(kid) > 0) {
            let marker: string = "\"kid\":\"" + kid + "\""
            let kpos: int = String_IndexOf(jwksJson, marker)
            if (kpos < 0) { return "" }
            // Walk back to the enclosing '{' and forward to its '}'.
            var start: int = kpos
            while (start >= 0 && String_Substring(jwksJson, start, 1) != "{") {
                start = start - 1
            }
            var end: int = kpos
            let n: int = String_Length(jwksJson)
            while (end < n && String_Substring(jwksJson, end, 1) != "}") {
                end = end + 1
            }
            if (start < 0 || end >= n) { return "" }
            return String_Substring(jwksJson, start, end - start + 1)
        }
        // No kid: accept only an unambiguous single-key set. A second
        // "kty" occurrence means 2+ keys — reject rather than guess.
        let first: int = String_IndexOf(jwksJson, "\"kty\"")
        if (first < 0) { return "" }
        let rest: string = String_Substring(jwksJson, first + 5, String_Length(jwksJson) - (first + 5))
        if (String_IndexOf(rest, "\"kty\"") >= 0) { return "" }
        return jwksJson
    }

    // True if the `aud` claim contains `clientId` — whether it is a
    // bare string ("aud":"x") or a JSON array ("aud":["x","y"]).
    private static bool AudienceContains(claims: string, clientId: string) {
        let audStr: string = OAuth2Client.JsonStringField(claims, "aud")
        if (String_Length(audStr) > 0) { return audStr == clientId }
        // Array form: isolate the "aud":[ ... ] span and look for the
        // quoted client id inside it.
        let ai: int = String_IndexOf(claims, "\"aud\"")
        if (ai < 0) { return false }
        let tail: string = String_Substring(claims, ai, String_Length(claims) - ai)
        let lb: int = String_IndexOf(tail, "[")
        let rb: int = String_IndexOf(tail, "]")
        if (lb < 0 || rb <= lb) { return false }
        let arr: string = String_Substring(tail, lb, rb - lb + 1)
        return String_IndexOf(arr, "\"" + clientId + "\"") >= 0
    }

    // Current Unix time (seconds). OIDC `exp` is seconds since epoch.
    private static int NowUnix() {
        var t: int = 0
        @c { t = (int64_t) time(NULL); }
        return t
    }

    // Split on '.' into segments (for the compact JWS form).
    private static List<string> SplitDot(s: string) {
        return OAuth2Client.SplitOn(s, ".")
    }
    // Split on '~' into fields (state cookie layout).
    private static List<string> SplitTilde(s: string) {
        return OAuth2Client.SplitOn(s, "~")
    }
    private static List<string> SplitOn(s: string, sep: string) {
        let out: List<string> = new List<string>()
        var cur: string = s
        var idx: int = String_IndexOf(cur, sep)
        while (idx >= 0) {
            out.Add(String_Substring(cur, 0, idx))
            cur = String_Substring(cur, idx + 1, String_Length(cur) - (idx + 1))
            idx = String_IndexOf(cur, sep)
        }
        out.Add(cur)
        return out
    }

    // ── helpers (URL / cookie / minimal JSON scanner) ─

    // PKCE S256 code_challenge = base64url( SHA-256( code_verifier ) ),
    // no padding (RFC 7636 §4.2). Built from amalgame-crypto primitives.
    // Public for direct testing against the RFC 7636 Appendix B vector.
    public static string PkceChallenge(verifier: string) {
        let vbytes: List<int> = Bytes.FromString(verifier)
        let hex: string = Sha256.Hex(vbytes)
        let dig: List<int> = Bytes.FromHex(hex)
        return Bytes.ToBase64Url(dig)
    }

    private static string RandomState(nBytes: int) {
        var out: string = ""
        @c {
            unsigned char buf[64];
            if (nBytes > 64) nBytes = 64;
            if (nBytes <  8) nBytes =  8;
            /* Fill from /dev/urandom — block-free, kernel-blessed. */
            int fd = open("/dev/urandom", O_RDONLY);
            ssize_t r = (fd >= 0) ? read(fd, buf, (size_t) nBytes) : -1;
            if (fd >= 0) close(fd);
            if (r != (ssize_t) nBytes) {
                /* Fallback — rand() seeded by time(). Worse but
                 * non-zero. State only needs to be unguessable
                 * across the 5-minute window we keep the cookie. */
                static int seeded = 0;
                if (!seeded) { srand((unsigned) time(NULL) ^ (unsigned) getpid()); seeded = 1; }
                for (int i = 0; i < nBytes; i++) buf[i] = (unsigned char) rand();
            }
            /* base64url encode without padding. */
            static const char b64[] =
                "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
            char* enc = (char*) GC_MALLOC((nBytes * 4 / 3) + 4);
            int oi = 0;
            for (int i = 0; i < nBytes; i += 3) {
                unsigned a = buf[i];
                unsigned b = (i + 1 < nBytes) ? buf[i + 1] : 0;
                unsigned c = (i + 2 < nBytes) ? buf[i + 2] : 0;
                enc[oi++] = b64[(a >> 2) & 0x3F];
                enc[oi++] = b64[((a << 4) | (b >> 4)) & 0x3F];
                if (i + 1 < nBytes) enc[oi++] = b64[((b << 2) | (c >> 6)) & 0x3F];
                if (i + 2 < nBytes) enc[oi++] = b64[c & 0x3F];
            }
            enc[oi] = 0;
            out = enc;
        }
        return out
    }

    private static string UrlEncode(s: string) {
        var out: string = ""
        @c {
            if (!s) s = "";
            size_t len = strlen(s);
            char* buf = (char*) GC_MALLOC(len * 3 + 1);
            size_t oi = 0;
            static const char hex[] = "0123456789ABCDEF";
            for (size_t i = 0; i < len; i++) {
                unsigned char ch = (unsigned char) s[i];
                if ((ch >= 'A' && ch <= 'Z') ||
                    (ch >= 'a' && ch <= 'z') ||
                    (ch >= '0' && ch <= '9') ||
                    ch == '-' || ch == '_' || ch == '.' || ch == '~') {
                    buf[oi++] = (char) ch;
                } else {
                    buf[oi++] = '%';
                    buf[oi++] = hex[(ch >> 4) & 0xF];
                    buf[oi++] = hex[ch & 0xF];
                }
            }
            buf[oi] = 0;
            out = buf;
        }
        return out
    }

    private static string JoinSpace(xs: List<string>) {
        var out: string = ""
        let n: int = xs.Count()
        for i in 0..n {
            if (i > 0) { out = out + " " }
            out = out + xs.Get(i)
        }
        return out
    }

    // Pull a query-string value out of a raw `/path?a=b&c=d` target.
    private static string QueryValue(target: string, name: string) {
        if (target == null) { return "" }
        let qpos: int = String_IndexOf(target, "?")
        if (qpos < 0) { return "" }
        let qs: string = String_Substring(target, qpos + 1, String_Length(target) - qpos - 1)
        let pairs: List<string> = String_Split(qs, "&")
        let n: int = pairs.Count()
        for i in 0..n {
            let p: string = pairs.Get(i)
            let eq: int = String_IndexOf(p, "=")
            if (eq < 0) { continue }
            let k: string = String_Substring(p, 0, eq)
            if (k != name) { continue }
            let v: string = String_Substring(p, eq + 1, String_Length(p) - eq - 1)
            return OAuth2Client.UrlDecode(v)
        }
        return ""
    }

    // Pull a cookie value out of a `Cookie:` header line:
    //   name=value; other=other; ...
    private static string CookieValue(cookieHeader: string, name: string) {
        if (cookieHeader == null) { return "" }
        let pairs: List<string> = String_Split(cookieHeader, ";")
        let n: int = pairs.Count()
        for i in 0..n {
            let p: string = String_Trim(pairs.Get(i))
            let eq: int = String_IndexOf(p, "=")
            if (eq < 0) { continue }
            let k: string = String_Substring(p, 0, eq)
            if (k != name) { continue }
            return String_Substring(p, eq + 1, String_Length(p) - eq - 1)
        }
        return ""
    }

    private static string UrlDecode(s: string) {
        var out: string = ""
        @c {
            if (!s) s = "";
            size_t len = strlen(s);
            char* buf = (char*) GC_MALLOC(len + 1);
            size_t oi = 0;
            for (size_t i = 0; i < len; i++) {
                unsigned char ch = (unsigned char) s[i];
                if (ch == '+') { buf[oi++] = ' '; continue; }
                if (ch == '%' && i + 2 < len) {
                    int hi = -1, lo = -1;
                    char h = s[i + 1], l = s[i + 2];
                    if (h >= '0' && h <= '9') hi = h - '0';
                    else if (h >= 'a' && h <= 'f') hi = h - 'a' + 10;
                    else if (h >= 'A' && h <= 'F') hi = h - 'A' + 10;
                    if (l >= '0' && l <= '9') lo = l - '0';
                    else if (l >= 'a' && l <= 'f') lo = l - 'a' + 10;
                    else if (l >= 'A' && l <= 'F') lo = l - 'A' + 10;
                    if (hi >= 0 && lo >= 0) {
                        buf[oi++] = (char)((hi << 4) | lo);
                        i += 2;
                        continue;
                    }
                }
                buf[oi++] = (char) ch;
            }
            buf[oi] = 0;
            out = buf;
        }
        return out
    }

    // Top-level JSON string field extractor. Same approach as
    // JwtAuth — tolerates whitespace + simple escapes. Returns ""
    // when missing or malformed.
    private static string JsonStringField(s: string, name: string) {
        let needle: string = "\"" + name + "\""
        let pos: int = String_IndexOf(s, needle)
        if (pos < 0) { return "" }
        var i: int = pos + String_Length(needle)
        let n: int = String_Length(s)
        while (i < n) {
            let ch: string = String_Substring(s, i, 1)
            if (ch == " " || ch == "\t" || ch == "\n" || ch == "\r" || ch == ":") {
                i = i + 1; continue
            }
            if (ch == "\"") { i = i + 1; break }
            return ""
        }
        var out: string = ""
        var escaping: bool = false
        while (i < n) {
            let ch: string = String_Substring(s, i, 1)
            if (escaping) {
                if (ch == "n") { out = out + "\n" }
                else if (ch == "t") { out = out + "\t" }
                else if (ch == "r") { out = out + "\r" }
                else { out = out + ch }
                escaping = false
                i = i + 1; continue
            }
            if (ch == "\\") { escaping = true; i = i + 1; continue }
            if (ch == "\"") { return out }
            out = out + ch
            i = i + 1
        }
        return ""
    }

    private static int JsonNumberField(s: string, name: string) {
        let needle: string = "\"" + name + "\""
        let pos: int = String_IndexOf(s, needle)
        if (pos < 0) { return 0 }
        var i: int = pos + String_Length(needle)
        let n: int = String_Length(s)
        while (i < n) {
            let ch: string = String_Substring(s, i, 1)
            if (ch == " " || ch == "\t" || ch == "\n" || ch == "\r" || ch == ":") {
                i = i + 1; continue
            }
            break
        }
        var sign: int = 1
        if (i < n && String_Substring(s, i, 1) == "-") { sign = -1; i = i + 1 }
        var v: int = 0
        var any: bool = false
        while (i < n) {
            let ch: string = String_Substring(s, i, 1)
            if (ch == "0") { v = v * 10 + 0 }
            else if (ch == "1") { v = v * 10 + 1 }
            else if (ch == "2") { v = v * 10 + 2 }
            else if (ch == "3") { v = v * 10 + 3 }
            else if (ch == "4") { v = v * 10 + 4 }
            else if (ch == "5") { v = v * 10 + 5 }
            else if (ch == "6") { v = v * 10 + 6 }
            else if (ch == "7") { v = v * 10 + 7 }
            else if (ch == "8") { v = v * 10 + 8 }
            else if (ch == "9") { v = v * 10 + 9 }
            else { break }
            any = true
            i = i + 1
        }
        if (!any) { return 0 }
        return v * sign
    }
}

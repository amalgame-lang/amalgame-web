// amalgame-web — Mosaic web framework, v0.1 foundation.
//
// What's IN v0.1:
//   - Router         pattern matching with `:param` and `*splat`
//   - Route          a (method, path, handler-name) tuple
//   - RouteMatch     match result with extracted path params
//   - Session        in-memory key/value store with TTL
//   - MemorySessionStore  thread-unsafe in-memory store (dev/test)
//   - WebContext     per-request bag: path params, state, session id
//
// What's IN v0.4:
//   - SecurityHeaders — CSP / HSTS / X-Frame-Options / nosniff /
//                       Referrer-Policy / Permissions-Policy / COOP / COEP.
//                       Builder + Apply(resp). Presets StrictHtml / StrictApi.
//
// What's NOT YET (deferred):
//   - WebApp.Get/Post/Use(handler) — needs middleware pipeline
//   - Filesystem-based routing      — Mosaic build tool concern
//   - DEV mode (file watcher + hot dlopen)
//   - ACME / TLS integration
//   - JsonFileSessionStore, RedisSessionStore
//   - CSRF, CORS, rate limit middlewares
//   - Reverse proxy
//
// v0.1 user pattern (manual dispatch using net-http directly):
//
//   import Amalgame.Net.Http
//   import Amalgame.Web
//
//   let router = new Router()
//   router.Add("GET",  "/",           "home")
//   router.Add("GET",  "/users/:id",  "user_show")
//   router.Add("POST", "/users",      "user_create")
//
//   let srv = TcpServer_Listen(3000, 16)
//   while (TcpServer_IsListening(srv)) {
//       let conn = TcpServer_Accept(srv)
//       let raw  = TcpConn_Receive(conn, 65536)
//       let req  = HttpParser.ParseFull(raw)
//       if (req == null) {
//           TcpConn_Send(conn, HttpServer.BadRequestResponse())
//           TcpConn_Close(conn)
//           continue
//       }
//       let m = router.Match(req.Method, req.Path)
//       var resp = new HttpResponse()
//       if (m == null) {
//           resp = HttpResponse.New().Status(404).Text("Not found")
//       } else if (m.HandlerName == "home") {
//           resp = HttpResponse.New().Text("Welcome")
//       } else if (m.HandlerName == "user_show") {
//           let id = m.Params.Get("id")
//           resp = HttpResponse.New().Text("User " + id)
//       } else if (m.HandlerName == "user_create") {
//           resp = HttpResponse.New().Status(201).Json("{\"ok\":true}")
//       }
//       TcpConn_Send(conn, resp.Render())
//       TcpConn_Close(conn)
//   }
//   TcpServer_Close(srv)
//
// The `m.HandlerName` indirection is the manual-dispatch v0.1 cost
// for not having first-class functions. v0.1.x will replace it with
// a real handler-fn registry.

namespace Amalgame.Web

import Amalgame.Collections
import Amalgame.String
import Amalgame.DateTime
import Amalgame.Random

// ─────────────────────────────────────────────────────────────────
// Route — one registered route.
// ─────────────────────────────────────────────────────────────────

public class Route {
    public Method:      string                  // "GET" / "POST" / ...
    public Path:        string                  // "/users/:id"
    public Handler:     Closure<WebContext, HttpResponse>   // amc v0.8.35+ typed closure
    public Segments:    List<string>            // pre-split: ["users", ":id"]
    public ParamNames:  List<string>            // [":id" → "id"], for fast match

    public Route(string method, string path, Closure<WebContext, HttpResponse> handler) {
        this.Method     = method
        this.Path       = path
        this.Handler    = handler
        this.Segments   = Route.SplitPath(path)
        this.ParamNames = new List<string>()
        let sn: int = this.Segments.Count()
        for i in 0..sn {
            let seg: string = this.Segments.Get(i)
            if (String_StartsWith(seg, ":")) {
                let n: int = String_Length(seg)
                this.ParamNames.Add(String_Substring(seg, 1, n - 1))
            } else if (String_StartsWith(seg, "*")) {
                let n: int = String_Length(seg)
                this.ParamNames.Add(String_Substring(seg, 1, n - 1))
            } else {
                this.ParamNames.Add("")
            }
        }
    }

    // Handler is typed as `Closure<WebContext, HttpResponse>` (amc
    // v0.8.35+). `route.Handler(ctx)` lowers to a typed call that
    // returns `HttpResponse*` directly — no `i64` round-trip, no
    // `-Wno-int-conversion` needed at the consumer side:
    //
    //   let resp: HttpResponse = route.Handler(ctx)   // proper pointer

    // Split "/users/:id/posts" into ["users", ":id", "posts"].
    // Empty path or "/" → empty list. Leading slash stripped.
    public static List<string> SplitPath(string path) {
        let parts: List<string> = new List<string>()
        let n: int = String_Length(path)
        if (n == 0) { return parts }
        var start: int = 0
        if (String_StartsWith(path, "/")) { start = 1 }
        var i: int = start
        var segStart: int = start
        while (i < n) {
            let c: string = String_CharAt1(path, i)
            if (c == "/") {
                if (i > segStart) {
                    parts.Add(String_Substring(path, segStart, i - segStart))
                }
                segStart = i + 1
            }
            i = i + 1
        }
        if (n > segStart) {
            parts.Add(String_Substring(path, segStart, n - segStart))
        }
        return parts
    }
}

// ─────────────────────────────────────────────────────────────────
// RouteMatch — successful match result.
// ─────────────────────────────────────────────────────────────────

public class RouteMatch {
    public Route:   Route                       // the matched route (carries the handler)
    public Params:  Map<string, string>         // ":id" → "42"

    public RouteMatch(Route r) {
        this.Route  = r
        this.Params = new Map<string, string>()
    }
}

// ─────────────────────────────────────────────────────────────────
// Router — collection of routes + matching engine.
//
// Matching rules:
//   - Literal segments: must match exactly.
//   - `:name` segment:  matches any single segment, captured as `name`.
//   - `*name` segment:  catch-all, matches remaining path, captured as `name`.
//   - Method comparison: exact, case-sensitive (uppercase convention).
//   - First-match-wins (registration order). Static routes should
//     therefore be registered BEFORE parameterized ones.
// ─────────────────────────────────────────────────────────────────

public class Router {
    public Routes: List<Route>

    public Router() {
        this.Routes = new List<Route>()
    }

    // Register a route. The handler is a closure taking a single
    // WebContext arg and returning whatever the framework should
    // ship back (typically an HttpResponse from amalgame-net-http).
    // Returns the router for chaining.
    public Router Add(string method, string path, Closure<WebContext, HttpResponse> handler) {
        this.Routes.Add(new Route(method, path, handler))
        return this
    }

    public Router Get(string path, Closure<WebContext, HttpResponse> handler)    { return this.Add("GET", path, handler) }
    public Router Post(string path, Closure<WebContext, HttpResponse> handler)   { return this.Add("POST", path, handler) }
    public Router Put(string path, Closure<WebContext, HttpResponse> handler)    { return this.Add("PUT", path, handler) }
    public Router Patch(string path, Closure<WebContext, HttpResponse> handler)  { return this.Add("PATCH", path, handler) }
    public Router Delete(string path, Closure<WebContext, HttpResponse> handler) { return this.Add("DELETE", path, handler) }

    // Match (method, path) against registered routes. Returns null if
    // no route matches, else a RouteMatch with extracted params.
    public RouteMatch Match(string method, string path) {
        let reqSegs: List<string> = Route.SplitPath(path)
        let rn: int = this.Routes.Count()
        for ri in 0..rn {
            let r: Route = this.Routes.Get(ri)
            if (r.Method != method) { continue }
            let m: RouteMatch = Router.TryMatchOne(r, reqSegs)
            if (m != null) { return m }
        }
        return null
    }

    // Internal — try to match one route against the request segments.
    private static RouteMatch TryMatchOne(Route r, List<string> reqSegs) {
        let rsn: int = r.Segments.Count()
        let qsn: int = reqSegs.Count()
        let m = new RouteMatch(r)
        var i: int = 0
        while (i < rsn) {
            let routeSeg: string = r.Segments.Get(i)
            if (String_StartsWith(routeSeg, "*")) {
                // Catch-all: consume everything from here.
                let paramName: string = r.ParamNames.Get(i)
                var rest: string = ""
                var j: int = i
                while (j < qsn) {
                    if (j > i) { rest = rest + "/" }
                    rest = rest + reqSegs.Get(j)
                    j = j + 1
                }
                m.Params.Set(paramName, rest)
                return m
            }
            if (i >= qsn) { return null }     // route longer than request
            let qSeg: string = reqSegs.Get(i)
            if (String_StartsWith(routeSeg, ":")) {
                let paramName: string = r.ParamNames.Get(i)
                m.Params.Set(paramName, qSeg)
            } else if (routeSeg != qSeg) {
                return null
            }
            i = i + 1
        }
        if (i != qsn) { return null }         // request longer than route
        return m
    }
}

// ─────────────────────────────────────────────────────────────────
// Session — in-memory key/value store carried by a session cookie.
//
// Values are typed as string for v0.1 (JSON-encodable). v0.1.x will
// add typed accessors once we generalize JsonValue storage.
// ─────────────────────────────────────────────────────────────────

public class Session {
    public Id:        string
    public Data:      Map<string, string>
    public CreatedAt: int                       // Unix epoch seconds
    public TouchedAt: int                       // updated on Get/Set
    public MaxAgeSec: int

    public Session(string id) {
        this.Id        = id
        this.Data      = new Map<string, string>()
        this.CreatedAt = 0
        this.TouchedAt = 0
        this.MaxAgeSec = 86400
    }

    public string Get(string key) {
        if (this.Data.Has(key)) { return this.Data.Get(key) }
        return ""
    }
    public void Set(string key, string value) { this.Data.Set(key, value) }
    public void Delete(string key) { this.Data.Remove(key) }
    public void Clear() { this.Data = new Map<string, string>() }
    public bool Has(string key) { return this.Data.Has(key) }
}

// ─────────────────────────────────────────────────────────────────
// MemorySessionStore — thread-unsafe in-process session storage.
// Suitable for development and tests. Production deployments should
// use JsonFileSessionStore (v0.1.x) or RedisSessionStore (v0.7).
// ─────────────────────────────────────────────────────────────────

public class MemorySessionStore {
    public Sessions: Map<string, Session>

    public MemorySessionStore() {
        this.Sessions = new Map<string, Session>()
    }

    // Find a session by id, or null.
    public Session Find(string id) {
        if (this.Sessions.Has(id)) { return this.Sessions.Get(id) }
        return null
    }

    // Create + register a new session with a caller-provided id.
    // Use Router-generated tokens (256-bit random) for prod; tests
    // can pass predictable ids.
    public Session Create(string id) {
        let s = new Session(id)
        this.Sessions.Set(id, s)
        return s
    }

    // Remove a session.
    public void Destroy(string id) {
        this.Sessions.Remove(id)
    }

    public int Size() { return this.Sessions.Size() }
}

// ─────────────────────────────────────────────────────────────────
// WebContext — per-request "bag" of conveniences.
//
// In v0.1.x this becomes the canonical handler argument. For v0.1,
// it's a standalone value the user can populate manually.
// ─────────────────────────────────────────────────────────────────

public class WebContext {
    public Params:    Map<string, string>     // path params from RouteMatch
    public State:     Map<string, string>     // app-level shared state (string-typed v0.1)
    public Session:   Session                 // null if no session
    public RequestId: string

    public WebContext() {
        this.Params    = new Map<string, string>()
        this.State     = new Map<string, string>()
        this.Session   = null
        this.RequestId = ""
    }

    public string Param(string name) {
        if (this.Params.Has(name)) { return this.Params.Get(name) }
        return ""
    }

    public string StateOf(string name) {
        if (this.State.Has(name)) { return this.State.Get(name) }
        return ""
    }
}

// ─────────────────────────────────────────────────────────────────
// SecurityHeaders — response-side hardening (v0.4.0).
//
// Builder + `Apply(resp)` that stamps the standard browser-side
// security headers onto an HttpResponse:
//
//   Strict-Transport-Security    (HSTS — opt in via WithHsts)
//   Content-Security-Policy      (CSP)
//   X-Frame-Options              (clickjacking — superseded by CSP frame-ancestors but still respected)
//   X-Content-Type-Options       (MIME sniffing — always "nosniff")
//   Referrer-Policy
//   Permissions-Policy           (formerly Feature-Policy)
//   Cross-Origin-Opener-Policy   (COOP — needed for SharedArrayBuffer)
//   Cross-Origin-Embedder-Policy (COEP — needed for SharedArrayBuffer)
//
// Defaults are *off*: an empty `SecurityHeaders()` adds no headers.
// Use one of the presets — `SecurityHeaders.StrictHtml()` for HTML
// pages, `SecurityHeaders.StrictApi()` for JSON APIs — or compose
// your own with the `With...` builders.
//
// Apply NEVER overwrites a header the handler already set; the
// handler wins (defense-in-depth, but predictable).
//
// HSTS is the one preset-omitted header: stamping a 1-year HSTS
// on a response that's then served over HTTP can lock users out
// of the site. Always opt in explicitly *and only when serving
// HTTPS* via WithHsts(maxAge, includeSubdomains, preload).
//
// Usage:
//
//     let sec = SecurityHeaders.StrictHtml()
//         .WithHsts(31536000, true, false)
//     // ... in dispatch loop, after handler:
//     let resp = match.Route.Handler(ctx)
//     sec.Apply(resp)
//     TcpConn_Send(conn, resp.Render())
// ─────────────────────────────────────────────────────────────────

public class SecurityHeaders {
    public Hsts:                 string  // "" = don't emit; else full value, e.g. "max-age=31536000"
    public ContentSecurityPolicy: string
    public FrameOptions:         string  // "DENY" | "SAMEORIGIN" | ""
    public ContentTypeOptions:   bool    // true → "X-Content-Type-Options: nosniff"
    public ReferrerPolicy:       string
    public PermissionsPolicy:    string
    public Coop:                 string
    public Coep:                 string

    public SecurityHeaders() {
        this.Hsts                  = ""
        this.ContentSecurityPolicy = ""
        this.FrameOptions          = ""
        this.ContentTypeOptions    = false
        this.ReferrerPolicy        = ""
        this.PermissionsPolicy     = ""
        this.Coop                  = ""
        this.Coep                  = ""
    }

    // Strict preset for HTML responses. CSP locks scripts/styles to
    // 'self', forbids framing entirely, denies microphone/camera/geo
    // by default. HSTS NOT included — set it via WithHsts() once you
    // know all subdomains can speak HTTPS.
    public static SecurityHeaders StrictHtml() {
        let h = new SecurityHeaders()
        h.ContentSecurityPolicy = "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        h.FrameOptions          = "DENY"
        h.ContentTypeOptions    = true
        h.ReferrerPolicy        = "strict-origin-when-cross-origin"
        h.PermissionsPolicy     = "camera=(), microphone=(), geolocation=()"
        return h
    }

    // Strict preset for JSON APIs — no CSP (no HTML rendered), but
    // still nosniff + Referrer-Policy: no-referrer, FrameOptions DENY
    // (catches browser-fetched responses).
    public static SecurityHeaders StrictApi() {
        let h = new SecurityHeaders()
        h.FrameOptions       = "DENY"
        h.ContentTypeOptions = true
        h.ReferrerPolicy     = "no-referrer"
        return h
    }

    // HSTS — opt-in. Pass maxAgeSec=0 to clear an existing pin (per RFC 6797).
    public SecurityHeaders WithHsts(int maxAgeSec, bool includeSubdomains, bool preload) {
        var v: string = "max-age=" + String_FromInt(maxAgeSec)
        if (includeSubdomains) { v = v + "; includeSubDomains" }
        if (preload)           { v = v + "; preload" }
        this.Hsts = v
        return this
    }

    public SecurityHeaders WithCsp(string policy)              { this.ContentSecurityPolicy = policy;  return this }
    public SecurityHeaders WithoutCsp()                        { this.ContentSecurityPolicy = "";      return this }
    public SecurityHeaders WithFrameOptions(string value)      { this.FrameOptions = value;            return this }
    public SecurityHeaders WithContentTypeOptions(bool on)     { this.ContentTypeOptions = on;         return this }
    public SecurityHeaders WithReferrerPolicy(string value)    { this.ReferrerPolicy = value;          return this }
    public SecurityHeaders WithPermissionsPolicy(string value) { this.PermissionsPolicy = value;       return this }
    public SecurityHeaders WithCoop(string value)              { this.Coop = value;                    return this }
    public SecurityHeaders WithCoep(string value)              { this.Coep = value;                    return this }

    // Build a SecurityHeaders from a flat key/value map — designed for
    // config-file driven instantiation. The Mosaic CLI flattens its
    // TOML `[security.headers]` table to this shape and calls FromMap.
    // The library itself stays TOML-agnostic.
    //
    // Recognised keys (all optional):
    //   preset                       "strict_html" | "strict_api"
    //                                Starts from that preset; further
    //                                keys then override individual
    //                                fields. Without a preset, defaults
    //                                are all-off.
    //   csp                          full CSP policy string
    //   frame_options                "DENY" | "SAMEORIGIN"
    //   content_type_options         "true" | "false" — toggles nosniff
    //   referrer_policy              e.g. "no-referrer"
    //   permissions_policy           e.g. "camera=(), microphone=()"
    //   coop                         e.g. "same-origin"
    //   coep                         e.g. "require-corp"
    //   hsts                         pre-composed value, OR ↓
    //   hsts_max_age                 seconds (int as string)
    //   hsts_include_subdomains      "true" | "false"
    //   hsts_preload                 "true" | "false"
    //
    // Unknown keys are ignored (forward-compat with future fields).
    public static SecurityHeaders FromMap(Map<string, string> cfg) {
        var h: SecurityHeaders = new SecurityHeaders()
        if (cfg.Has("preset")) {
            let p: string = cfg.Get("preset")
            if (p == "strict_html") { h = SecurityHeaders.StrictHtml() }
            else if (p == "strict_api") { h = SecurityHeaders.StrictApi() }
        }
        if (cfg.Has("csp"))                  { h.ContentSecurityPolicy = cfg.Get("csp") }
        if (cfg.Has("frame_options"))        { h.FrameOptions          = cfg.Get("frame_options") }
        if (cfg.Has("content_type_options")) { h.ContentTypeOptions    = (cfg.Get("content_type_options") == "true") }
        if (cfg.Has("referrer_policy"))      { h.ReferrerPolicy        = cfg.Get("referrer_policy") }
        if (cfg.Has("permissions_policy"))   { h.PermissionsPolicy     = cfg.Get("permissions_policy") }
        if (cfg.Has("coop"))                 { h.Coop                  = cfg.Get("coop") }
        if (cfg.Has("coep"))                 { h.Coep                  = cfg.Get("coep") }
        // HSTS — accept either pre-composed `hsts=...` or
        // (`hsts_max_age` + optional flags).
        if (cfg.Has("hsts")) {
            h.Hsts = cfg.Get("hsts")
        } else if (cfg.Has("hsts_max_age")) {
            let maxAge: int = String_ToInt(cfg.Get("hsts_max_age"))
            let inclSub: bool = cfg.Has("hsts_include_subdomains") && cfg.Get("hsts_include_subdomains") == "true"
            let preload: bool = cfg.Has("hsts_preload") && cfg.Get("hsts_preload") == "true"
            h.WithHsts(maxAge, inclSub, preload)
        }
        return h
    }

    // Stamp the configured headers onto `resp`. Skips empty fields
    // and headers the handler already set (handler wins). Returns
    // `resp` for chaining.
    public HttpResponse Apply(HttpResponse resp) {
        if (this.Hsts != "" && !resp.Headers.Has("Strict-Transport-Security")) {
            resp.Header("Strict-Transport-Security", this.Hsts)
        }
        if (this.ContentSecurityPolicy != "" && !resp.Headers.Has("Content-Security-Policy")) {
            resp.Header("Content-Security-Policy", this.ContentSecurityPolicy)
        }
        if (this.FrameOptions != "" && !resp.Headers.Has("X-Frame-Options")) {
            resp.Header("X-Frame-Options", this.FrameOptions)
        }
        if (this.ContentTypeOptions && !resp.Headers.Has("X-Content-Type-Options")) {
            resp.Header("X-Content-Type-Options", "nosniff")
        }
        if (this.ReferrerPolicy != "" && !resp.Headers.Has("Referrer-Policy")) {
            resp.Header("Referrer-Policy", this.ReferrerPolicy)
        }
        if (this.PermissionsPolicy != "" && !resp.Headers.Has("Permissions-Policy")) {
            resp.Header("Permissions-Policy", this.PermissionsPolicy)
        }
        if (this.Coop != "" && !resp.Headers.Has("Cross-Origin-Opener-Policy")) {
            resp.Header("Cross-Origin-Opener-Policy", this.Coop)
        }
        if (this.Coep != "" && !resp.Headers.Has("Cross-Origin-Embedder-Policy")) {
            resp.Header("Cross-Origin-Embedder-Policy", this.Coep)
        }
        return resp
    }
}

// ─────────────────────────────────────────────────────────────────
// Cors — Cross-Origin Resource Sharing (v0.5.0).
//
// Builder + two entry points:
//
//   cors.Preflight(req)   — if `req` is a CORS preflight (OPTIONS +
//                           Access-Control-Request-Method), returns
//                           a 204 response with the appropriate
//                           Access-Control-* headers. Else returns null
//                           and the caller proceeds to normal dispatch.
//
//   cors.Apply(req, resp) — for non-preflight cross-origin requests,
//                           stamps Access-Control-Allow-Origin /
//                           Allow-Credentials / Expose-Headers onto
//                           the existing response. Same handler-wins
//                           policy as SecurityHeaders.
//
// Vary: Origin is always added so HTTP caches don't cross-serve.
//
// Wildcard origin (`["*"]`) is incompatible with credentials per
// the spec — if AllowCredentials is true, the configured allowed
// origins MUST be explicit (the wildcard echo is suppressed).
//
// Defaults: every list empty → no CORS at all (a response to a
// cross-origin request still ships, but without the headers the
// browser needs to expose it). Use a preset (`AllowAll` / `Strict`)
// or compose your own allowlist.
//
// Example:
//
//     let cors = Cors.Strict()
//         .WithAllowedOrigins(["https://app.example.com"])
//         .WithAllowCredentials(true)
//
//     // in dispatch:
//     let pf: HttpResponse = cors.Preflight(req)
//     if (pf != null) {
//         TcpConn_Send(conn, pf.Render())
//         continue
//     }
//     let resp = route.Handler(ctx)
//     cors.Apply(req, resp)
//     TcpConn_Send(conn, resp.Render())
// ─────────────────────────────────────────────────────────────────

public class Cors {
    public AllowedOrigins:   List<string>      // exact origins, or ["*"]
    public AllowedMethods:   List<string>
    public AllowedHeaders:   List<string>
    public ExposedHeaders:   List<string>
    public AllowCredentials: bool
    public MaxAgeSec:        int

    public Cors() {
        this.AllowedOrigins   = new List<string>()
        this.AllowedMethods   = new List<string>()
        this.AllowedHeaders   = new List<string>()
        this.ExposedHeaders   = new List<string>()
        this.AllowCredentials = false
        this.MaxAgeSec        = 0
    }

    // No-op preset. An empty-origin Cors stamps nothing — useful as
    // a base when you'll fill the lists by hand.
    public static Cors Disabled() { return new Cors() }

    // Open CORS: any origin, common methods + headers, no credentials.
    // For dev / public APIs only.
    public static Cors AllowAll() {
        let c = new Cors()
        c.AllowedOrigins.Add("*")
        c.AllowedMethods.Add("GET")
        c.AllowedMethods.Add("POST")
        c.AllowedMethods.Add("PUT")
        c.AllowedMethods.Add("PATCH")
        c.AllowedMethods.Add("DELETE")
        c.AllowedMethods.Add("OPTIONS")
        c.AllowedHeaders.Add("Content-Type")
        c.AllowedHeaders.Add("Authorization")
        c.MaxAgeSec = 86400
        return c
    }

    // Restrictive baseline: no origins configured (caller adds them),
    // common safe methods + headers, no credentials, 1-day preflight
    // cache. Pair with WithAllowedOrigins(...).
    public static Cors Strict() {
        let c = new Cors()
        c.AllowedMethods.Add("GET")
        c.AllowedMethods.Add("POST")
        c.AllowedHeaders.Add("Content-Type")
        c.MaxAgeSec = 86400
        return c
    }

    // ── Builders ───────────────────────────────────────
    public Cors WithAllowedOrigins(List<string> origins) { this.AllowedOrigins = origins;   return this }
    public Cors WithAllowedMethods(List<string> methods) { this.AllowedMethods = methods;   return this }
    public Cors WithAllowedHeaders(List<string> headers) { this.AllowedHeaders = headers;   return this }
    public Cors WithExposedHeaders(List<string> headers) { this.ExposedHeaders = headers;   return this }
    public Cors WithAllowCredentials(bool b)             { this.AllowCredentials = b;       return this }
    public Cors WithMaxAge(int seconds)                  { this.MaxAgeSec = seconds;        return this }
    public Cors AddOrigin(string origin)                 { this.AllowedOrigins.Add(origin); return this }
    public Cors AddMethod(string method)                 { this.AllowedMethods.Add(method); return this }

    // ── Origin matching ────────────────────────────────
    // True if `origin` is in the allow list OR the list is wildcard.
    public bool OriginAllowed(string origin) {
        if (origin == "") { return false }
        let n: int = this.AllowedOrigins.Count()
        for i in 0..n {
            let allowed: string = this.AllowedOrigins.Get(i)
            if (allowed == "*") { return true }
            if (allowed == origin) { return true }
        }
        return false
    }

    // What to put in Access-Control-Allow-Origin. Wildcard is forbidden
    // when credentials are allowed; in that case we echo the specific
    // origin (which has been validated by OriginAllowed).
    private string OriginEcho(string origin) {
        if (this.AllowCredentials) { return origin }
        if (this.AllowedOrigins.Count() == 1 && this.AllowedOrigins.Get(0) == "*") {
            return "*"
        }
        return origin
    }

    // ── Preflight ──────────────────────────────────────
    // Returns a 204 response with CORS headers if `req` is a CORS
    // preflight that matches. Returns null otherwise (caller proceeds
    // to normal dispatch). When the origin is not allowed, returns
    // the 204 without any Allow-* headers (browser will reject).
    public HttpResponse Preflight(HttpRequest req) {
        if (req.Method != "OPTIONS") { return null }
        if (req.Header("access-control-request-method") == "") { return null }
        let origin: string = req.Header("origin")
        let resp: HttpResponse = HttpResponse.New().Status(204)
        resp.Header("Vary", "Origin")
        if (this.OriginAllowed(origin)) {
            resp.Header("Access-Control-Allow-Origin", this.OriginEcho(origin))
            if (this.AllowedMethods.Count() > 0) {
                resp.Header("Access-Control-Allow-Methods", Cors.JoinList(this.AllowedMethods, ", "))
            }
            if (this.AllowedHeaders.Count() > 0) {
                resp.Header("Access-Control-Allow-Headers", Cors.JoinList(this.AllowedHeaders, ", "))
            }
            if (this.AllowCredentials) {
                resp.Header("Access-Control-Allow-Credentials", "true")
            }
            if (this.MaxAgeSec > 0) {
                resp.Header("Access-Control-Max-Age", String_FromInt(this.MaxAgeSec))
            }
        }
        return resp
    }

    // ── Normal-request decoration ──────────────────────
    // Adds Allow-Origin / Allow-Credentials / Expose-Headers to a
    // response. No-op if the request isn't cross-origin (no Origin
    // header) or the origin isn't allowed. Always sets Vary: Origin
    // when an Origin header is present so caches stay sane.
    // Handler-set headers are never overwritten.
    public HttpResponse Apply(HttpRequest req, HttpResponse resp) {
        let origin: string = req.Header("origin")
        if (origin == "") { return resp }
        if (!resp.Headers.Has("Vary")) {
            resp.Header("Vary", "Origin")
        }
        if (!this.OriginAllowed(origin)) { return resp }
        if (!resp.Headers.Has("Access-Control-Allow-Origin")) {
            resp.Header("Access-Control-Allow-Origin", this.OriginEcho(origin))
        }
        if (this.AllowCredentials && !resp.Headers.Has("Access-Control-Allow-Credentials")) {
            resp.Header("Access-Control-Allow-Credentials", "true")
        }
        if (this.ExposedHeaders.Count() > 0 && !resp.Headers.Has("Access-Control-Expose-Headers")) {
            resp.Header("Access-Control-Expose-Headers", Cors.JoinList(this.ExposedHeaders, ", "))
        }
        return resp
    }

    // ── FromMap — TOML/env friendly ────────────────────
    // Recognised keys (all optional, unknown ignored):
    //   preset             "disabled" | "allow_all" | "strict"
    //   allowed_origins    comma-separated, trimmed
    //   allowed_methods    comma-separated
    //   allowed_headers    comma-separated
    //   exposed_headers    comma-separated
    //   allow_credentials  "true" | "false"
    //   max_age_sec        int (string)
    public static Cors FromMap(Map<string, string> cfg) {
        var c: Cors = new Cors()
        if (cfg.Has("preset")) {
            let p: string = cfg.Get("preset")
            if (p == "allow_all") { c = Cors.AllowAll() }
            else if (p == "strict") { c = Cors.Strict() }
        }
        if (cfg.Has("allowed_origins")) { c.AllowedOrigins = Cors.SplitCsv(cfg.Get("allowed_origins")) }
        if (cfg.Has("allowed_methods")) { c.AllowedMethods = Cors.SplitCsv(cfg.Get("allowed_methods")) }
        if (cfg.Has("allowed_headers")) { c.AllowedHeaders = Cors.SplitCsv(cfg.Get("allowed_headers")) }
        if (cfg.Has("exposed_headers")) { c.ExposedHeaders = Cors.SplitCsv(cfg.Get("exposed_headers")) }
        if (cfg.Has("allow_credentials")) { c.AllowCredentials = (cfg.Get("allow_credentials") == "true") }
        if (cfg.Has("max_age_sec")) { c.MaxAgeSec = String_ToInt(cfg.Get("max_age_sec")) }
        return c
    }

    // ── helpers ────────────────────────────────────────
    private static string JoinList(List<string> items, string sep) {
        var s: string = ""
        let n: int = items.Count()
        for i in 0..n {
            if (i > 0) { s = s + sep }
            s = s + items.Get(i)
        }
        return s
    }

    // Splits "a, b, c" into ["a", "b", "c"], trimming each element.
    private static List<string> SplitCsv(string csv) {
        let result: List<string> = new List<string>()
        let n: int = String_Length(csv)
        if (n == 0) { return result }
        var start: int = 0
        var i: int = 0
        while (i < n) {
            let c: string = String_CharAt1(csv, i)
            if (c == ",") {
                let segment: string = String_Substring(csv, start, i - start)
                result.Add(String_Trim(segment))
                start = i + 1
            }
            i = i + 1
        }
        if (n > start) {
            result.Add(String_Trim(String_Substring(csv, start, n - start)))
        }
        return result
    }
}

// ─────────────────────────────────────────────────────────────────
// RateLimitBucket — per-key window state. Internal to RateLimit but
// public so the user can inspect or pre-seed the store from tests.
// ─────────────────────────────────────────────────────────────────

public class RateLimitBucket {
    public Count:            int     // requests counted in the current window
    public WindowStartNanos: int     // monotonic-nanos of window start

    public RateLimitBucket() {
        this.Count = 0
        this.WindowStartNanos = 0
    }
}

// ─────────────────────────────────────────────────────────────────
// RateLimit — fixed-window per-key throttle (v0.6.0).
//
// Counts requests per `KeyStrategy` per `WindowNanos` window. When
// a key exceeds `MaxRequests`, `Check(req)` returns a 429 response
// (caller short-circuits dispatch). Otherwise it returns null and
// the request proceeds.
//
// Fixed-window algorithm: simple, predictable, has a known
// "double-burst at boundary" property (briefly 2× rate when a
// burst straddles two windows). For Mosaic v1 this is acceptable;
// v2 will offer sliding-window / token-bucket variants.
//
// Time source: `DateTime.NowMonotonicNanos()` from amalgame-datetime
// (monotonic, immune to NTP slews and DST jumps).
//
// Keys today:
//   "ip"   — req.RemoteAddr stripped of port, e.g. "192.0.2.1"
//
// Trusted proxies + X-Forwarded-For honoring is planned for v2.
//
// Usage:
//
//     let rl = RateLimit.PerIp(100, 60)        // 100 req / 60 s / IP
//     // in dispatch:
//     let limited: HttpResponse = rl.Check(req)
//     if (limited != null) {
//         TcpConn_Send(conn, limited.Render())
//         continue                              // skip the handler
//     }
//     let resp = route.Handler(ctx)
//     ...
// ─────────────────────────────────────────────────────────────────

public class RateLimit {
    public MaxRequests:  int
    public WindowNanos:  int
    public KeyStrategy:  string                          // "ip" today
    public Store:        Map<string, RateLimitBucket>    // key → bucket

    public RateLimit() {
        this.MaxRequests = 0
        this.WindowNanos = 0
        this.KeyStrategy = "ip"
        this.Store       = new Map<string, RateLimitBucket>()
    }

    // Per-IP preset. `windowSec` is the window length in seconds.
    public static RateLimit PerIp(int maxRequests, int windowSec) {
        let rl = new RateLimit()
        rl.MaxRequests = maxRequests
        rl.WindowNanos = windowSec * 1000000000
        rl.KeyStrategy = "ip"
        return rl
    }

    // No-op preset — Check always returns null. Used to disable
    // rate limiting via config without removing the wiring.
    public static RateLimit Disabled() {
        let rl = new RateLimit()
        rl.MaxRequests = 0
        return rl
    }

    // ── Builders ──────────────────────────────────────
    public RateLimit WithMaxRequests(int n)        { this.MaxRequests = n;             return this }
    public RateLimit WithWindowSec(int s)          { this.WindowNanos = s * 1000000000; return this }
    public RateLimit WithKeyStrategy(string s)     { this.KeyStrategy = s;             return this }

    // ── Key extraction ────────────────────────────────
    // Strip ":port" from "192.0.2.1:54321". Returns "" if req has
    // no RemoteAddr — caller treats as unidentifiable, current
    // policy is to allow (better than DoS-by-blocking).
    public string KeyFor(HttpRequest req) {
        if (this.KeyStrategy != "ip") { return "" }
        let addr: string = req.RemoteAddr
        if (addr == "") { return "" }
        // Strip port. IPv4 literal contains exactly one ':' before the
        // port. IPv6 literals would be bracketed; today's parser
        // produces "1.2.3.4:5678" only (v4). v2 will handle "[::1]:80".
        let n: int = String_Length(addr)
        var i: int = 0
        while (i < n) {
            let c: string = String_CharAt1(addr, i)
            if (c == ":") {
                return String_Substring(addr, 0, i)
            }
            i = i + 1
        }
        return addr
    }

    // ── The throttle decision ─────────────────────────
    // Returns a 429 HttpResponse when the request exceeds the
    // limit, else null. Always returns null when MaxRequests=0
    // (Disabled preset).
    public HttpResponse Check(HttpRequest req) {
        if (this.MaxRequests <= 0) { return null }
        let key: string = this.KeyFor(req)
        if (key == "") { return null }     // unidentifiable, allow
        let now: int = DateTime.NowMonotonicNanos()

        var bucket: RateLimitBucket = null
        if (this.Store.Has(key)) {
            bucket = this.Store.Get(key)
            // Rotate window if it's elapsed.
            if (now - bucket.WindowStartNanos >= this.WindowNanos) {
                bucket.Count = 0
                bucket.WindowStartNanos = now
            }
        } else {
            bucket = new RateLimitBucket()
            bucket.WindowStartNanos = now
            this.Store.Set(key, bucket)
        }

        if (bucket.Count >= this.MaxRequests) {
            // 429 Too Many Requests. Retry-After in seconds — round
            // up the remaining window. Always include Vary: not needed.
            let elapsedNanos: int = now - bucket.WindowStartNanos
            var remainingSec: int = (this.WindowNanos - elapsedNanos) / 1000000000
            if (remainingSec < 1) { remainingSec = 1 }
            let resp = HttpResponse.New()
                .Status(429)
                .Header("Retry-After", String_FromInt(remainingSec))
                .Text("rate limit exceeded")
            return resp
        }

        bucket.Count = bucket.Count + 1
        return null
    }

    // ── FromMap — TOML/env friendly ───────────────────
    // Recognised keys (all optional, unknown ignored):
    //   enabled         "true" | "false"  — when false, returns Disabled()
    //   preset          "per_ip" | "disabled"
    //   rps             requests-per-second (becomes max=rps, window=1s)
    //                   OR use max_requests + window_sec for full control
    //   max_requests    int
    //   window_sec      int
    //   key_strategy    "ip" (only one supported today)
    public static RateLimit FromMap(Map<string, string> cfg) {
        if (cfg.Has("enabled") && cfg.Get("enabled") == "false") {
            return RateLimit.Disabled()
        }
        var rl: RateLimit = new RateLimit()
        if (cfg.Has("preset")) {
            let p: string = cfg.Get("preset")
            if (p == "disabled") { return RateLimit.Disabled() }
            // "per_ip" with no rps/max yields a blank — caller must add via With*
        }
        // rps shortcut takes precedence if present.
        if (cfg.Has("rps")) {
            rl.MaxRequests = String_ToInt(cfg.Get("rps"))
            rl.WindowNanos = 1000000000   // 1 second
        }
        if (cfg.Has("max_requests")) { rl.MaxRequests = String_ToInt(cfg.Get("max_requests")) }
        if (cfg.Has("window_sec"))   { rl.WindowNanos = String_ToInt(cfg.Get("window_sec")) * 1000000000 }
        if (cfg.Has("key_strategy")) { rl.KeyStrategy = cfg.Get("key_strategy") }
        return rl
    }
}

// ─────────────────────────────────────────────────────────────────
// Csrf — Cross-Site Request Forgery guard, double-submit cookie
// pattern (v0.7.0).
//
// How it works:
//
//   1. On any safe request, EnsureToken(req, resp) checks for the
//      CSRF cookie. If absent, generates a 32-byte (256-bit) random
//      token via amalgame-random's crypto-grade `Random.SystemBytes`
//      and sets it as a `Set-Cookie` on the response. Returns the
//      token string (hex-encoded) for template embedding.
//
//   2. On any state-changing request (POST/PUT/PATCH/DELETE by
//      default), Validate(req) reads the CSRF cookie AND the value
//      of a configured header (default `X-CSRF-Token`). They must
//      match — if either is missing or the values differ, returns
//      a 403 response. Otherwise returns null (request proceeds).
//
//   3. The browser's same-origin policy keeps cross-origin pages
//      from reading the cookie OR setting custom request headers
//      (without a CORS preflight that we control), so an attacker
//      can't forge the matching header even if they trick the user
//      into submitting a form.
//
// Why double-submit (not synchronizer tokens):
//   - Stateless — no server-side token store, no Session dep.
//   - Works for stateless APIs as well as form posts.
//
// Limitations:
//   - Requires the CSRF cookie to be readable by JS (NOT HttpOnly)
//     so the client can echo it in the custom header. Mitigated by:
//     setting `Secure` + `SameSite=Lax` (default), keeping the
//     cookie's only sensitive value being its randomness, and never
//     using it as a session bearer.
//   - For pure HTML forms (no JS), embed the token as a hidden
//     <input name="csrf_token"> and validate against the form body
//     instead of a header — TODO v0.7.x adds a `BodyKey` config
//     for this; today header-only.
//
// Usage:
//
//     let csrf = Csrf.Default()
//
//     // in dispatch (before route handler):
//     let forbid: HttpResponse = csrf.Validate(req)
//     if (forbid != null) {
//         TcpConn_Send(conn, forbid.Render())
//         continue
//     }
//
//     let resp = match.Route.Handler(ctx)
//     csrf.EnsureToken(req, resp)           // bootstraps cookie on first hit
//     TcpConn_Send(conn, resp.Render())
// ─────────────────────────────────────────────────────────────────

public class Csrf {
    public CookieName:     string
    public HeaderName:     string
    public TokenBytes:     int           // entropy bytes (32 = 256 bits)
    public SafeMethods:    List<string>  // bypass for these methods
    public ExemptPaths:    List<string>  // prefix-matched bypasses
    public CookiePath:     string
    public CookieSecure:   bool
    public CookieSameSite: string        // "Strict" | "Lax" | "None"
    public CookieMaxAge:   int           // seconds; 0 = session cookie
    // Crypto source. Use `null` to lazily call Random.FromSystem()
    // on first need — every fresh instance creates its own stream
    // unless reseeded.
    public Rng:            Random

    public Csrf() {
        this.CookieName     = "csrf_token"
        this.HeaderName     = "X-CSRF-Token"
        this.TokenBytes     = 32
        this.SafeMethods    = new List<string>()
        this.SafeMethods.Add("GET")
        this.SafeMethods.Add("HEAD")
        this.SafeMethods.Add("OPTIONS")
        this.ExemptPaths    = new List<string>()
        this.CookiePath     = "/"
        this.CookieSecure   = true
        this.CookieSameSite = "Lax"
        this.CookieMaxAge   = 0
        this.Rng            = null
    }

    // Default preset — sensible production settings (256-bit token,
    // Secure + SameSite=Lax, safe methods skipped). Pair with
    // `.WithCookieSecure(false)` for plain HTTP dev.
    public static Csrf Default() { return new Csrf() }

    // No-op preset — Validate always returns null. Use when wiring
    // CSRF via config so flipping `enabled=false` doesn't require
    // tearing the pipeline down.
    public static Csrf Disabled() {
        let c = new Csrf()
        c.SafeMethods = new List<string>()      // empty
        c.SafeMethods.Add("*")                  // sentinel handled in Validate
        return c
    }

    // ── Builders ──────────────────────────────────────
    public Csrf WithCookieName(string n)       { this.CookieName     = n; return this }
    public Csrf WithHeaderName(string n)       { this.HeaderName     = n; return this }
    public Csrf WithTokenBytes(int b)          { this.TokenBytes     = b; return this }
    public Csrf WithCookiePath(string p)       { this.CookiePath     = p; return this }
    public Csrf WithCookieSecure(bool s)       { this.CookieSecure   = s; return this }
    public Csrf WithCookieSameSite(string ss)  { this.CookieSameSite = ss; return this }
    public Csrf WithCookieMaxAge(int a)        { this.CookieMaxAge   = a; return this }
    public Csrf WithSafeMethods(List<string> m) { this.SafeMethods   = m; return this }
    public Csrf ExemptPath(string prefix)      { this.ExemptPaths.Add(prefix); return this }
    public Csrf WithRng(Random r)              { this.Rng            = r; return this }

    // ── Token plumbing ────────────────────────────────
    // Hex-encode a list of bytes into a 2-chars-per-byte string.
    // Lowercase; portable (no shift/mask needed).
    private static string HexEncode(List<int> bytes) {
        let hex: string = "0123456789abcdef"
        var s: string = ""
        let n: int = bytes.Count()
        var i: int = 0
        while (i < n) {
            let b: int = bytes.Get(i)
            let hi: int = b / 16
            let lo: int = b % 16
            s = s + String_CharAt1(hex, hi) + String_CharAt1(hex, lo)
            i = i + 1
        }
        return s
    }

    // Generate a fresh hex token using the configured Rng (lazy-
    // initialised from the OS entropy source on first call).
    public string NewToken() {
        if (this.Rng == null) {
            this.Rng = Random.FromSystem()
        }
        let bytes: List<int> = this.Rng.Bytes(this.TokenBytes)
        return Csrf.HexEncode(bytes)
    }

    // ── EnsureToken — sets the CSRF cookie if missing ────────
    // Returns the token in effect for this request (whether
    // pre-existing from the request cookie or freshly minted).
    // Idempotent: if the cookie is already present and non-empty,
    // does nothing on the response.
    public string EnsureToken(HttpRequest req, HttpResponse resp) {
        let existing: string = this.ReadCookie(req)
        if (existing != "") { return existing }
        let token: string = this.NewToken()
        let c = new Cookie()
        c.Name     = this.CookieName
        c.Value    = token
        c.Path     = this.CookiePath
        c.Secure   = this.CookieSecure
        c.SameSite = this.CookieSameSite
        c.MaxAgeSec = this.CookieMaxAge
        // HttpOnly stays false — the SPA needs to read it back to
        // echo into the X-CSRF-Token header.
        c.HttpOnly = false
        resp.SetCookie(c)
        return token
    }

    // ── Validate — gate state-changing requests ──────────────
    // Returns null when:
    //   - Csrf is Disabled (SafeMethods contains "*")
    //   - req.Method is in SafeMethods
    //   - req.Path is prefix-matched by an ExemptPaths entry
    //   - cookie value matches header value (both non-empty)
    // Otherwise returns a 403 HttpResponse.
    public HttpResponse Validate(HttpRequest req) {
        // Disabled sentinel.
        if (this.SafeMethods.Count() > 0 && this.SafeMethods.Get(0) == "*") {
            return null
        }
        let m: int = this.SafeMethods.Count()
        var i: int = 0
        while (i < m) {
            if (this.SafeMethods.Get(i) == req.Method) { return null }
            i = i + 1
        }
        // Exempt path prefixes.
        let pn: int = this.ExemptPaths.Count()
        var j: int = 0
        while (j < pn) {
            let pref: string = this.ExemptPaths.Get(j)
            if (String_StartsWith(req.Path, pref)) { return null }
            j = j + 1
        }
        // Compare cookie ↔ header.
        let cookieVal: string = this.ReadCookie(req)
        let headerVal: string = req.Header(this.HeaderName)
        if (cookieVal == "" || headerVal == "") {
            return this.Deny("CSRF token missing")
        }
        if (cookieVal != headerVal) {
            return this.Deny("CSRF token mismatch")
        }
        return null
    }

    // ── Internal: read the CSRF cookie out of a request ──────
    // Cookie header is a single line "name1=value1; name2=value2".
    // We do a small splitter rather than rely on the net-http
    // Cookie.Parse (which has a different shape).
    private string ReadCookie(HttpRequest req) {
        let raw: string = req.Header("cookie")
        if (raw == "") { return "" }
        let n: int = String_Length(raw)
        var start: int = 0
        var i: int = 0
        while (i <= n) {
            let isEnd: bool = (i == n)
            var sep: bool = false
            if (!isEnd) {
                let c: string = String_CharAt1(raw, i)
                if (c == ";") { sep = true }
            }
            if (isEnd || sep) {
                let seg: string = String_Trim(String_Substring(raw, start, i - start))
                let segLen: int = String_Length(seg)
                let nameLen: int = String_Length(this.CookieName)
                if (segLen > nameLen + 1) {
                    let prefix: string = String_Substring(seg, 0, nameLen + 1)
                    if (prefix == this.CookieName + "=") {
                        return String_Substring(seg, nameLen + 1, segLen - nameLen - 1)
                    }
                }
                start = i + 1
            }
            i = i + 1
        }
        return ""
    }

    private HttpResponse Deny(string reason) {
        return HttpResponse.New()
            .Status(403)
            .Text(reason)
    }

    // Local copy of the comma-trim splitter — Cors.SplitCsv is
    // private to that class, and we'd rather keep Csrf self-contained
    // than punch a hole in Cors's surface for one shared helper.
    private static List<string> SplitCsv(string csv) {
        let result: List<string> = new List<string>()
        let n: int = String_Length(csv)
        if (n == 0) { return result }
        var start: int = 0
        var i: int = 0
        while (i < n) {
            let c: string = String_CharAt1(csv, i)
            if (c == ",") {
                result.Add(String_Trim(String_Substring(csv, start, i - start)))
                start = i + 1
            }
            i = i + 1
        }
        if (n > start) {
            result.Add(String_Trim(String_Substring(csv, start, n - start)))
        }
        return result
    }

    // ── FromMap — TOML/env friendly ───────────────────
    // Recognised keys (all optional, unknown ignored):
    //   enabled         "true" | "false"  — false returns Disabled()
    //   cookie_name     string
    //   header_name     string
    //   token_bytes     int (entropy bytes)
    //   safe_methods    comma-separated
    //   exempt_paths    comma-separated (prefix match)
    //   cookie_path     string
    //   cookie_secure   "true" | "false"
    //   cookie_samesite "Strict" | "Lax" | "None"
    //   cookie_max_age  int (seconds)
    public static Csrf FromMap(Map<string, string> cfg) {
        if (cfg.Has("enabled") && cfg.Get("enabled") == "false") {
            return Csrf.Disabled()
        }
        var c: Csrf = new Csrf()
        if (cfg.Has("cookie_name"))      { c.CookieName     = cfg.Get("cookie_name") }
        if (cfg.Has("header_name"))      { c.HeaderName     = cfg.Get("header_name") }
        if (cfg.Has("token_bytes"))      { c.TokenBytes     = String_ToInt(cfg.Get("token_bytes")) }
        if (cfg.Has("safe_methods"))     { c.SafeMethods    = Csrf.SplitCsv(cfg.Get("safe_methods")) }
        if (cfg.Has("exempt_paths"))     { c.ExemptPaths    = Csrf.SplitCsv(cfg.Get("exempt_paths")) }
        if (cfg.Has("cookie_path"))      { c.CookiePath     = cfg.Get("cookie_path") }
        if (cfg.Has("cookie_secure"))    { c.CookieSecure   = (cfg.Get("cookie_secure") == "true") }
        if (cfg.Has("cookie_samesite"))  { c.CookieSameSite = cfg.Get("cookie_samesite") }
        if (cfg.Has("cookie_max_age"))   { c.CookieMaxAge   = String_ToInt(cfg.Get("cookie_max_age")) }
        return c
    }
}

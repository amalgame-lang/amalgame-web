// amalgame-web — Per-request WebContext bag.
//
// Lives in its own file since v0.7.x split. References `Session`
// from session.am — load order in amalgame.toml's `sources` must
// list session.am before this one.

namespace Amalgame.Web

import Amalgame.Collections
import Amalgame.Net.Http

// ─────────────────────────────────────────────────────────────────
// WebContext — per-request "bag" of conveniences.
//
// In v0.1.x this becomes the canonical handler argument. For v0.1,
// it's a standalone value the user can populate manually.
// ─────────────────────────────────────────────────────────────────

public class WebContext {
    public Params:    Map<string, string>     // path params from RouteMatch
    public State:     Map<string, string>     // app-level shared state (string-typed v0.1)
    public Session:   Session                 // null if no session
    public RequestId: string
    // v0.13.4: raw request body (POST/PUT/PATCH). For GET/DELETE
    // it's "". Populated by WebApp.Handle from HttpRequest.Body
    // before the route handler runs. text-safe (binary uploads
    // are a future surface — v0.14 will offer a Stream API).
    public Body:      string
    public Method:    string                  // "GET" / "POST" / ...
    public Path:      string                  // "/users/42" — no query
    public Query:     Map<string, string>     // parsed query string
    // v0.25.0: the originating request, so handlers reach the raw body
    // buffer for binary-safe multipart uploads via ctx.Multipart().
    // null when the context was built without a request (unit tests).
    public Req:       HttpRequest
    // v0.32.0: per-request CSP nonce. Non-empty only when the app enabled
    // SecurityHeaders.WithCspNonce(); stamp it on inline <script> tags
    // (`<script nonce="{{cspNonce}}">`) so they pass the strict CSP.
    public CspNonce:  string

    public WebContext() {
        this.Params    = new Map<string, string>()
        this.State     = new Map<string, string>()
        this.Session   = null
        this.RequestId = ""
        this.Body      = ""
        this.Method    = ""
        this.Path      = ""
        this.Query     = new Map<string, string>()
        this.Req       = null
        this.CspNonce  = ""
    }

    public string QueryParam(string name) {
        if (this.Query.Has(name)) { return this.Query.Get(name) }
        return ""
    }

    public string Param(string name) {
        if (this.Params.Has(name)) { return this.Params.Get(name) }
        return ""
    }

    public string StateOf(string name) {
        if (this.State.Has(name)) { return this.State.Get(name) }
        return ""
    }

    // v0.25.0: parse a multipart/form-data body (file uploads). Returns
    // an empty Multipart when there's no request or it isn't multipart.
    //   let mp = ctx.Multipart()
    //   let f  = mp.File("avatar")   // UploadedFile or null
    public Multipart Multipart() {
        if (this.Req == null) { return new Multipart() }
        return Multipart.Parse(this.Req)
    }

    // True when the request carries a multipart/form-data body.
    public bool IsMultipart() {
        if (this.Req == null) { return false }
        return this.Req.IsMultipart()
    }

    // v0.24.0: render a template file to an HTML response. `{{x}}` is
    // HTML-escaped by default (XSS-safe); `{{{x}}}` opts out. Returns a
    // ready HttpResponse with Content-Type: text/html — handlers do
    // `return ctx.Render("views/user.html", data)`.
    public HttpResponse Render(string templatePath, Map<string, string> data) {
        let t: Template = Template.FromFile(templatePath)
        return HttpResponse.New().Html(t.Render(data))
    }

    // Render an inline template source string (no file read).
    public HttpResponse RenderString(string src, Map<string, string> data) {
        return HttpResponse.New().Html(Template.RenderString(src, data))
    }

    // v0.40.0: render a template file with a TemplateContext (adds
    // list-bound `{{#key}}` sections on top of the flat-map behavior
    // of Render()). `let ctx = TemplateContext.FromData(data).WithList(...)`.
    public HttpResponse RenderContext(string templatePath, TemplateContext ctx) {
        let t: Template = Template.FromFile(templatePath)
        return HttpResponse.New().Html(t.RenderContext(ctx))
    }

    // Render an inline template source string with a TemplateContext.
    public HttpResponse RenderStringContext(string src, TemplateContext ctx) {
        return HttpResponse.New().Html(Template.RenderStringContext(src, ctx))
    }
}

public class ProtectedRoutes {
    public App: WebApp

    public ProtectedRoutes(WebApp app) {
        this.App = app
    }

    public ProtectedRoutes Get(string path, Closure<WebContext, HttpResponse> handler)    { this.App.addProtectedRoute("GET", path, handler);    return this }
    public ProtectedRoutes Post(string path, Closure<WebContext, HttpResponse> handler)   { this.App.addProtectedRoute("POST", path, handler);   return this }
    public ProtectedRoutes Put(string path, Closure<WebContext, HttpResponse> handler)    { this.App.addProtectedRoute("PUT", path, handler);    return this }
    public ProtectedRoutes Patch(string path, Closure<WebContext, HttpResponse> handler)  { this.App.addProtectedRoute("PATCH", path, handler);  return this }
    public ProtectedRoutes Delete(string path, Closure<WebContext, HttpResponse> handler) { this.App.addProtectedRoute("DELETE", path, handler); return this }

    // Climb back to the WebApp to resume app-level chaining.
    public WebApp End() { return this.App }
}

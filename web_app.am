// amalgame-web — WebApp orchestrator (v0.8.0).
//
// Centralizes the middleware pipeline. Without this, a user has to
// re-implement RateLimit → Cors preflight → Csrf → handler →
// SecurityHeaders → Cors response → Csrf cookie EVERY time they
// write an accept loop. WebApp does it once, the right way.
//
// Pipeline order (extended in v0.13.0 with static mounts):
//
//   request →
//     1. RateLimit.Check         (429 if over limit)
//     2. Cors.Preflight          (204 if OPTIONS preflight matches)
//     3. Csrf.Validate           (403 if token missing/mismatched)
//     3b. Static.Serve           (200/304/403/404 for any path
//                                  matching a registered mount)
//     4. Router.Match + handler  (404 if no route)
//     5. Csrf.EnsureToken        (sets cookie on response if absent)
//     6. SecurityHeaders.Apply   (stamps CSP / HSTS / etc.)
//     7. Cors.Apply              (adds Allow-Origin / Vary)
//   → response
//
// Steps 1-3 can short-circuit (return non-null HttpResponse); the
// pipeline still runs the response-side middlewares (5-7) on the
// short-circuited response so the rejecter still carries the right
// security headers + CORS info.
//
// Usage:
//
//     let app = WebApp.New()
//         .WithSecurityHeaders(SecurityHeaders.StrictHtml())
//         .WithCors(Cors.Strict().AddOrigin("https://app.example.com"))
//         .WithRateLimit(RateLimit.PerIp(100, 60))
//         .WithCsrf(Csrf.Default())
//         .Get("/",          ctx => HttpResponse.New().Text("hi"))
//         .Get("/users/:id", ctx => HttpResponse.New().Text("user " + ctx.Param("id")))
//         .Post("/users",    ctx => HttpResponse.New().Status(201).Json("{}"))
//
//     // in the accept loop:
//     while (true) {
//         let conn = TcpServer_Accept(srv)
//         let raw  = TcpConn_Receive(conn, 65536)
//         let req  = HttpParser.ParseFull(raw)
//         let resp = (req == null)
//             ? HttpResponse.New().Status(400).Text("Bad Request")
//             : app.Handle(req)
//         TcpConn_Send(conn, resp.Render())
//         TcpConn_Close(conn)
//     }
//
// Middleware fields are nullable — `null` = not configured = skip
// that step. So `WebApp.New()` with no With* calls runs only the
// router + a 404 handler, which is a valid minimal app.

namespace Amalgame.Web

import Amalgame.Collections
import Amalgame.String
import Amalgame.Logging
import Amalgame.Threading
import Amalgame.Net.Http
import Amalgame.Async
import Amalgame.DateTime    // monotonic clock for access-log request timing

public class WebApp {
    public Routes:          Router
    public Headers:         SecurityHeaders   // null = no security headers
    public CorsCfg:         Cors              // null = no CORS handling
    public CsrfCfg:         Csrf              // null = no CSRF validation
    public Limiter:         RateLimit         // null = no rate limit
    public Logging:         LogConfig         // null = no access log
    // v0.19.0: auth middleware. Both nullable — null = not configured.
    // They gate ONLY routes registered via Protected() (Route.Protected
    // == true); public routes are never challenged. When a protected
    // route matches, the pipeline accepts the request if EITHER
    // configured scheme verifies; a protected route with no auth
    // configured fails closed (401). See dispatch()'s auth step.
    public BasicAuthCfg:    BasicAuth         // null = no Basic auth
    public JwtAuthCfg:      JwtAuth           // null = no Bearer/JWT auth
    // v0.20.0: session store (any SessionStore — Memory / Redis /
    // SignedCookie). When enabled, the pipeline loads ctx.Session from
    // the request cookie before the handler and persists it (backend +
    // Set-Cookie) afterwards. An amc interface value is a fat
    // (itab+data) value, not a nullable pointer — so a separate
    // SessionEnabled flag gates it rather than a null check, and the
    // field is only ever read when the flag is true.
    public SessionCfg:      SessionStore
    public SessionEnabled:  bool
    // v0.13.0: ordered list of Static mounts. Checked between
    // CSRF validation and the router on every request — first
    // mount whose prefix matches handles the response. Static
    // bypasses CSRF response middlewares (no Set-Cookie for an
    // asset) but still gets SecurityHeaders / CORS stamped on.
    public StaticMounts:    List<Static>
    public State:           Map<string, string>  // app-level shared state

    // v0.9.4: mutex protecting State. WithState() can legitimately be
    // called from a handler thread at runtime (e.g. caching computed
    // config), and Handle() reads State per-request — without the
    // lock, concurrent .Set / .Get on the underlying AmalgameMap is
    // a race. Routes/Headers/CorsCfg/etc. are NOT protected because
    // they're idiomatically configured once at startup; user code that
    // mutates them mid-run is its own problem.
    public StateMu:         AmalgameMutex

    public WebApp() {
        this.Routes        = new Router()
        this.Headers       = null
        this.CorsCfg       = null
        this.CsrfCfg       = null
        this.Limiter       = null
        this.Logging       = null
        this.BasicAuthCfg  = null
        this.JwtAuthCfg    = null
        this.SessionEnabled = false
        this.StaticMounts  = new List<Static>()
        this.State         = new Map<string, string>()
        this.StateMu       = Threading.MutexNew()
    }

    public static WebApp New() { return new WebApp() }

    // ── Middleware wiring ─────────────────────────────
    public WebApp WithSecurityHeaders(SecurityHeaders sec) { this.Headers = sec;  return this }
    public WebApp WithCors(Cors c)                         { this.CorsCfg = c;    return this }
    public WebApp WithCsrf(Csrf c)                         { this.CsrfCfg = c;    return this }
    public WebApp WithRateLimit(RateLimit rl)              { this.Limiter = rl;   return this }
    // v0.19.0: register auth schemes. They challenge only Protected()
    // routes. Configure both to accept either (e.g. Bearer JWT for the
    // API + Basic for a curl-friendly admin endpoint).
    public WebApp WithBasicAuth(BasicAuth ba)              { this.BasicAuthCfg = ba; return this }
    public WebApp WithJwt(JwtAuth ja)                      { this.JwtAuthCfg   = ja; return this }
    // v0.20.0: enable sessions backed by any SessionStore. Handlers
    // then read/write ctx.Session; the pipeline loads it from the
    // request cookie and persists it on the response automatically.
    public WebApp WithSession(SessionStore store)          { this.SessionCfg = store; this.SessionEnabled = true; return this }
    // v0.13.0: register a static-file mount. Order matters —
    // mounts are checked first-to-last on every request, so
    // declare more-specific prefixes ("/assets/v2") before
    // catchalls ("/"). A `/` mount becomes the SPA fallback.
    public WebApp WithStatic(Static s) {
        this.StaticMounts.Add(s)
        return this
    }
    // Apply level + file sink on the amalgame-logging facade
    // immediately so subsequent Log.Info/Warn/etc. honor them. The
    // LogConfig is also kept on the WebApp so Handle() can emit the
    // access-log line per request.
    public WebApp WithLogging(LogConfig lc) {
        this.Logging = lc
        if (lc != null) { lc.Apply() }
        return this
    }

    // ── Shared state (app-level k/v, exposed to handlers via ctx.State) ──
    public WebApp WithState(string key, string value) {
        Threading.MutexLock(this.StateMu)
        this.State.Set(key, value)
        Threading.MutexUnlock(this.StateMu)
        return this
    }

    // ── Route registration (mirrors Router's surface for fluency) ──
    public WebApp Get(string path, Closure<WebContext, HttpResponse> handler)    { this.Routes.Get(path, handler);    return this }
    public WebApp Post(string path, Closure<WebContext, HttpResponse> handler)   { this.Routes.Post(path, handler);   return this }
    public WebApp Put(string path, Closure<WebContext, HttpResponse> handler)    { this.Routes.Put(path, handler);    return this }
    public WebApp Patch(string path, Closure<WebContext, HttpResponse> handler)  { this.Routes.Patch(path, handler);  return this }
    public WebApp Delete(string path, Closure<WebContext, HttpResponse> handler) { this.Routes.Delete(path, handler); return this }

    // ── v0.19.0: auth-protected route group ───────────
    // Returns a ProtectedRoutes proxy whose Get/Post/... register
    // routes flagged Protected=true. Those routes are gated behind the
    // configured auth middleware (WithBasicAuth / WithJwt) in dispatch.
    //
    //     app.WithJwt(new JwtAuth(secret))
    //        .Get("/", home)                  // public
    //        .Protected()
    //            .Get("/admin",  admin)        // requires a valid token
    //            .Post("/api/x", create)
    //
    // Declare protected routes after the public ones (Protected()
    // returns the group, not the app — End() climbs back to the app
    // if you need to keep chaining app-level config afterwards).
    public ProtectedRoutes Protected() {
        return new ProtectedRoutes(this)
    }

    // Internal: register a protected route. Called by ProtectedRoutes
    // so the group never reaches through `app.Routes` itself — a
    // `this.App.Routes.AddProtected(...)` chain (this→field→field→
    // method) currently mis-lowers in cgen, whereas this.Routes.method
    // (the same shape as Get/Post above) is fine. Keeping the reach-in
    // here means ProtectedRoutes only ever does `this.App.method()`.
    public WebApp addProtectedRoute(string method, string path, Closure<WebContext, HttpResponse> handler) {
        this.Routes.AddProtected(method, path, handler)
        return this
    }

    // ── The orchestrator ─────────────────────────────
    // Runs the configured pipeline on `req` and returns the final
    // HttpResponse. Never throws — every failure mode produces a
    // proper HttpResponse so the caller can blindly `.Render()` and
    // ship it.
    // Run the full pipeline on `req` and return the final response.
    // When access logging is on, emits exactly one INFO line per
    // request — on EVERY path (static hit, middleware reject, route,
    // 404), not just routed handlers — by wrapping the whole dispatch
    // and timing it on the monotonic clock.
    public HttpResponse Handle(HttpRequest req) {
        if (this.Logging == null || !this.Logging.AccessLog) {
            return this.dispatch(req)
        }
        let t0: int = DateTime.NowMonotonicNanos()
        let final: HttpResponse = this.dispatch(req)
        this.logAccess(req, final, t0)
        return final
    }

    // One access-log line: "METHOD host path -> status Nms ip:port".
    // host comes from the Host header (lower-cased key), ip from the
    // connection's RemoteAddr, duration from the monotonic clock.
    // Falls back to "-" when a field is absent.
    private void logAccess(HttpRequest req, HttpResponse final, int t0) {
        var host: string = "-"
        if (req.Headers != null && req.Headers.Has("host")) {
            host = req.Headers.Get("host")
        }
        var ip: string = req.RemoteAddr
        if (String_Length(ip) == 0) { ip = "-" }
        let dtNs: int = DateTime.NowMonotonicNanos() - t0
        let dtMs: int = dtNs / 1000000
        Log.Info(req.Method + " " + host + " " + req.Path + " -> "
                 + String_FromInt(final.StatusCode) + " "
                 + String_FromInt(dtMs) + "ms " + ip)
    }

    private HttpResponse dispatch(HttpRequest req) {
        // 1. RateLimit. Cheapest reject — go first.
        if (this.Limiter != null) {
            let limited: HttpResponse = this.Limiter.Check(req)
            if (limited != null) {
                return this.applyResponseMiddlewares(req, limited)
            }
        }

        // 2. Cors preflight. Handled before any handler runs because
        // OPTIONS preflights shouldn't even reach the route table.
        if (this.CorsCfg != null) {
            let pf: HttpResponse = this.CorsCfg.Preflight(req)
            if (pf != null) {
                return this.applyResponseMiddlewares(req, pf)
            }
        }

        // 3. Csrf. State-changing methods are gated here.
        if (this.CsrfCfg != null) {
            let forbid: HttpResponse = this.CsrfCfg.Validate(req)
            if (forbid != null) {
                return this.applyResponseMiddlewares(req, forbid)
            }
        }

        // 3b. Static mounts. Before the router because the
        // typical layout has "/" routes + "/assets/*" static,
        // and the static path is cheaper to short-circuit than
        // dragging every asset request through a no-match route
        // scan. First mount whose prefix matches wins.
        let sn: int = this.StaticMounts.Count()
        for i in 0..sn {
            let mount: Static = this.StaticMounts.Get(i)
            let staticResp: HttpResponse = mount.Serve(req)
            if (staticResp != null) {
                return this.applyResponseMiddlewares(req, staticResp)
            }
        }

        // 4. Route match + handler. Build a fresh WebContext per
        // request — it carries the path params + a snapshot of the
        // app-level state.
        let m: RouteMatch = this.Routes.Match(req.Method, req.Path)
        var resp: HttpResponse
        if (m == null) {
            resp = HttpResponse.New().Status(404).Text("Not found")
        } else if (m.Route.Protected && this.authDeny(req) != null) {
            // v0.19.0: matched a Protected() route but auth failed.
            // Short-circuit with the denial response (401/403) — the
            // handler never runs. Public routes and 404s skip this
            // entirely, so unprotected traffic pays nothing.
            resp = this.authDeny(req)
        } else {
            let ctx = new WebContext()
            ctx.Params = m.Params
            // v0.13.4: expose request body + method + path on the
            // context so handlers can read PUT/POST/PATCH payloads
            // (was previously only accessible by re-parsing the
            // raw HttpRequest, which handlers didn't see).
            ctx.Body   = req.Body
            ctx.Method = req.Method
            ctx.Path   = req.Path
            // Shallow-copy query params (already parsed by the
            // HTTP layer). Handlers reach them via ctx.Query.Get()
            // or the helper ctx.QueryParam("name").
            if (req.Query != null) {
                let qkeys: List<string> = req.Query.Keys()
                let qn: int = qkeys.Count()
                for qi in 0..qn {
                    let qk: string = qkeys.Get(qi)
                    ctx.Query.Set(qk, req.Query.Get(qk))
                }
            }
            // Shallow-copy app state into ctx for read access.
            // Wrapped in StateMu — the lock-hold is short (a Keys()
            // call + N Get()s for typical app-config Maps with a
            // handful of entries). Once ctx.State is populated, the
            // handler runs without holding the lock.
            Threading.MutexLock(this.StateMu)
            let keys: List<string> = this.State.Keys()
            let kn: int = keys.Count()
            for i in 0..kn {
                let k: string = keys.Get(i)
                ctx.State.Set(k, this.State.Get(k))
            }
            Threading.MutexUnlock(this.StateMu)
            // v0.20.0: load the session from the request cookie before
            // the handler runs, so ctx.Session is live for read/write.
            if (this.SessionEnabled) {
                ctx.Session = this.SessionCfg.LoadSession(req)
            }
            resp = m.Route.Handler(ctx)
            // Persist any handler mutations (backend write + Set-Cookie)
            // before the response-side middlewares stamp the rest.
            if (this.SessionEnabled) {
                this.SessionCfg.SaveSession(ctx.Session, resp)
            }
        }

        return this.applyResponseMiddlewares(req, resp)
    }

    // ── Internal: response-side middleware chain ─────
    // Csrf.EnsureToken first (sets cookie if absent) so SecurityHeaders
    // can then stamp Set-Cookie alongside CSP etc. Cors.Apply last
    // so its Vary: Origin sits next to the other headers.
    private HttpResponse applyResponseMiddlewares(HttpRequest req, HttpResponse resp) {
        if (this.CsrfCfg != null) {
            this.CsrfCfg.EnsureToken(req, resp)
        }
        if (this.Headers != null) {
            this.Headers.Apply(resp)
        }
        if (this.CorsCfg != null) {
            this.CorsCfg.Apply(req, resp)
        }
        return resp
    }

    // ── v0.19.0: auth gate for Protected() routes ────
    // Evaluate the configured auth schemes against a request bound for
    // a protected route. Returns null when access is GRANTED (any
    // configured scheme verifies), else the denial HttpResponse (the
    // scheme's own 401/403 carrying WWW-Authenticate). A protected
    // route with NO auth configured fails closed with a bare 401 — a
    // misconfiguration should never silently expose a guarded handler.
    //
    // Reject() is idempotent and side-effect free, so re-running it
    // (dispatch tests `!= null` then reuses the result) is safe; the
    // cost is a couple of HMAC verifies on the protected path only.
    private HttpResponse authDeny(HttpRequest req) {
        var configured: bool = false
        if (this.JwtAuthCfg != null) {
            configured = true
            if (this.JwtAuthCfg.Reject(req) == null) { return null }
        }
        if (this.BasicAuthCfg != null) {
            configured = true
            if (this.BasicAuthCfg.Reject(req) == null) { return null }
        }
        if (!configured) {
            return HttpResponse.New()
                .Status(401)
                .Header("Content-Type", "text/plain; charset=UTF-8")
                .Text("Authentication required")
        }
        // A scheme is configured but none granted access. Prefer the
        // JWT challenge (API default); fall back to Basic's so browsers
        // get a credential prompt.
        if (this.JwtAuthCfg != null) { return this.JwtAuthCfg.Reject(req) }
        return this.BasicAuthCfg.Reject(req)
    }

    // ── v0.11.0: Drop-in HTTP/1.1 server entry points ─
    //
    // Each builds the H1Conn → HttpRequest → Handle →
    // HttpResponse → H1Conn bridge closure once, then forwards to
    // amalgame-net-http's `Http1.*` family. The conn arrives typed
    // as int (pointer-as-i64 handle) — see HttpRequest.FromH1Conn
    // / HttpResponse.WriteToH1Conn for the rationale.
    //
    // Pick by deployment model:
    //
    //   Serve(port)             — single-thread accept loop. Use
    //                             for local dev and small apps.
    //   ServeMt(port)           — thread-per-connection. Use when
    //                             handlers do I/O.
    //   ServeWith(port, cfg)    — single-thread + HttpServerConfig
    //                             (timeouts, size limits, keep-alive).
    //   ServeMtWith(port, cfg)  — production default: multi-thread
    //                             + keep-alive + config.
    //
    // Returns the underlying Http1_Serve* exit code: 0 on clean
    // shutdown (unreachable — loops forever), -1 on null handler,
    // -2 on bind failure.
    // v0.11.3: instance methods are now direct closures over `let app = this`.
    // amc v0.8.39's resolver-polish (PR Amalgame#523) propagates `this`'s
    // class type through the local binding, so the lambda env carries
    // `WebApp* _app` instead of `i64 _app`.  Pre-v0.8.39 this code lived in
    // a `Static.ServeImpl(app: WebApp, port: int)` indirection — kept around
    // because typed parameters survived the lambda capture but `let x = this`
    // didn't.  Direct closures are 25 lines shorter and read like the
    // user-facing API they sit behind.
    //
    // Likewise the `conn` lambda parameter no longer needs the
    // `var cInt: int = 0; @c { cInt = (i64)(uintptr_t) conn; }` cast
    // block — typed `Closure<int, int>` (amc v0.8.35+) means `conn`
    // is already `i64` inside the body, ready to pass straight to
    // HttpRequest.FromH1Conn / HttpResponse.WriteToH1Conn.
    public int Serve(int port) {
        let app = this
        let handler = conn => {
            let req: HttpRequest = HttpRequest.FromH1Conn(conn)
            let resp: HttpResponse = app.Handle(req)
            resp.WriteToH1Conn(conn)
            return 0
        }
        return Http1.Serve(port, handler)
    }
    public int ServeMt(int port) {
        let app = this
        let handler = conn => {
            let req: HttpRequest = HttpRequest.FromH1Conn(conn)
            let resp: HttpResponse = app.Handle(req)
            resp.WriteToH1Conn(conn)
            return 0
        }
        return Http1.ServeMt(port, handler)
    }

    //   ServeHttps(port, certPath, keyPath) — single-thread TLS-
    //     terminating HTTP/1.1. Pairs with amalgame-net-http v0.10+
    //     Https.H1Serve: same H1Conn handler shape as Serve(), but
    //     the listener does TLS termination so deployments don't
    //     need an nginx/Caddy reverse proxy doing TLS in front.
    //     ALPN advertises "http/1.1"; browsers happily downgrade
    //     from h2. The cert + key paths are forwarded verbatim to
    //     OpenSSL (PEM expected, same as the older Https.Serve).
    //
    //   ServeHttpsMt(port, certPath, keyPath) — multi-thread variant.
    //     Same caveats as ServeMt: handler must be thread-safe.
    public int ServeHttps(int port, string certPath, string keyPath) {
        let app = this
        let handler = conn => {
            let req: HttpRequest = HttpRequest.FromH1Conn(conn)
            let resp: HttpResponse = app.Handle(req)
            resp.WriteToH1Conn(conn)
            return 0
        }
        return Https.H1Serve(port, certPath, keyPath, handler)
    }
    public int ServeHttpsMt(int port, string certPath, string keyPath) {
        let app = this
        let handler = conn => {
            let req: HttpRequest = HttpRequest.FromH1Conn(conn)
            let resp: HttpResponse = app.Handle(req)
            resp.WriteToH1Conn(conn)
            return 0
        }
        return Https.H1ServeMt(port, certPath, keyPath, handler)
    }

    public int ServeWith(int port, cfg: AmalgameNetHttpServerConfig) {
        let app = this
        let handler = conn => {
            let req: HttpRequest = HttpRequest.FromH1Conn(conn)
            let resp: HttpResponse = app.Handle(req)
            resp.WriteToH1Conn(conn)
            return 0
        }
        return Http1.ServeWith(port, cfg, handler)
    }
    public int ServeMtWith(int port, cfg: AmalgameNetHttpServerConfig) {
        let app = this
        let handler = conn => {
            let req: HttpRequest = HttpRequest.FromH1Conn(conn)
            let resp: HttpResponse = app.Handle(req)
            resp.WriteToH1Conn(conn)
            return 0
        }
        return Http1.ServeMtWith(port, cfg, handler)
    }

    // ── v0.12.0: fiber-driven HTTP/1.1 — one OS thread, N fibers ───
    //
    // ServeAsync(port) wraps amalgame-net-http ≥ 0.9.2's
    // Http1.ServeAsync. Each connection runs in an amalgame-async
    // fiber; recv / send park on EAGAIN via epoll instead of
    // blocking the OS thread or pinning a pthread. HTTP/1.1
    // keep-alive across requests is on by default (RFC 7230 rules).
    //
    // When to pick ServeAsync over ServeMtWith:
    //   - Handlers do downstream I/O (DB, HTTP client, file). The
    //     fiber parks during the wait, the scheduler advances
    //     another connection on the same OS thread.
    //   - Expected concurrency exceeds ~1000 simultaneous
    //     connections. ServeMt pthread cache + scheduler
    //     contention starts dropping connections around 1k-2k on
    //     2-core boxes; ServeAsync handles 2k cleanly in ~1.5s on
    //     the same hardware (see amalgame-net-http bench/).
    //
    // When to stick with ServeMtWith:
    //   - Handlers are CPU-bound. Async parks on I/O, not CPU —
    //     there's nothing to overlap.
    //   - You need cross-platform deployment today. ServeAsync is
    //     Linux-only in v0.12.0 (epoll). kqueue (BSD + macOS) +
    //     IOCP (Windows) land in amalgame-async v0.2.1 / v0.3.
    //
    // HttpServerConfig knobs (per-conn timeouts, body size limits)
    // aren't wired into ServeAsync yet — that's
    // ServeAsyncWith in v0.12.1 once amalgame-net-http v0.9.3 ships
    // Http1.ServeAsyncWith.
    public int ServeAsync(int port) {
        let app = this
        let handler = conn => {
            let req: HttpRequest = HttpRequest.FromH1Conn(conn)
            let resp: HttpResponse = app.Handle(req)
            resp.WriteToH1Conn(conn)
            return 0
        }
        return Http1.ServeAsync(port, handler)
    }

    // v0.12.2: ServeAsync + per-conn HttpServerConfig. Wraps
    // amalgame-net-http v0.9.3+'s Http1.ServeAsyncWith. The config
    // knobs honored on the async path:
    //   - max_body_bytes / max_header_bytes / max_url_bytes
    //   - listen_backlog
    //   - idle_timeout_sec > 0 → HTTP/1.1 keep-alive on (matches
    //     ServeWith semantics; configs are portable across all 4
    //     Serve* variants).
    // Not yet wired (deferred to v0.12.3 + net-http v0.9.4):
    //   - header_timeout_sec / body_timeout_sec (today: fixed 30s
    //     default in the async recv helpers).
    public int ServeAsyncWith(int port, cfg: AmalgameNetHttpServerConfig) {
        let app = this
        let handler = conn => {
            let req: HttpRequest = HttpRequest.FromH1Conn(conn)
            let resp: HttpResponse = app.Handle(req)
            resp.WriteToH1Conn(conn)
            return 0
        }
        return Http1.ServeAsyncWith(port, cfg, handler)
    }
}

// ─────────────────────────────────────────────────────────────────
// ProtectedRoutes — v0.19.0 auth-protected route group.
//
// Returned by WebApp.Protected(). Its verb methods register routes
// flagged Protected=true on the parent app's router (via
// Router.AddProtected), so the dispatch pipeline gates them behind the
// configured auth middleware. Each verb returns the group for fluent
// chaining of several protected routes; End() climbs back to the
// WebApp when you need to resume app-level configuration afterwards.
//
//     app.WithBasicAuth(adminAuth)
//        .Get("/", home)
//        .Protected()
//            .Get("/admin",        dashboard)
//            .Post("/admin/users", createUser)
//        .End()
//        .Get("/health", health)   // public again

// amalgame-web — RedisSessionStore (v0.8.4).
//
// Server-side session store backed by Redis. Pattern matches
// MemorySessionStore but persists each Session.Data map as one
// Redis string per session, keyed `<prefix>:<session_id>`, with a
// TTL refreshed on Save.
//
// Why Redis (vs memory/shm):
//   - memory: single process, lost on restart, no horizontal scale
//   - shm:    multi-worker single node, lost on restart
//   - redis:  multi-node, survives restarts, the canonical choice
//             once you're past single-machine
//
// Payload format (same as SignedCookieSessionStore):
//   "k1=v1&k2=v2&..."   (plain ASCII; '&' and '=' forbidden in
//                        keys + values for v0.1 — JSON in v0.2)
//
// Connection model (v0.1): one TCP connection per operation —
// Open + op + Close. Trivially correct; no shared state to
// invalidate on a dropped socket. The amc type system can't store
// an opaque C handle (AmalgameRedis*) in an AM class field today,
// so connection pooling has to wait until either the language
// gains an opaque-handle escape hatch or this store moves into
// the redis package itself. localhost TCP setup costs ~50µs, so
// the penalty is real but bearable until we're scaling.
//
// Lifecycle:
//   Create(id) → empty Session, immediately persisted to Redis
//                with TTL = MaxAgeSec
//   Find(id)   → fetched from Redis, deserialised, or null
//   Save(s)    → serialise + SET + EXPIRE — caller invokes this
//                after mutating s.Data. (The framework should hook
//                this into the response phase; not automatic yet.)
//   Destroy(id) → DEL

namespace Amalgame.Web

import Amalgame.Collections
import Amalgame.String
import Amalgame.Database.NoSQL.Redis
import Amalgame.Threading
import Amalgame.Net.Http

public class RedisSessionStore implements SessionStore {
    public Host:           string
    public Port:           int
    public KeyPrefix:      string
    public CookieName:     string
    public CookieSecure:   bool
    public CookieSameSite: string
    public CookiePath:     string
    public CookieMaxAge:   int
    public MaxAgeSec:      int           // TTL applied to each session

    // v0.9.1: persistent connection — opened lazily on first op,
    // re-used across calls. Closed via Disconnect() or on process
    // exit. Lifts the v0.8.4 open/close-per-op cost (~50µs each
    // on localhost, much worse over WAN). Requires amc v0.8.37+
    // which can lower an opaque package type (AmalgameRedis*)
    // as a class field.
    public Handle:         AmalgameRedis

    // v0.9.3: mutex serialising Redis command writes. The RESP2
    // protocol is request/response on a single TCP stream — it's
    // NOT multiplexable. Under Http1.ServeMt, two worker threads
    // running ops on the same handle would interleave their command
    // bytes and read each other's replies. The lock is around the
    // whole Get/Set/Del/Expire/Incr op (write + read), not just the
    // socket write, so each thread sees a clean reply.
    public Mu:             AmalgameMutex

    public RedisSessionStore() {
        this.Host           = "127.0.0.1"
        this.Port           = 6379
        this.KeyPrefix      = "mosaic:session"
        this.CookieName     = "mosaic_session"
        this.CookieSecure   = true
        this.CookieSameSite = "Lax"
        this.CookiePath     = "/"
        this.CookieMaxAge   = 0
        this.MaxAgeSec      = 86400
        this.Handle         = null
        this.Mu             = Threading.MutexNew()
    }

    // ── Builders ─────────────────────────────────────
    public RedisSessionStore WithHost(string h)              { this.Host           = h; return this }
    public RedisSessionStore WithPort(int p)                 { this.Port           = p; return this }
    public RedisSessionStore WithKeyPrefix(string p)         { this.KeyPrefix      = p; return this }
    public RedisSessionStore WithCookieName(string n)        { this.CookieName     = n; return this }
    public RedisSessionStore WithCookieSecure(bool s)        { this.CookieSecure   = s; return this }
    public RedisSessionStore WithCookieSameSite(string ss)   { this.CookieSameSite = ss; return this }
    public RedisSessionStore WithCookiePath(string p)        { this.CookiePath     = p; return this }
    public RedisSessionStore WithCookieMaxAge(int a)         { this.CookieMaxAge   = a; return this }
    public RedisSessionStore WithMaxAgeSec(int a)            { this.MaxAgeSec      = a; return this }

    // ── Connection lifecycle (v0.9.1 pooled) ─────────
    // Lazy-open the persistent handle. Returns true on success.
    // Idempotent — re-uses an existing live handle. Caller code
    // doesn't have to invoke this directly; every public op calls
    // it transparently. Manual invocation is only useful for the
    // startup health check.
    private bool EnsureHandle() {
        if (this.Handle != null && Redis.IsOpen(this.Handle)) { return true }
        this.Handle = Redis.Open(this.Host, this.Port)
        return Redis.IsOpen(this.Handle)
    }

    // Explicit teardown — closes the pooled connection. Subsequent
    // ops will re-open lazily.
    public void Disconnect() {
        if (this.Handle != null) {
            Redis.Close(this.Handle)
            this.Handle = null
        }
    }

    // Connectivity probe — uses the pooled handle (open on first
    // call, leave open after). Same return-true-iff-server-answers
    // semantics as v0.8.4; the side effect is now "warm cache" not
    // "open + close". Mu-protected for the same RESP2 reason.
    public bool Probe() {
        Threading.MutexLock(this.Mu)
        var ok: bool = false
        if (this.EnsureHandle()) {
            ok = Redis.Ping(this.Handle)
        }
        Threading.MutexUnlock(this.Mu)
        return ok
    }

    // ── Cookie helper ────────────────────────────────
    public Cookie MakeCookie(string sessionId) {
        let c = new Cookie()
        c.Name      = this.CookieName
        c.Value     = sessionId
        c.Path      = this.CookiePath
        c.Secure    = this.CookieSecure
        c.SameSite  = this.CookieSameSite
        c.MaxAgeSec = this.CookieMaxAge
        c.HttpOnly  = true
        return c
    }

    // ── Session lifecycle ────────────────────────────
    // Create + persist an empty Session with the given id. Caller
    // typically passes a Router-generated 256-bit random token.
    public Session Create(string id) {
        let s = new Session(id)
        s.MaxAgeSec = this.MaxAgeSec
        this.Save(s)
        return s
    }

    // Look up a session by id. Returns null if Redis is down or
    // the key is missing. Wrapped in this.Mu so RESP2 commands
    // serialise per-store under Http1.ServeMt.
    public Session Find(string id) {
        Threading.MutexLock(this.Mu)
        var result: Session = null
        if (this.EnsureHandle()) {
            let key: string = this.KeyPrefix + ":" + id
            if (Redis.Exists(this.Handle, key)) {
                let raw: string = Redis.Get(this.Handle, key)
                let session = new Session(id)
                session.MaxAgeSec = this.MaxAgeSec
                session.Data = RedisSessionStore.DeserializeData(raw)
                result = session
            }
        }
        Threading.MutexUnlock(this.Mu)
        return result
    }

    // Serialise + write the session to Redis with the configured
    // TTL. Returns false on connection or write failure.
    public bool Save(Session s) {
        let key: string = this.KeyPrefix + ":" + s.Id
        let payload: string = RedisSessionStore.SerializeData(s.Data)
        Threading.MutexLock(this.Mu)
        var ok: bool = false
        if (this.EnsureHandle()) {
            ok = Redis.Set(this.Handle, key, payload)
            if (ok && this.MaxAgeSec > 0) {
                Redis.Expire(this.Handle, key, this.MaxAgeSec)
            }
        }
        Threading.MutexUnlock(this.Mu)
        return ok
    }

    // ── SessionStore (v0.20.0 pipeline integration) ───
    // Read the cookie's id, fetch from Redis; mint + persist a fresh
    // session when absent (or when Redis is down and Find returns
    // null — fail-open to a new anonymous session rather than 500).
    public Session LoadSession(HttpRequest req) {
        let id: string = req.Cookie(this.CookieName)
        if (String_Length(id) > 0) {
            let existing: Session = this.Find(id)
            if (existing != null) { return existing }
        }
        return this.Create(Session.NewId())
    }

    // Write the (mutated) session back to Redis with its TTL and
    // stamp the id cookie on the response.
    public void SaveSession(Session s, HttpResponse resp) {
        this.Save(s)
        resp.SetCookie(this.MakeCookie(s.Id))
    }

    // Remove a session. No-op if Redis is down.
    public void Destroy(string id) {
        let key: string = this.KeyPrefix + ":" + id
        Threading.MutexLock(this.Mu)
        if (this.EnsureHandle()) {
            Redis.Del(this.Handle, key)
        }
        Threading.MutexUnlock(this.Mu)
    }

    // ── FromMap — for the [sessions] TOML table when ─
    // strategy = "server_side" + backend = "redis". Recognised keys:
    //   host             string  (default 127.0.0.1)
    //   port             int     (default 6379)
    //   key_prefix       string  (default "mosaic:session")
    //   max_age_sec      int     (default 86400)
    //   cookie_name / cookie_secure / cookie_samesite /
    //   cookie_path / cookie_max_age — same as MemorySessionStore
    public static RedisSessionStore FromMap(Map<string, string> cfg) {
        let s = new RedisSessionStore()
        if (cfg.Has("host"))            { s.Host           = cfg.Get("host") }
        if (cfg.Has("port"))            { s.Port           = String_ToInt(cfg.Get("port")) }
        if (cfg.Has("key_prefix"))      { s.KeyPrefix      = cfg.Get("key_prefix") }
        if (cfg.Has("max_age_sec"))     { s.MaxAgeSec      = String_ToInt(cfg.Get("max_age_sec")) }
        if (cfg.Has("cookie_name"))     { s.CookieName     = cfg.Get("cookie_name") }
        if (cfg.Has("cookie_secure"))   { s.CookieSecure   = (cfg.Get("cookie_secure") == "true") }
        if (cfg.Has("cookie_samesite")) { s.CookieSameSite = cfg.Get("cookie_samesite") }
        if (cfg.Has("cookie_path"))     { s.CookiePath     = cfg.Get("cookie_path") }
        if (cfg.Has("cookie_max_age"))  { s.CookieMaxAge   = String_ToInt(cfg.Get("cookie_max_age")) }
        return s
    }

    // ── Internal: payload serialisation ──────────────
    // Same wire format as SignedCookieSessionStore so future code
    // can swap freely. Keys + values must not contain '&' or '='.
    private static string SerializeData(Map<string, string> d) {
        var s: string = ""
        let keys: List<string> = d.Keys()
        let n: int = keys.Count()
        for i in 0..n {
            let k: string = keys.Get(i)
            let v: string = d.Get(k)
            if (i > 0) { s = s + "&" }
            s = s + k + "=" + v
        }
        return s
    }

    private static Map<string, string> DeserializeData(string raw) {
        let m: Map<string, string> = new Map<string, string>()
        let n: int = String_Length(raw)
        if (n == 0) { return m }
        var start: int = 0
        var i: int = 0
        while (i <= n) {
            let isEnd: bool = (i == n)
            var sep: bool = false
            if (!isEnd) {
                let c: string = String_CharAt1(raw, i)
                if (c == "&") { sep = true }
            }
            if (isEnd || sep) {
                let pair: string = String_Substring(raw, start, i - start)
                let pn: int = String_Length(pair)
                var eq: int = -1
                var j: int = 0
                while (j < pn) {
                    if (String_CharAt1(pair, j) == "=") { eq = j; j = pn }
                    else { j = j + 1 }
                }
                if (eq > 0 && eq < pn) {
                    let k: string = String_Substring(pair, 0, eq)
                    let v: string = String_Substring(pair, eq + 1, pn - eq - 1)
                    m.Set(k, v)
                }
                start = i + 1
            }
            i = i + 1
        }
        return m
    }
}
